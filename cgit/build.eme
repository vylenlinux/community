#!/bin/sh

# shellcheck disable=SC2034
description="Git web interface written in C"
homepage="https://git.zx2c4.com/cgit"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cgit
version=1.3.1
release=1

source="https://git.zx2c4.com/${name}/snapshot/${name}-${version}.tar.xz
    ${name}.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make get-git
    make
    make doc-man
    make CGIT_SCRIPT_PATH=/usr/share/webapps/cgit DESTDIR="${PKG}" prefix=/usr install install-man

    install -d "${PKG}/usr/lib/cgit"
    install -Dm640 "${SRC}/cgit.conf" -t "${PKG}/etc/apache/original/extra/"
    install -Dm640 "${SRC}/cgit.conf" -t "${PKG}/etc/apache/extra/"

    mv "${PKG}/usr/share/webapps/cgit/cgit.cgi" "${PKG}/usr/lib/cgit"
    ln -sf ../../../lib/cgit/cgit.cgi "${PKG}/usr/share/webapps/cgit/cgit.cgi"
}
