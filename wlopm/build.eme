description="Wayland output power management client"
homepage="https://git.sr.ht/~leon_plickat/wlopm"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wlopm
version=1.0.0
release=1
source="$name-$version.tar.gz::https://git.sr.ht/~leon_plickat/wlopm/archive/v$version.tar.gz"

build() {
    
    cd $name-v$version
	make PREFIX=/usr
	install -d  $PKG/usr/share/bash-completion/completions
	make PREFIX=/usr DESTDIR=$PKG install
}
