#!/bin/sh

# shellcheck disable=SC2034
description="nwg-shell meta-package"
homepage="https://github.com/nwg-piotr/nwg-shell"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nwg-shell
version=0.5.50
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    python3 setup.py install --root="${PKG}" --optimize=1

    install -Dm755 scripts/*     -t "${PKG}/usr/bin/"
    install -Dm644 nwg-shell.jpg -t "${PKG}/usr/share/backgrounds/"
}
