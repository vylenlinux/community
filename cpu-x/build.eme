#!/bin/sh

# shellcheck disable=SC2034
description="A Free software that gathers information on CPU, motherboard and more"
homepage="CPU-X is a system profiling and monitoring application"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cpu-x
version=5.4.1
release=1
source="${name}-${version}.tar.gz::https://github.com/TheTumultuousUnicornOfDarkness/${name}/archive/v${version}.tar.gz"

build() {
    cmake -S "CPU-X-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
