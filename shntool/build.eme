#!/bin/sh

# shellcheck disable=SC2034
description="A multi-purpose WAVE data processing and reporting utility"
homepage="http://shnutils.freeshell.org/shntool/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=shntool
version=3.0.10
release=1
source="http://shnutils.freeshell.org/${name}/dist/src/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
