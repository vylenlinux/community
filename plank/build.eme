#!/bin/sh

# shellcheck disable=SC2034
description="Elegant, simple, clean dock"
homepage="https://plankreloaded.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=plank
version=0.11.175
release=1
source="${name}-${version}.tar.gz::https://github.com/zquestz/plank-reloaded/archive/${version}/plank-reloaded-${version}.tar.gz"

build() {
    vylen-meson "plank-reloaded-${version}" build \
        -Denable-apport=false \
        -Denable-dbusmenu=yes \
        -Dproduction-release=true \
        -Denable-docs=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
