#!/bin/sh

# shellcheck disable=SC2034
description="Utility to convert markdown to man pages"
homepage="https://github.com/cpuguy83/go-md2man"
maintainer="Vylen Linux Team"

name=go-md2man
version=2.0.7
release=1
source="https://github.com/cpuguy83/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath"

    go build -o go-md2man .

    ./go-md2man \
        -in=go-md2man.1.md \
        -out=go-md2man.1

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
    install -Dm755 "${name}.1" -t "${PKG}/usr/share/man/man1/"
}
