#!/bin/sh

# shellcheck disable=SC2034
description="Perl interface to the SHA-1 algorithm"
homepage="https://metacpan.org/release/Digest-SHA1/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-digest-sha1
version=2.13
release=1
source="${name}-${version}.tar.gz::https://www.cpan.org/modules/by-module/Digest/Digest-SHA1-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Digest-SHA1-${version}"

    export OPTIMIZE="${CFLAGS}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install

    # Fix perms
    find "${PKG}" -type f -a ! -perm -u+w -exec chmod u+w '{}' +
}
