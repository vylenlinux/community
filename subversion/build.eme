#!/bin/sh

# shellcheck disable=SC2034
description="A Modern Concurrent Version Control System"
homepage="https://subversion.apache.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=subversion
version=1.15.0
release=1
source="https://dlcdn.apache.org/${name}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    grep -rl '^#!.*python$' | xargs sed -i '1s/python/&3/'
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --disable-static \
        --disable-shared \
        --with-serf \
        --with-gnome-keyring=no

    make
    make DESTDIR="${PKG}" install
}
