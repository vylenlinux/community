#!/bin/sh

# shellcheck disable=SC2034
description="A set of Python 3.x bindings for the Qt5 toolkit"
homepage="https://riverbankcomputing.com/software/pyqt/intro"
maintainer="Vylen Linux Team"

name=python3-pyqt5
version=5.15.11
release=1

source="${name}-${version}.tar.gz::https://pypi.python.org/packages/source/P/PyQt5/PyQt5-${version}.tar.gz
    pyqt5-sip-abi-12.15.patch
    pyqt5-python315-weakref.patch"

build() {
    # shellcheck disable=SC2164
    cd "PyQt5-${version}"

    patch -Np1 -i "${SRC}/pyqt5-sip-abi-12.15.patch"
    patch -Np1 -i "${SRC}/pyqt5-python315-weakref.patch"

    sip-build \
        --confirm-license \
        --no-make \
        --api-dir /usr/share/qt5/qsci/api/python \
        --pep484-pyi

    # shellcheck disable=SC2164
    cd build

    make
    make INSTALL_ROOT="${PKG}" install -j1

    # compile Python bytecode
    python3 -m compileall -d / "${PKG}/usr/lib"
    python3 -O -m compileall -d / "${PKG}/usr/lib"

    # cleanup
    find "${PKG}" -iname "*INSTALLER*" -delete
    rm -r "${PKG}/usr/lib"/python*/site-packages/PyQt5/uic/port_v2
}
