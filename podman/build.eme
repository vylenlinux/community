#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Tool and library for running OCI-based containers in pods"
homepage="https://github.com/containers/libpod"
maintainer="Vylen Linux Team"

name=podman
version=6.1.1
release=1
source="https://github.com/containers/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOCACHE="${PWD}/gocache"
    export GOPATH="${PWD}/gopath"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie"

    make BUILDTAGS="seccomp exclude_graphdriver_devicemapper exclude_graphdriver_btrfs"
    make install PREFIX=/usr DESTDIR="${PKG}" LIBEXECDIR=/usr/lib

    rm -f "${PKG}/usr/share/man"/man*/*systemd*
}
