description="Library implementing a curses-based widget set for text terminals"
homepage="http://clifford.at/stfl/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=stfl
version=0.24
release=1
source="https://ponce.cc/slackware/sources/repo/$name-$version.tar.gz"

build() {
	cd $name-$version
	
	sed -i 's|ncursesw/||' stfl_internals.h
	make prefix=/usr FOUND_SWIG=0 DESTDIR=$PKG install

	find $PKG -name perllocal.pod -delete
}
