#!/bin/sh

# shellcheck disable=SC2034
description="Library implementing a curses-based widget set for text terminals"
homepage="http://clifford.at/stfl/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=stfl
version=0.24
release=1
source="${name}-${version}.tar.gz::https://ponce.cc/slackware/sources/repo/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "stfl-${version}"

    export prefix=/usr
    export FOUND_SWIG=0

    sed -i 's|ncursesw/||' stfl_internals.h
    make DESTDIR="${PKG}" install
}
