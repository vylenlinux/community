#!/bin/sh

# shellcheck disable=SC2034
description="inotify-tools is a C library and a set of command-line programs for Linux providing a simple interface to inotify."
maintainer="Vylen Linux Team"
homepage="https://github.com/inotify-tools/inotify-tools"

name=inotify-tools
version=4.25.9.0
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --enable-fanotify

    make
    make DESTDIR="${PKG}" install
}
