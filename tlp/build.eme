#!/bin/sh

# shellcheck disable=SC2034
description="Linux Advanced Power Management"
homepage="https://linrunner.de/en/tlp/tlp.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tlp
version=1.10.2
release=1
source="https://github.com/linrunner/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "TLP-${version}"

    export TLP_NO_INIT=1
    export TLP_SBIN=/usr/bin
    export TLP_WITH_ELOGIND=0
    export TLP_WITH_SYSTEMD=1

    make DESTDIR="${PKG}" install
}
