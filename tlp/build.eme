#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Linux Advanced Power Management"
homepage="https://linrunner.de/en/tlp/tlp.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tlp
version=1.10.2
release=1
source="https://github.com/linrunner/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "TLP-${version}"
    make DESTDIR="${PKG}" install

    do_service "${name}" "${name}-pd"
}
