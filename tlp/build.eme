#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Linux Advanced Power Management"
homepage="https://linrunner.de/en/tlp/tlp.html"
maintainer="Vylen Linux Team"

name=tlp
version=1.9.1
release=2

source="https://github.com/linrunner/${name}/archive/${version}/${name}-${version}.tar.gz
    run.tlpd
    finish.tlpd"

build() {
    # shellcheck disable=SC2164
    cd "TLP-${version}"
    make DESTDIR="${PKG}" install

	install -Dm755 "${SRC}/run.tlpd" "${PKG}/etc/sv/tlpd/run"
	install -Dm755 "${SRC}/finish.tlpd" "${PKG}/etc/sv/tlpd/finish"

	ln -s /run/runit/supervise.tlpd "${PKG}/etc/sv/tlpd/supervise"
	rm -rf "${PKG}/usr/lib/systemd"
}
