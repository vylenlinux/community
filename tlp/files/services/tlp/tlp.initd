#!/usr/bin/openrc-run

# shellcheck disable=SC2034
command=/usr/bin/tlp
name="TLP"
extra_started_commands="reload stat"

depend() {
    need udev
}

start() {
    ebegin "Starting tlp..."
    "${command}" init start
    eend $?
}

reload() {
    ebegin "Reloading tlp's configuration..."
    "${command}" start
    eend $?
}

stop() {
    einfo "Reboot to stop tlp."
}

stat() {
    /usr/bin/tlp-stat
}
