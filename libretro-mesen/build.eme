#!/bin/sh

# shellcheck disable=SC2034
description="Super Nintendo Entertainment System cores"
homepage="https://github.com/libretro/bsnes-libretro"
maintainer="Vylen Linux Team"

name=libretro-mesen
version=d25d60f
release=1
source="${name}-${version}.tar.gz::https://github.com/libretro/mesen/tarball/d25d60fc190f3f7603a1113ef1e11d9da65b7583"

build() {
    # shellcheck disable=SC2164
    cd "libretro-Mesen-${version}/Libretro"

    make DESTDIR="${PKG}"
    install -Dm644 mesen_libretro.so -t "${PKG}/usr/lib/libretro/"
}
