#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A cross-platform benchmark that measures processor and memory performance"
homepage="https://www.geekbench.com/"
maintainer="Vylen Linux Team"

name=geekbench
version=6.7.1
release=1
source="${name}-${version}.tar.gz::http://cdn.geekbench.com/Geekbench-${version}-Linux.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Geekbench-${version}-Linux"

    install -Dm755 "${name}_x86_64" "${PKG}/opt/${name}/${name}_x86_64"
    install -Dm755 "${name}_avx2" "${PKG}/opt/${name}/${name}_avx2"
    install -Dm755 "${name}6" "${PKG}/opt/${name}/"

    install -Dm644 geekbench.plar "${PKG}/opt/${name}/geekbench.plar"
    install -Dm644 geekbench-workload.plar "${PKG}/opt/${name}/geekbench-workload.plar"

    install -d "${PKG}/usr/bin"
    ln -s /opt/${name}/${name}6 $PKG/usr/bin/${name}
}
