#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A cross-platform benchmark that measures processor and memory performance"
homepage="https://www.geekbench.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=geekbench
version=7.1.0
release=1
source="${name}-${version}.tar.gz::http://cdn.geekbench.com/Geekbench-${version}-Linux.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Geekbench-${version}-Linux"

    install -Dm755 "${name}${version%%.*}" -t "$PKG/opt/${name}/"
    install -Dm755 "${name}_avx2" -t "$PKG/opt/${name}/"
    install -Dm755 "${name}_x86_64" -t "$PKG/opt/${name}/"
    install -Dm644 geekbench.plxr -t "$PKG/opt/${name}/"
    install -Dm644 geekbench-workload.plxr -t "$PKG/opt/${name}/"

    install -d "${PKG}/usr/bin"
    ln -s "/opt/${name}/${name}${version%%.*}" "${PKG}/usr/bin/${name}"
}
