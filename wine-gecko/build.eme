#!/bin/sh

# shellcheck disable=SC2034
description="Wine's built-in replacement for Microsoft's Internet Explorer"
homepage="https://gitlab.winehq.org/wine/wine/-/wikis/Gecko"
maintainer="Vylen Linux Team"

name=wine-gecko
version=2.47.4
release=1

source="https://dl.winehq.org/wine/${name}/${version}/${name}-${version}-x86_64.tar.xz
    https://dl.winehq.org/wine/${name}/${version}/${name}-${version}-x86.tar.xz"

build() {
    install -dm755 "${PKG}/usr/share/wine/gecko/"

    cp -dr --no-preserve=ownership "${name}-${version}-x86_64" -t "${PKG}/usr/share/wine/gecko/"
    cp -dr --no-preserve=ownership "${name}-${version}-x86" -t "${PKG}/usr/share/wine/gecko/"
}
