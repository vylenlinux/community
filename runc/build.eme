#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A lightweight universal runtime container"
homepage="https://github.com/opencontainers/runc"
maintainer="Vylen Linux Team"

name=runc
version=1.5.1
release=1
source="https://github.com/opencontainers/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    mkdir -p src/github.com/opencontainers
    # shellcheck disable=SC2164
    cd src/github.com/opencontainers

    ln -sf "${SRC}/${name}-${version}" "${name}"
    # shellcheck disable=SC2164
    cd "${name}"

    export GOPATH="${SRC}"
    export BUILDTAGS="seccomp"

    export GOFLAGS="${GOFLAGS} \
        -trimpath \
        -mod=readonly \
        -modcacherw"

    make runc
    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
}
