description="Utility for monitoring a program's use of system resources"
homepage="https://www.gnu.org/software/time/"
maintainer="Vylen Linux Team"

name=time
version=1.9
release=1
source="https://ftp.gnu.org/gnu/time/$name-$version.tar.gz"

build() {
	cd $name-$version

	export CFLAGS="$CFLAGS -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types"

	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share
}
