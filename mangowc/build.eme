#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Lightweight, high-performance Wayland compositor built on dwl"
maintainer="Vylen Linux Team"
homepage="https://mangowm.github.io/"

name=mangowc
version=0.12.9
release=1
source="${name}-${version}.tar.gz::https://github.com/DreamMaoMao/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
