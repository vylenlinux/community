#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Lightweight, high-performance Wayland compositor built on dwl"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://mangowm.github.io/"

name=mangowc
version=0.17.3
release=1
source="${name}-${version}.tar.gz::https://github.com/DreamMaoMao/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "mango-${version}" build -Dxwayland="$(emerald is-installed xwayland && printf "enabled" || printf "disabled")"
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
