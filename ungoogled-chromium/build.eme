#!/bin/sh

# shellcheck disable=SC2034
description="Google Chromium, sans integration with Google"
homepage="https://github.com/ungoogled-software/ungoogled-chromium"
maintainer="Vylen Linux Team"

name=ungoogled-chromium
version=149.0.7827.200
release=1

source="${name}-${version}-${release}.tar.zst::https://github.com/ungoogled-software/${name}-archlinux/releases/download/${version}-${release}/${name%-bin}-${version}-${release}-x86_64.pkg.tar.zst
    chromium.desktop"

build() {
    cp -R "${SRC}/usr/" "${PKG}/usr"

    chown root "${PKG}/usr/lib/chromium/chrome-sandbox"
    chmod 4755 "${PKG}/usr/lib/chromium/chrome-sandbox"

    # desktop
    install -Dm644 "${SRC}/chromium.desktop" "${PKG}/usr/share/applications/"
}
