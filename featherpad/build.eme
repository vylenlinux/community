#!/bin/sh

# shellcheck disable=SC2034
description="lightweight Qt5 plain-text editor"
homepage="https://github.com/tsujan/FeatherPad"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=featherpad
version=1.6.4
release=1
source="${name}-${version}.tar.gz::https://github.com/tsujan/${name}/archive/V${version}/FeatherPad-${version}.tar.gz"

build() {
    cmake -S "FeatherPad-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DENABLE_QT5=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
