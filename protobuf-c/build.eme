#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Protocol Buffers implementation in C"
homepage="https://github.com/protobuf-c/protobuf-c"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=protobuf-c
version=1.5.2
release=2

source="https://github.com/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.gz
    https://github.com/strophy/protobuf-c/commit/d39f001b4578966600de0aaf7fc665eec6e057e5.diff"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/d39f001b4578966600de0aaf7fc665eec6e057e5.diff"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
