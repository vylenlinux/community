#!/bin/sh

# shellcheck disable=SC2034
description="Diff utility for binary files"
homepage="http://xdelta.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xdelta3
version=3.2.0
release=1
source="https://github.com/jmacd/xdelta/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "xdelta-${version}/${name}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DBUILD_SHARED_LIBS=ON \
        -DXD3_ARMOR=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
