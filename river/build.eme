#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A dynamic tiling wayland compositor"
homepage="https://codeberg.org/river/river"
maintainer="Vylen Linux Team"

name=river
version=0.4.6
release=1
source="https://codeberg.org/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    DESTDIR="build" zig build \
        --prefix /usr \
        -Dcpu=baseline \
        -Dstrip \
        -Dpie \
        -Dxwayland \
        -Doptimize=ReleaseSafe

    cp -a build/* "${PKG}"
    install -Dm644 contrib/river.desktop -t "${PKG}/usr/share/wayland-sessions/"
}
