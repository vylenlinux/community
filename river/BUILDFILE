description="A dynamic tiling wayland compositor"
homepage="https://codeberg.org/river/river"
maintainer="Vylen Linux Team"

name=river
version=0.3.12
release=1
source="https://codeberg.org/river/river/releases/download/v$version/river-$version.tar.gz"

build() {
  cd $name-$version

  DESTDIR="build" zig build \
    --prefix /usr \
    -Dcpu=baseline \
    -Dstrip \
    -Dbash-completion=$(emerald isinstalled bash-completion && printf "true" || printf "false") \
    -Dfish-completion=$(emerald isinstalled fish && printf "true" || printf "false") \
    -Dzsh-completion=$(emerald isinstalled zsh && printf "true" || printf "false") \
    -Dpie \
    -Dxwayland \
    -Doptimize=ReleaseSafe 

  cp -a build/* $PKG

  install -Dm644 contrib/river.desktop -t $PKG/usr/share/wayland-sessions
  install -d $PKG/usr/share/$name
  cp -a example $PKG/usr/share/$name

}

