#!/bin/sh

# shellcheck disable=SC2034
description="Monospaced font family for user interface and coding environments"
homepage="https://github.com/adobe-fonts/source-code-pro"
maintainer="Vylen Linux Team"

name=adobe-source-code-pro-fonts
version=2.042u+1.062i+1.026vf
release=1

_version=2.042R-u/1.062R-i/1.026R-vf
source="${name}-${version}.tar.gz::https://github.com/adobe-fonts/source-code-pro/archive/${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "source-code-pro-$(printf '%s' "${_version}" | sed 's|\/|-|g')"
    install -Dm644 OTF/*.otf VF/*.otf -t "${PKG}/usr/share/fonts/${name%-fonts}/"
}
