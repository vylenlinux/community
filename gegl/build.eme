#!/bin/sh

# shellcheck disable=SC2034
description="Generic Graphics Library, a graph based image processing format"
homepage="https://www.gegl.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gegl
version=0.4.72
release=1
source="https://download.gimp.org/pub/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build -Ddocs=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
