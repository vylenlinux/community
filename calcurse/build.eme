#!/bin/sh

# shellcheck disable=SC2034
description="A text-based personal organizer"
homepage="https://calcurse.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=calcurse
version=4.9.0
release=1
source="https://calcurse.org/files/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --enable-docs \
        --without-asciidoc

    make
    make DESTDIR="${PKG}" install
}
