#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Unofficial Microsoft Teams client for Linux using Electron."
maintainer="Vylen Linux Team"
homepage="https://github.com/IsmaelMartinez/teams-for-linux"

name=teams-for-linux
version=2.18.1
release=1

source="${name}-${version}.tar.gz::https://github.com/IsmaelMartinez/${name}/archive/v${version}.tar.gz
    ${name}.desktop"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    npm_config_cache="${SRC}/package-cache" npm install

    npx electron-builder build --x64 --linux dir
    install -dm755 "${PKG}/opt" "${PKG}/usr/bin"

    cp -r --preserve=mode dist/linux-unpacked "${PKG}/opt/${name}"
    install -Dm644 "${SRC}/${name}.desktop" -t "${PKG}/usr/share/applications/"

    for _icon in build/icons/*.png; do
        _filename="${_icon##*/}"
        install -Dm644 "${_icon}" "${PKG}/usr/share/icons/hicolor/${_filename%.png}/apps/${name}.png"
    done

    ln -sf "/opt/${name}/${name}" -t "${PKG}/usr/bin/"
}
