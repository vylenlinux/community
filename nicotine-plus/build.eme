#!/bin/sh

# shellcheck disable=SC2034
description="Graphical Soulseek client"
homepage="https://github.com/Nicotine-Plus/nicotine-plus"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nicotine-plus
version=3.3.11
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    python3 -m build \
        --wheel \
        --no-isolation

    python3 -m installer --destdir="${PKG}" dist/*.whl
}
