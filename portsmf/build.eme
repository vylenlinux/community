description="Portsmf is <Port Standard MIDI File>, a cross-platform, C++ library for reading and writing Standard MIDI Files"
homepage="https://codeberg.org/tenacityteam/portsmf"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=portsmf
version=239
release=1
source="$name-$version.tar.gz::https://codeberg.org/tenacityteam/$name/archive/$version.tar.gz"

build() {
	cmake -S $name -B build \
	        -DCMAKE_INSTALL_PREFIX=/usr \
	        -DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-Wno-dev	
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
