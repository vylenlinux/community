#!/bin/sh

# shellcheck disable=SC2034
description="Google Noto emoji fonts "
homepage="https://fonts.google.com/noto"
maintainer="Vylen Linux Team"

name=ttf-noto-emoji
version=2.051
release=1
source="${name}-${version}.tar.zst::https://london.mirror.pkgbuild.com/extra/os/x86_64/noto-fonts-emoji-1:${version}-${release}-any.pkg.tar.zst"

build() {
    cp -r usr "${PKG}"
}
