#!/bin/sh

# shellcheck disable=SC2034
description="Google Noto emoji fonts"
homepage="https://fonts.google.com/noto"
maintainer="Vylen Linux Team"

name=ttf-noto-emoji
version=2.051
release=2
source="${name}-${version}.tar.gz::https://github.com/googlefonts/noto-emoji/archive/refs/tags/v${version}.tar.gz"

build() {
    install -Dm644 "noto-emoji-${version}/fonts/NotoColorEmoji.ttf" -t "${PKG}/usr/share/fonts/noto/"
}
