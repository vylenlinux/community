#!/bin/sh

# shellcheck disable=SC2034
description="OpenPrinting printer support database"
homepage="http://www.linuxprinting.org/foomatic.html"
maintainer="Vylen Linux Team"

name=foomatic-db
version=20260904
release=1

commit=76dd1e31354c189b2edd9ae8201285d622c89395
source="${name}-${version}-${commit}.tar.gz::https://github.com/OpenPrinting/${name}/archive/${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"
    ./make_configure

    ./configure \
        --prefix=/usr \
        --disable-gzip-ppds \
        --disable-ppds-to-cups \
        --with-drivers=NOOBSOLETES,NOEMPTYCMDLINE

    make DESTDIR="${PKG}" install

    # add some docs
    install -Dm644 USAGE "${PKG}/usr/share/doc/${name}/USAGE"
    install -Dm644 README "${PKG}/usr/share/doc/${name}/README"
}
