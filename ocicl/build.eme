#!/bin/sh

# shellcheck disable=SC2034
description="An OCI-based ASDF system distribution and management tool for Common Lisp"
homepage="https://github.com/ocicl/ocicl"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ocicl
version=2.21.0
release=1
source="https://github.com/${name}/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sbcl \
        --load setup.lisp \
        --eval "(sb-ext:quit)"

    install -dm755 "${PKG}/usr/share/sbom"

    # generate SBOMs
    ./ocicl create-sbom cyclonedx "${PKG}/usr/share/sbom/${name}-${version}.json"
    ./ocicl create-sbom spdx "${PKG}/usr/share/sbom/${name}-${version}.spdx.json"

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
}
