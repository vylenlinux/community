#!/bin/sh

# shellcheck disable=SC2034
description="A GTK3 passphrase requester for ssh-add"
homepage="https://www.openssh.com/portable.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ssh-askpass
version=10.6p1
release=1
source="http://ftp.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "openssh-${version}/contrib"
    make gnome-ssh-askpass3

    install -Dm755 gnome-ssh-askpass3 -t "${PKG}/usr/lib/openssh/contrib/"
    ln -s contrib/gnome-ssh-askpass3 "${PKG}/usr/lib/openssh/ssh-askpass"
}
