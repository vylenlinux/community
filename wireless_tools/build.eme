#!/bin/sh

# shellcheck disable=SC2034
description="Tools allowing to manipulate the Wireless Extensions"
homepage="https://hewlettpackard.github.io/wireless-tools/Tools.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wireless_tools
version=30.pre9
release=1
source="${name}-${version}.tar.gz::https://hewlettpackard.github.io/wireless-tools/${name}.${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}.${version%.pre*}"
    sed '/BUILD_STATIC =/d' -i Makefile

    make CFLAGS="${CFLAGS} -I." LDFLAGS="${LDFLAGS}"
    make

    make \
        PREFIX="${PKG}/usr" \
        INSTALL_DIR="${PKG}/usr/bin" \
        INSTALL_MAN="${PKG}/usr/share/man" install
}
