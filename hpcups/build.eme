#!/bin/sh

# shellcheck disable=SC2034
description="Description: Ghostscript add-on for HP inkjet/laserjet printers"
homepage="https://sourceforge.net/projects/hplip/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=hpcups
version=3.26.6
release=1

source="${name}-${version}.tar.gz::http://downloads.sourceforge.net/project/hplip/hplip/${version}/hplip-${version}.tar.gz
    hplip-gcc14.patch"

build() {
    # shellcheck disable=SC2164
    cd "hplip-${version}"
    patch -Np1 -i "${SRC}/hplip-gcc14.patch"

    ./configure \
        --prefix=/usr \
        --enable-hpcups-only-build \
        --enable-hpcups-install \
        --with-hpppddir=/usr/share/cups/model/HP \
        --disable-doc-build \
        --disable-network-build

    make
    make DESTDIR="${PKG}" install

    # https://bugs.archlinux.org/task/59548
    install -Dm755 prnt/hpcups/libImageProcessor-x86_64.so -t "${PKG}/usr/lib/"
    ln -s libImageProcessor-x86_64.so "${PKG}/usr/lib/libImageProcessor.so"
}
