#!/bin/sh

post_install() {
    printf "\n==> Create groups:\n"
    printf "groupadd plugdev\n"
    printf "groupadd android\n"
    printf "groupadd adbusers\n"
    printf "\n==> Add user to groups:\n"
    printf "gpasswd -a \$USER plugdev\n"
    printf "gpasswd -a \$USER android\n"
    printf "gpasswd -a \$USER adbusers\n"
}
