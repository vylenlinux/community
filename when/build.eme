#!/bin/sh

# shellcheck disable=SC2034
description="A simple commandline personal calendar program"
homepage="http://www.lightandmatter.com/when/when.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=when
version=1.1.46
release=1

commit=6c9517032b7e
source="${name}-${version}-${commit}.tar.gz::https://bitbucket.org/ben-crowell/${name}/get/${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "ben-crowell-${name}-${commit}"
    make DESTDIR="${PKG}" install
}
