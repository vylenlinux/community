#!/bin/sh

# shellcheck disable=SC2034
description="Displays all the characters in a font using either the X11 core protocol or libXft2"
homepage="https://xorg.freedesktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfd
version=1.1.6
release=1
source="https://xorg.freedesktop.org/archive/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
