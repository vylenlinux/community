#!/bin/sh

# shellcheck disable=SC2034
description="GNU Image Manipulation Program"
homepage="https://www.gimp.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gimp
version=3.2.6
release=1

source="https://download.gimp.org/pub/${name}/v${version%.*}/${name}-${version}.tar.xz
    0001-gimp-gexiv2-016.patch"

build() {
    patch -d "${name}-${version}" -Np1 -i "${SRC}/0001-gimp-gexiv2-016.patch"

    vylen-meson "${name}-${version}" build \
        -Ddebug=false \
        -Db_lto=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
