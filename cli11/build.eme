#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A command line parser for C++11 and beyond"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="ttps://github.com/CLIUtils/CLI11"

name=cli11
version=2.7.2
release=1
source="${name}-${version}.tar.gz::https://github.com/CLIUtils/${name}/archive/v${version}/CLI11-${version}.tar.gz"

build() {
    cmake -S "CLI11-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCLI11_BUILD_EXAMPLES=OFF \
        -DCLI11_BUILD_TESTS=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
