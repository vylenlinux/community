#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A command line parser for C++11 and beyond"
maintainer="Vylen Linux Team"
homepage="ttps://github.com/CLIUtils/CLI11"

name=cli11
version=2.6.2
release=1
source="${name}-${version}.tar.gz::https://github.com/CLIUtils/CLI11/archive/v${version}/CLI11-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -D CMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -D CLI11_BUILD_EXAMPLES=OFF \
        -D CLI11_BUILD_TESTS=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
