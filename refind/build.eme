#!/bin/sh

# shellcheck disable=SC2034
description="A fork of the rEFIt boot manager"
homepage="https://www.rodsbooks.com/refind/"
maintainer="Vylen Linux Team"

name=refind
version=0.14.2
release=1

source="${name}-${version}.tar.gz::https://downloads.sourceforge.net/${name}/${version}/${name}-src-${version}.tar.gz
    gnu-efi-4-compat.patch
    fix-target-option.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 < "${SRC}/gnu-efi-4-compat.patch"
    patch -Np1 < "${SRC}/fix-target-option.patch"

    make -j1
    make -j1 gnuefi
    make -j1 fs_gnuefi

    install -Dm644 "${name}/${name}_x64.efi" -t "${PKG}/usr/share/${name}/"
    install -Dm644 drivers_x64/*.efi -t "${PKG}/usr/share/${name}/drivers_x64/"
    install -Dm644 gptsync/gptsync_x64.efi -t "${PKG}/usr/share/${name}/tools_x64/"

    for F in "${name}-install" "${name}-mkdefault" mkrlconf mvrefind fonts/mkfont.sh; do
        install -Dm755 "${F}" "${PKG}/usr/bin/$(basename "${F}")"
    done

    # shellcheck disable=SC2016
    sed -i -e 's,RefindDir="$ThisDir/refind",RefindDir="/usr/share/refind",g' "${PKG}/usr/bin/${name}-install"

    install -Dm644 fonts/*.png -t "${PKG}/usr/share/${name}/fonts/"
    install -Dm644 icons/*.png -t "${PKG}/usr/share/${name}/icons/"
    install -Dm644 icons/svg/*.svg -t "${PKG}/usr/share/${name}/icons/svg/"

    for xx in bmp png svg; do
        install -Dm644 images/*".${xx}" -t "${PKG}/usr/share/${name}/images/"
    done

    for xx in cer crt; do
        install -Dm644 keys/*".${xx}" -t "${PKG}/usr/share/${name}/keys/"
    done

    install -m644 "${name}.conf-sample" -t "${PKG}/usr/share/${name}/"
}
