#!/bin/sh

# shellcheck disable=SC2034
description="SQL database server, drop-in replacement for MySQL"
homepage="https://mariadb.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mariadb
version=13.0.2
release=1

source="https://downloads.mariadb.org/interstitial/${name}-${version}/source/${name}-${version}.tar.gz
    mariadb-Environment-jemalloc.conf
    mariadb-PrivateTmp.conf"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DINSTALL_LAYOUT=RPM \
        -DINSTALL_LIBDIR=lib \
        -DINSTALL_SBINDIR=bin \
        -DINSTALL_SCRIPTDIR=bin \
        -DINSTALL_PLUGINDIR=lib/mysql/plugin \
        -DINSTALL_PCDIR=/usr/lib/pkgconfig \
        -DINSTALL_PAMDIR=/lib/security \
        -DINSTALL_SYSTEMD_UNITDIR=lib/systemd/system/ \
        -DINSTALL_SYSTEMD_SYSUSERSDIR=lib/sysusers.d/ \
        -DINSTALL_SYSTEMD_TMPFILESDIR=lib/tmpfiles.d/ \
        -DMYSQL_DATADIR=/var/lib/mysql \
        -DMYSQL_UNIX_ADDR=/run/mysqld/mysqld.sock \
        -DWITH_READLINE=ON \
        -DWITH_LIBAIO=ON \
        -DWITH_ZLIB=system \
        -DWITH_SSL=system \
        -DWITH_PCRE=system \
        -DWITH_LIBFMT=system \
        -DWITH_SYSTEMD=yes \
        -DWITH_EXTRA_CHARSETS=complex \
        -DWITH_EMBEDDED_SERVER=ON \
        -DWITH_UNIT_TESTS=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    rm -rf "${PKG}/etc/logrotate.d" \
        "${PKG}/usr/share/mariadb-test" \
        "${PKG}/usr/share"/groonga* \
        "${PKG}/usr/share/mysql/systemd" \
        "${PKG}/usr/lib/systemd/system/mariadb@bootstrap.service.d"

    rm -f "${PKG}/usr/bin/rcmysql" \
        "${PKG}/usr/share/man/man1/mysql-test-run.pl.1"

    install -Dm644 "${SRC}/mariadb-Environment-jemalloc.conf" "${PKG}/usr/lib/systemd/system/mariadb.service.d/Environment-jemalloc.conf"
    install -Dm644 "${SRC}/mariadb-Environment-jemalloc.conf" "${PKG}/usr/lib/systemd/system/mariadb@.service.d/Environment-jemalloc.conf"
    install -Dm644 "${SRC}/mariadb-PrivateTmp.conf" "${PKG}/usr/lib/systemd/system/mariadb.service.d/PrivateTmp.conf"
    install -Dm644 "${SRC}/mariadb-PrivateTmp.conf" "${PKG}/usr/lib/systemd/system/mariadb@.service.d/PrivateTmp.conf"

    # shellcheck disable=SC2038
    find "${PKG}/usr/share/mariadb"/* -type d \
        ! -name english \
        ! -name charsets \
    | xargs rm -rf {} \;

    mv "${PKG}/lib/security" -t "${PKG}/usr/lib/"
    rmdir "${PKG}/lib"

    do_pam mysql
}
