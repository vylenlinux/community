#!/bin/sh

# shellcheck disable=SC2034
description="SQL database server, drop-in replacement for MySQL"
homepage="https://mariadb.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mariadb
version=13.0.2
release=1
source="https://downloads.mariadb.org/interstitial/${name}-${version}/source/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DINSTALL_LAYOUT=RPM \
        -DINSTALL_LIBDIR=lib \
        -DINSTALL_PLUGINDIR=lib/mysql/plugin \
        -DINSTALL_PCDIR=/usr/lib/pkgconfig \
        -DINSTALL_PAMDIR=/lib/security \
        -DMYSQL_DATADIR=/var/lib/mysql \
        -DMYSQL_UNIX_ADDR=/run/mysqld/mysqld.sock \
        -DWITH_READLINE=ON \
        -DWITH_LIBAIO=ON \
        -DWITH_ZLIB=system \
        -DWITH_SSL=system \
        -DWITH_PCRE=system \
        -DWITH_LIBFMT=system \
        -DWITH_SYSTEMD=no \
        -DWITH_EXTRA_CHARSETS=complex \
        -DWITH_EMBEDDED_SERVER=ON \
        -DWITH_UNIT_TESTS=OFF

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    rm -rf "${PKG}/etc/logrotate.d" \
        "${PKG}/usr/share/mariadb-test" \
        "${PKG}/usr/share"/groonga*

    rm -f "${PKG}/usr/sbin/rcmysql" \
        "${PKG}/usr/share/man/man1/mysql-test-run.pl.1"

    # shellcheck disable=SC2038
    find "${PKG}/usr/share/mariadb"/* -type d \
        ! -name english \
        ! -name charsets \
    | xargs rm -rf {} \;

    do_service "${name}"
    do_pam mysql
}
