#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Kitty is a GPU Accelerated Terminal"
homepage="https://sw.kovidgoyal.net/kitty/"
maintainer="Vylen Linux Team"

name=kitty
version=0.47.0
release=1
source="https://github.com/kovidgoyal/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    python3 setup.py linux-package --update-check-interval=0
    python3 setup.py linux-package --prefix "${PKG}/usr"
}
