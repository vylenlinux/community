description="C library for encoding data in a QR Code symbol"
homepage="https://fukuchi.org/works/qrencode/"
maintainer="Vylen Linux Team"

name=qrencode
version=4.1.1
release=1
source="$name-$version.tar.gz::https://github.com/fukuchi/libqrencode/archive/v$version.tar.gz"

build() {
	cd lib$name-$version
	autoreconf -fvi
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
