#!/bin/sh

# shellcheck disable=SC2034
description="The .NET Core targeting pack"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://www.microsoft.com/net/core"

name=dotnet-targeting-pack
version=10.0.403
release=1
source="dotnet-${version}.tar.gz::https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/dotnet-sdk-${version}-linux-x64.tar.gz"

build() {
    install -dm755 "${PKG}/usr/share/dotnet/packs"

    for f in Host.linux-x64 Ref; do
        cp -dr --no-preserve=ownership "packs/Microsoft.NETCore.App.${f}" -t "${PKG}/usr/share/dotnet/packs/"
    done
}
