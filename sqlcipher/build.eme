#!/bin/sh

# shellcheck disable=SC2034
description="SQLite extension that provides transparent 256-bit AES encryption of database files"
homepage="https://www.zetetic.net/sqlcipher/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sqlcipher
version=4.19.0
release=1

source="https://www.zetetic.net/downloads/${name}/verify/${version}/${name}-${version}.zip
    ${name}-tcl9.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/${name}-tcl9.patch"

    export CPPFLAGS="${CPPFLAGS} \
        -DSQLITE_ENABLE_COLUMN_METADATA=1 \
        -DSQLITE_ENABLE_UNLOCK_NOTIFY \
        -DSQLITE_ENABLE_DBSTAT_VTAB=1 \
        -DSQLITE_ENABLE_FTS3_TOKENIZER=1 \
        -DSQLITE_SECURE_DELETE \
        -DSQLITE_ENABLE_STMTVTAB \
        -DSQLITE_MAX_VARIABLE_NUMBER=250000 \
        -DSQLITE_MAX_EXPR_DEPTH=10000 \
        -DSQLITE_ENABLE_MATH_FUNCTIONS"

    export CFLAGS="${CFLAGS} \
        -DSQLITE_HAS_CODEC \
        -DSQLITE_TEMP_STORE=2 \
        -DSQLCIPHER_TEST \
        -DSQLITE_EXTRA_INIT=sqlcipher_extra_init \
        -DSQLITE_EXTRA_SHUTDOWN=sqlcipher_extra_shutdown \
        -ftls-model=initial-exec"

    export LDFLAGS="${LDFLAGS} \
        -lcrypto \
        -Wl,-soname,libsqlcipher.so.0"

    ./configure \
        --prefix=/usr \
        --disable-static \
        --dll-basename=libsqlcipher \
        --enable-fts3 \
        --enable-fts4 \
        --enable-fts5 \
        --enable-rtree \
        --enable-json

    make
    make DESTDIR="${PKG}" install

    mv "${PKG}/usr/bin/sqlite3" "${PKG}/usr/bin/sqlcipher"

    install -d "${PKG}/usr/include/sqlcipher"
    mv "${PKG}/usr/include/sqlite3.h" -t "${PKG}/usr/include/sqlcipher/"
    mv "${PKG}/usr/include/sqlite3ext.h" -t "${PKG}/usr/include/sqlcipher/"

    # Fix TCL module: rename to match old package layout and fix soname
    sqlite_version="$(sed -n 's/#define SQLITE_VERSION *"\(.*\)"/\1/p' sqlite3.h)"
    mv "${PKG}/usr/lib/tcl8.6/sqlite${sqlite_version}" "${PKG}/usr/lib/tcl8.6/sqlite3"
    mv "${PKG}/usr/lib/tcl8.6/sqlite3/libsqlite${sqlite_version}.so" "${PKG}/usr/lib/tcl8.6/sqlite3/libtclsqlite3.so"
    patchelf --set-soname libtclsqlite3.so "${PKG}/usr/lib/tcl8.6/sqlite3/libtclsqlite3.so"

    # Install sqlcipher man page instead of sqlite3
    rm "${PKG}/usr/share/man/man1/sqlite3.1"
    install -Dm644 sqlcipher.1 -t "${PKG}/usr/share/man/man1/"

    # Fix pkg-config file: rename and update references
    mv "${PKG}/usr/lib/pkgconfig/sqlite3.pc" "${PKG}/usr/lib/pkgconfig/sqlcipher.pc"

    # shellcheck disable=SC2016
    sed -i \
        -e 's/-lsqlite3/-lsqlcipher/g' \
        -e 's|includedir=.*|includedir=${prefix}/include/sqlcipher|' \
    "${PKG}/usr/lib/pkgconfig/sqlcipher.pc"
}
