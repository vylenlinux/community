#!/bin/sh

# shellcheck disable=SC2034
description="GTK3 settings editor adapted to work w/ wlroots-based compositors"
homepage="https://github.com/nwg-piotr/nwg-look"
maintainer="Vylen Linux Team"

name=nwg-look
version=1.1.1
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    # shellcheck disable=SC2035
    go build -o "${name}" *.go

    install -Dm644 stuff/main.glade -t "${PKG}/usr/share/${name}/"
    install -Dm644 langs/* -t "${PKG}/usr/share/${name}/langs/"
    install -Dm644 "stuff/${name}.desktop" -t "${PKG}/usr/share/applications/"
    install -Dm644 "stuff/${name}.svg" -t "${PKG}/usr/share/pixmaps/"
    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
}
