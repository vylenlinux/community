#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Dead simple CLI Display Manager on TTY"
homepage="https://github.com/tvrzna/emptty"
maintainer="Vylen Linux Team"

name=emptty
version=0.16.1
release=1

source="${name}-${version}.tar.gz::https://github.com/tvrzna/${name}/archive/v${version}.tar.gz"
backup="etc/${name}/conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make build
    make DESTDIR="${PKG}" install-all
    make DESTDIR="${PKG}" install-config
    make DESTDIR="${PKG}" install-openrc

    # Configure PAM
    do_pam "${name}"
}
