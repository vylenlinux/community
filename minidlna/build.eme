#!/bin/sh

# shellcheck disable=SC2034
description="ReadyMedia (formerly known as MiniDLNA) is a simple media server software"
homepage="http://sourceforge.net/projects/minidlna/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=minidlna
version=1.3.3
release=1
backup="etc/${name}.conf"

source="https://sourceforge.net/projects/${name}/files/${name}-${version}.tar.gz
    ffmpeg7.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # fix build with ffmpeg 7
    patch -Np1 -i "${SRC}/ffmpeg7.patch"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${name}.conf" -t "${PKG}/etc/"
    install -Dm644 "${name}.conf.5" -t "${PKG}/usr/share/man/man5/"
    install -Dm644 minidlnad.8 -t "${PKG}/usr/share/man/man8/"

    do_service "${name}"
}
