#!/bin/sh

# shellcheck disable=SC2034
description="Command line util which allows to display images in combination with X11"
homepage="https://github.com/seebye/ueberzug"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ueberzug
version=18.3.2
release=1
source="${name}-${version}.tar.gz::https://github.com/ueber-devel/${name}/archive/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
