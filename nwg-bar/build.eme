#!/bin/sh

# shellcheck disable=SC2034
description="GTK3-based button bar for sway and other wlroots-based compositors"
homepage="https://github.com/nwg-piotr/nwg-bar"
maintainer="Vylen Linux Team"

name=nwg-bar
version=0.1.6
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    # shellcheck disable=SC2035
    go build -o "bin/${name}" *.go

    install -Dm644 images/* -t "${PKG}/usr/share/${name}/images/"
    install -Dm644 config/* -t "${PKG}/usr/share/${name}/"
    install -Dm755 "bin/${name}" -t "${PKG}/usr/bin/"
}
