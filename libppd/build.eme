#!/bin/sh

# shellcheck disable=SC2034
description="OpenPrinting - the legacy support library for PPD files"
homepage="https://github.com/OpenPrinting/libppd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libppd
version=2.1.1
release=1
source="https://github.com/OpenPrinting/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    emerald is-installed mupdf || DMU='--disable-mutool'
    emerald is-installed poppler || DPO='--disable-pdftops'

    ./configure \
        --prefix=/usr \
        "${DMU}" \
        "${DPO}"

    make
    make DESTDIR="${PKG}" install
}
