#!/bin/sh

# shellcheck disable=SC2034
description="Dynamic output configuration for Wayland WMs"
homepage="https://wayland.emersion.fr/kanshi/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=kanshi
version=1.9.0
release=1
source="https://gitlab.freedesktop.org/emersion/${name}/-/releases/v${version}/downloads/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dman-pages=disabled \
        -Dipc=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
