#!/bin/sh

# shellcheck disable=SC2034
description="A terminal integrated SSH/Telnet client"
homepage="https://www.chiark.greenend.org.uk/~sgtatham/putty/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=putty
version=0.85
release=1

source="https://the.earth.li/~sgtatham/${name}/${version}/${name}-${version}.tar.gz
    ${name}.desktop
    ${name}.png
    ${name}.xpm"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    install -Dm644 "${SRC}/${name}.desktop" -t "${PKG}/usr/share/applications/"
    install -Dm644 "${SRC}/${name}.png" -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 "${SRC}/${name}.xpm" -t "${PKG}/usr/share/pixmaps/"
}
