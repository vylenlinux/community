description="Cliente de firma electrónica ofrecido por la Administración Pública"
homepage="https://firmaelectronica.gob.es/"
maintainer="Vylen Linux Team"

name=autofirma-bin
version=1.9
vrsn=$(printf "$version" | awk -F. '{print $1$2}')
vjdk=17
release=1
source="${name}-${version}.zip::https://firmaelectronica.gob.es/content/dam/firmaelectronica/descargas-software/autofirma${vrsn}/Autofirma_Linux_Debian.zip"

build() {
	# Extract debian package
	bsdtar -O -xf *.deb data.tar.gz | bsdtar -C "${SRC}" -xJf -
	cp --reflink=auto -a $SRC/usr $PKG

	# Rename files
	mv $PKG/usr/lib/Autofirma/ $PKG/usr/lib/autofirma/
	mv $PKG/usr/lib/autofirma/Autofirma.png $PKG/usr/lib/autofirma/autofirma.png
	mv $PKG/usr/share/Autofirma $PKG/usr/share/autofirma
	mv $PKG/usr/share/autofirma/Autofirma.svg $PKG/usr/share/autofirma/autofirma.svg

	# Clean files
	rm $PKG/usr/lib/autofirma/autofirmaConfigurador.jar $PKG/usr/bin/autofirmacl
	rm -r $PKG/usr/share/common-licenses

	# Fix desktop file
	sed 's/^Icon=.*/Icon=\/usr\/lib\/autofirma\/autofirma.png/' -i $PKG/usr/share/applications/afirma.desktop

# autofirma with openjdk version prefix
cat <<- EOF > $PKG/usr/bin/autofirma
#!/bin/sh
/usr/lib/jvm/java-${vjdk}-openjdk/bin/java -jar /usr/lib/autofirma/autofirma.jar "\$@"
EOF

}

