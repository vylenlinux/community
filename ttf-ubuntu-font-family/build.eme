#!/bin/sh

# shellcheck disable=SC2034
description="Ubuntu font family"
homepage="https://design.ubuntu.com/font/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-ubuntu-font-family
version=0.863
release=1

source="${name}-${version}.tar.gz::https://launchpad.net/ubuntu/+archive/primary/+sourcefiles/fonts-ubuntu/${version}-0ubuntu1/fonts-ubuntu_${version}.orig.tar.gz
    81-ubuntu.conf"

build() {
    # shellcheck disable=SC2164
    cd "fonts-ubuntu-${version}"

    # shellcheck disable=SC2035
    install -Dm644 *.ttf -t "${PKG}/usr/share/fonts/ubuntu"
    install -Dm644 "${SRC}/81-ubuntu.conf" -t "${PKG}/usr/share/fontconfig/conf.avail/"

    install -dm755 "${PKG}/usr/share/fontconfig/conf.default"
    ln -s ../conf.avail/81-ubuntu.conf -t "${PKG}/usr/share/fontconfig/conf.default/"
}
