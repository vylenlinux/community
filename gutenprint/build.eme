#!/bin/sh

# shellcheck disable=SC2034
description="Print plugin and ghostscript/cups driver (formerly called gimp-print)"
homepage="http://gimp-print.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gutenprint
version=5.3.5
release=1
source="http://downloads.sourceforge.net/project/gimp-print/${name}-5.3/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed -i "s:cups_sbindir=\"\${cups_exec_prefix}\/sbin\":cups_sbindir=\"\${cups_exec_prefix}\/bin\":" m4local/stp_cups.m4
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --disable-nls \
        --disable-samples \
        --disable-libgutenprintui2 \
        --without-gimp2

    make
    make DESTDIR="${PKG}" install

    rm -r "${PKG}/usr/share/gutenprint/doc"
}
