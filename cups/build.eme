#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Print spooler and associated utilities"
homepage="https://openprinting.github.io/cups/"
maintainer="Vylen Linux Team"

name=cups
version=2.4.17
release=1

source="${name}-${version}.tar.gz::https://github.com/OpenPrinting/${name}/archive/v${version}/${name}-${version}-source.tar.gz
    cups.pam
    run.cupsd"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --with-menudir=/usr/share/applications \
        --with-icondir=/usr/share/icons \
        --with-logdir=/var/log/cups \
        --with-docdir=/usr/share/cups \
        --with-rundir=/run/cups \
        --with-cupsd-file-perm=0755 \
        --with-cups-user=lp \
        --with-cups-group=lp \
        --with-system-groups=lpadmin \
        --with-domainsocket=/run/cups/cups.sock \
        --disable-launchd \
        --enable-acl \
        --enable-dbus \
        --with-dbusdir=/usr/share/dbus-1 \
        --enable-gnutls \
        --enable-libusb \
        --enable-raw-printing \
        --enable-relro \
        --enable-ssl=yes \
        --with-optim="${CFLAGS}" \
        --without-php \
        --without-rcdir \
        --without-systemd

    make
    make BUILDROOT="${PKG}" install

    # Linux PAM Configuration
    install -Dm644 "${SRC}/cups.pam" "${PKG}/etc/pam.d/cups"

    # cleanup
    rm -fr "${PKG}/tmp" \
        "${PKG}/run" \
        "${PKG}/var/run"

    ## no longer works since CUPS >= 1.6 (http://www.cups.org/str.php?L4120)
    rm -rf "${PKG}/usr/share/cups/banners"/* \
        "${PKG}/usr/share/cups/data/testprint"

    chmod 0755 "${PKG}/var/cache"
    chmod 0755 "${PKG}/var/spool"
    chmod -R +w "${PKG}"

    install -Dm755 "${SRC}/run.cupsd" "${PKG}/etc/sv/cupsd/run"
    ln -s /run/runit/supervise.cupsd "${PKG}/etc/sv/cupsd/supervise"
}
