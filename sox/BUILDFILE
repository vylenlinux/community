description="The Swiss Army knife of sound processing tools"
homepage="https://sox.sourceforge.net/"
maintainer="Vylen Linux Team"

name=sox
version=14.7.1.1
release=1
source="$name-$version.tar.gz::https://codeberg.org/sox_ng/sox_ng/releases/download/sox_ng-$version/sox_ng-$version.tar.gz"

build() {
	cd ${name}_ng-$version
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--enable-replace \
		--with-distro="Vylen Linux" \
		--with-ffmpeg 
	make 
	make DESTDIR=$PKG install
}
