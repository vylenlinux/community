#!/bin/sh

# shellcheck disable=SC2034
description="WINE with staging patches"
homepage="https://gitlab.winehq.org/wine/wine/-/wikis/home"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wine-staging
version=11.23
release=1

vgecko=2.47.4
vmono=11.3.0

source="https://dl.winehq.org/wine/source/${version%%.*}.x/wine-${version}.tar.xz
    ${name}-${version}.tar.gz::https://gitlab.winehq.org/wine/${name}/-/archive/v${version}/${name}-v${version}.tar.gz
    https://dl.winehq.org/wine/wine-gecko/${vgecko}/wine-gecko-${vgecko}-x86.msi
    https://dl.winehq.org/wine/wine-gecko/${vgecko}/wine-gecko-${vgecko}-x86_64.msi
    https://dl.winehq.org/wine/wine-mono/${vmono}/wine-mono-${vmono}-x86.msi"

build() {
    (cd "wine-${version}" && "../${name}-v${version}/staging/patchinstall.py" DESTDIR="${PWD}" --all)
    export CPPFLAGS="${CPPFLAGS} -D_FORTIFY_SOURCE=0"

    mkdir wine64
    # shellcheck disable=SC2164
    cd wine64

    "../wine-${version}/configure" \
        --prefix=/usr \
        --libdir=/usr/lib \
        \
        --with-x \
        --with-wayland \
        --with-gstreamer \
        --with-xattr \
        --with-freetype \
        \
        --enable-win64 \
        --enable-archs=i386,x86_64 \
        --enable-build-id

    make depend
    make
    make DESTDIR="${PKG}" install

    install -Dm755 "${SRC}/wine-gecko-${vgecko}-x86.msi" "${SRC}/wine-gecko-${vgecko}-x86_64.msi" -t "${PKG}/usr/share/wine/gecko/"
    install -Dm755 "${SRC}/wine-mono-${vmono}-x86.msi" -t "${PKG}/usr/share/wine/mono/"
}
