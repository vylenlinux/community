#!/usr/bin/env sh

# shellcheck disable=SC2034
description="WINE with staging patches"
homepage="https://www.wine-staging.com"
maintainer="Vylen Linux Team"

name=wine-staging
version=11.11
release=2

vgecko=2.47.4
vmono=11.2.0

source="https://dl.winehq.org/wine/source/${version%%.*}.x/wine-${version}.tar.xz
    ${name}-${version}.tar.gz::https://gitlab.winehq.org/wine/${name}/-/archive/v${version}/${name}-v${version}.tar.gz
    https://dl.winehq.org/wine/wine-gecko/${vgecko}/wine-gecko-${vgecko}-x86.msi
    https://dl.winehq.org/wine/wine-gecko/${vgecko}/wine-gecko-${vgecko}-x86_64.msi
    https://dl.winehq.org/wine/wine-mono/${vmono}/wine-mono-${vmono}-x86.msi
    30-win32-aliases.conf
    wine-binfmt.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name%-*}-${version}"
        # apply staging patches
        "../wine-staging-v${version}/staging/patchinstall.py" DESTDIR="../wine-${version}" --all
    # shellcheck disable=SC2103
    cd ..

    install -d wine64
    export CPPFLAGS="${CPPFLAGS} -D_FORTIFY_SOURCE=0"

    # shellcheck disable=SC2164
    cd wine64

    "../wine-${version}/configure" \
        --prefix=/usr \
        --libdir=/usr/lib \
        --with-x \
        --with-wayland \
        --with-gstreamer \
        --with-xattr \
        --with-freetype \
        --enable-win64 \
        --enable-archs=i386,x86_64

    make depend
    make
    make DESTDIR="${PKG}" install

    for dir in gecko mono; do
        install -d "${PKG}/usr/share/wine/${dir}"
    done

    install -t "${PKG}/usr/share/wine/gecko/" \
        "${SRC}/wine-gecko-${vgecko}-x86.msi" \
        "${SRC}/wine-gecko-${vgecko}-x86_64.msi"

    install "${SRC}/wine-mono-${vmono}-x86.msi" "${PKG}/usr/share/wine/mono/"

    rm -r "${PKG}/usr/share/man"/??.UTF-8

    # exclude libs for revdep
    install -d "${PKG}/etc/revdep.d"
    # shellcheck disable=SC2028
    echo "/usr/lib/wine/x86_64-unix/" > "${PKG}/etc/revdep.d/${name}.conf"
}
