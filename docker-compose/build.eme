#!/bin/sh

# shellcheck disable=SC2034
description="Compose is a tool for defining and running multi-container Docker applications"
homepage="https://docs.docker.com/compose/"
maintainer="Vylen Linux Team"

name=docker-compose
version=5.4.0
release=1
source="https://github.com/docker/compose/archive/v${version}/${name}-${version}.tar.gz"

build() {
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CPPFLAGS="${CXXFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"

    # shellcheck disable=SC2164
    cd "compose-${version}"
    make VERSION="v${version}"

    install -Dm755 "bin/build/${name}" -t "${PKG}/usr/bin/"
    install -dm755 "${PKG}/usr/lib/docker/cli-plugins"

    ln -s "/usr/bin/${name}" -t "${PKG}/usr/lib/docker/cli-plugins/"
}
