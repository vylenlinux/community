#!/bin/sh

# shellcheck disable=SC2034
description="RSS feed reader for the command-line"
homepage="https://sourceforge.net/projects/snownews/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=snownews
version=1.11
release=1
source="https://sourceforge.net/projects/${name}/files/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
