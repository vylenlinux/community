description="HGL, a Native alternative Linux Launcher for Epic and GOG Games"
homepage="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher"
maintainer="Vylen Linux Team"

name=heroic-games-launcher-bin
version=2.20.1
release=1
noextract="*.pacman"
source="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v$version/heroic-$version-linux-x64.pacman"

build() {
  bsdtar -xJv -C $PKG -f $SRC/heroic-$version-linux-x64.pacman usr opt
  mkdir $PKG/usr/bin
  ln -s /opt/Heroic/heroic $PKG/usr/bin/heroic
  
}
