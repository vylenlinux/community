#!/bin/sh

# shellcheck disable=SC2034
description="SimpleScreenRecorder, a screen recorder for Linux"
homepage="https://github.com/MaartenBaert/ssr"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=simplescreenrecorder
version=0.4.4
release=1

source="${name}-${version}.tar.gz::https://github.com/MaartenBaert/ssr/archive/${version}/ssr-${version}.tar.gz
    ffmpeg7.patch"

build() {
    # shellcheck disable=SC2164
    cd "ssr-${version}"
    patch -p1 -i "${SRC}/ffmpeg7.patch"

    cmake \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DWITH_QT5=on

    make
    make DESTDIR="${PKG}" install
}
