#!/bin/sh

# shellcheck disable=SC2034
description="SimpleScreenRecorder, a screen recorder for Linux"
homepage="https://github.com/MaartenBaert/ssr"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=simplescreenrecorder
version=0.4.4
release=1

commit=e73e07664121ac30836872bca76194c6570e04c8
source="${name}-${version}-${commit}.tar.gz::https://github.com/MaartenBaert/ssr/archive/${commit}/ssr-${commit}.tar.gz"

build() {
    cmake -S "ssr-${commit}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DWITH_QT5=FALSE \
        -DWITH_QT6=TRUE

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
