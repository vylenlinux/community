#!/bin/sh

# shellcheck disable=SC2034
description="Modern, C++-native, header-only, test framework for unit-tests, TDD and BDD"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/catchorg/catch2"

name=catch2
version=3.16.1
release=1
source="${name}-${version}.tar.gz::https://github.com/catchorg/${name}/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    cmake -S "Catch2-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCATCH_BUILD_EXAMPLES=OFF \
        -DCATCH_ENABLE_COVERAGE=OFF \
        -DCATCH_ENABLE_WERROR=OFF \
        -DBUILD_TESTING=OFF \
        -DCATCH_DEVELOPMENT_BUILD=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
