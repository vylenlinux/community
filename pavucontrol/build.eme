#!/bin/sh

# shellcheck disable=SC2034
description="PulseAudio Volume Control"
homepage="https://gitlab.freedesktop.org/pulseaudio/pavucontrol"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pavucontrol
version=6.2
release=1
source="${name}-${version}.tar.gz::https://gitlab.freedesktop.org/pulseaudio/${name}/-/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    vylen-meson "${name}-v${version}" build -Dlynx=disabled
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
