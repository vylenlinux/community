#!/bin/sh

# shellcheck disable=SC2034
description="Wayland clipboard manager"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/sentriz/cliphist"

name=cliphist
version=0.7.0
release=1
source="https://github.com/sentriz/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw"

    go build -ldflags "-linkmode external -extldflags '${LDFLAGS}'" -o "${name}"
    install -Dm0755 "${name}" -t "${PKG}/usr/bin/"
}
