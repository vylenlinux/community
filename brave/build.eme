#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The best privacy online. Browse privately. Search privately. And ditch Big Tech."
homepage="https://brave.com/"
maintainer="Vylen Linux Team"

name=brave
version=1.90.124
release=1
source="${name}-${version}.deb::https://github.com/${name}/brave-browser/releases/download/v${version}/${name}-browser_${version}_amd64.deb"

build() {
    bsdtar -xf "${name}-${version}.deb"
    bsdtar -xf data.tar.xz -C "${PKG}"

    # copy icons
    for size in 16 24 32 48 64 128 256; do
        mkdir -p "${PKG}/usr/share/icons/hicolor/${size}x${size}/apps/"
        mv "${PKG}/opt/${name}.com/${name}/product_logo_${size}.png" "${PKG}/usr/share/icons/hicolor/${size}x${size}/apps/brave-browser.png"
    done
}
