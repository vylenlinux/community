#!/bin/sh

description="OpenBSD tool to signs and verify signatures on files"
homepage="https://github.com/aperezdc/signify"
maintainer="Vylen Linux Team"

name=signify
version=33
release=1
source="${name}-${version}.tar.gz::https://codeberg.org/aperezdc/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}"

    make PREFIX=/usr \
        LTO=1 \
        EXTRA_CFLAGS="${CFLAGS} ${CPPFLAGS}" \
        EXTRA_LDFLAGS="${LDFLAGS}" \
        GIT_TAG=''

    make PREFIX=/usr \
        DESTDIR="${PKG}" \
        GIT_TAG='' install
}
