description="chromium web store extension (for ungoogled-chromium)"
homepage="https://github.com/NeverDecaf/chromium-web-store"
maintainer="Vylen Linux Team"

name=chromium-extension-web-store
version=1.5.5.3
release=1
noextract="$name-$version.crx"
source="$name-$version.crx::https://github.com/NeverDecaf/chromium-web-store/releases/download/v$version/Chromium.Web.Store.crx"

build() {

_id=ocaahdebbfolfmndjeplogmgcagdmblk

    # Create extension json
    cat << EOF > "${_id}".json
{
    "external_crx": "/usr/lib/$name/$name-$version.crx",
    "external_version": "$version"
}
EOF

    install -Dm644 -t $PKG/usr/share/chromium/extensions/ ${_id}.json
    install -Dm644 -t $PKG/usr/lib/$name/ $name-$version.crx
}
