#!/bin/sh

# shellcheck disable=SC2034
description="Display a message or query in a window"
homepage="https://www.x.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xmessage
version=1.0.7
release=1
source="https://xorg.freedesktop.org/archive/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
