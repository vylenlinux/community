description="Display a message or query in a window"
homepage="https://xorg.freedesktop.org"
maintainer="Vylen Linux Team"

name=xmessage
version=1.0.7
release=1
source="http://ftp.x.org/pub/individual/app/xmessage-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

