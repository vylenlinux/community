#!/bin/sh

# shellcheck disable=SC2034
description="Foomatic - PPDs from printer manufacturers"
homepage="http://www.linuxprinting.org/foomatic.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=foomatic-db-ppds
version=20260904
release=1

commit=76dd1e31354c189b2edd9ae8201285d622c89395
source="${name%-*}-${version}-${commit}.tar.gz::https://github.com/OpenPrinting/foomatic-db/archive/${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name%-*}-${commit}"

    ./make_configure
    ./configure --prefix=/usr

    make DESTDIR="${PKG}" install

    # remove files from foomatic-db
    rm -rf "${PKG}/usr/share/foomatic/db/oldprinterids" \
        "${PKG}/usr/share/foomatic/db/source/driver" \
        "${PKG}/usr/share/foomatic/db/source/opt" \
        "${PKG}/usr/share/foomatic/db/source/printer" \
        "${PKG}/usr/share/foomatic/xmlschema"

    rm -f "${PKG}/usr/share/foomatic/db/source/PPD/Kyocera/ReadMe.htm"
}
