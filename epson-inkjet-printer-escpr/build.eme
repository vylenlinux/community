#!/bin/sh

# shellcheck disable=SC2034
description="Epson Inkjet Printer Driver (ESC/P-R) for Linux"
homepage="http://download.ebz.epson.net/dsc/search/01/search/?OSC=LX"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=epson-inkjet-printer-escpr
version=1.8.10
release=1
source="${name}-${version}.rpm::https://download-center.epson.com/f/module/d3003be6-1230-4495-a683-b627604d565c/${name}-${version}-1.src.rpm"

CURL_OPTS="-L -A Firefox"

build() {
    export CFLAGS="${CFLAGS} \
        -Wno-implicit-function-declaration"

    tar zxf "${name}-${version}-1.tar.gz"

    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --with-cupsfilterdir=/usr/lib/cups/filter \
        --with-cupsppddir=/usr/share/ppd

    make
    make DESTDIR="${PKG}" install
}
