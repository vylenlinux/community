description="Epson Inkjet Printer Driver (ESC/P-R) for Linux"
homepage="http://download.ebz.epson.net/dsc/search/01/search/?OSC=LX"
maintainer="Vylen Linux Team"

name=epson-inkjet-printer-escpr
version=1.8.6
release=1
source="https://download3.ebz.epson.net/dsc/f/03/00/16/21/81/74d098a47c3a616713079c9cd5904b468bb33dea/epson-inkjet-printer-escpr-${version}-1.tar.gz"

build() {

	export CFLAGS="$CFLAGS -Wno-implicit-function-declaration"

	cd $name-$version
	autoreconf -vif
	./configure \
		--prefix=/usr \
		--with-cupsfilterdir=/usr/lib/cups/filter \
	  	--with-cupsppddir=/usr/share/ppd
	make
	make DESTDIR=$PKG install
}
