#!/bin/sh

# shellcheck disable=SC2034
description="A shell utility for manipulating Linux IDE drive/driver parameters"
homepage="https://sourceforge.net/projects/hdparm/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=hdparm
version=9.65
release=1
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make
    make DESTDIR="${PKG}" sbindir=/usr/bin install

    install -Dm755 contrib/idectl -t "${PKG}/usr/bin/"
    install -Dm755 contrib/ultrabayd -t "${PKG}/usr/bin/"
}
