#!/bin/sh

# shellcheck disable=SC2034
description="Modular status bar for somebar, based on dwmblocks."
homepage="https://git.sr.ht/~raphi/someblocks/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=someblocks
version=1.0.1
release=1

source="${name}-${version}.tar.gz::https://git.sr.ht/~raphi/${name}/archive/${version}.tar.gz
    blocks.h"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    export PREFIX=/usr

    make
    make DESTDIR="${PKG}" install
}
