description="A media player, streamer, and encoder"
homepage="https://www.videolan.org/"
maintainer="Vylen Linux Team"

name=vlc
version=3.0.23
release=1
source="https://download.videolan.org/$name/$version/$name-$version.tar.xz"
build() {
	cd $name-$version

	autoreconf -fv
        ./configure \
		--prefix=/usr \
		--disable-jack \
		--disable-sndio \
		--disable-libplacebo \
		--disable-opencv \
		--disable-sftp \
		--disable-gst-decode
	make
	make DESTDIR=$PKG install
}
