#!/bin/sh

# shellcheck disable=SC2034
description="A media player, streamer, and encoder"
homepage="https://www.videolan.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=vlc
version=3.0.24
release=1
source="https://download.videolan.org/${name}/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -f

    ./configure \
        --prefix=/usr \
        --disable-jack \
        --disable-sndio \
        --disable-libplacebo \
        --disable-opencv \
        --disable-sftp \
        --disable-gst-decode

    make
    make DESTDIR="${PKG}" install
}
