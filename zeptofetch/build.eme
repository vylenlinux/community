#!/bin/sh

# shellcheck disable=SC2034
description="Blazingly fast, ultra-minimal system information tool for Linux"
homepage="https://github.com/Gur0v/zeptofetch"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=zeptofetch
version=2.2
release=1
source="${name}-${version}.tar.gz::https://github.com/Gur0v/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make CFLAGS="${CFLAGS}" LDFLAGS="${LDFLAGS}" STRIP=true
    make PREFIX=/usr DESTDIR="${PKG}" install
}
