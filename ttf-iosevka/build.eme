#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Typeface family designed for coding, terminal use and technical documents. "
homepage="https://typeof.net/Iosevka/"
maintainer="Vylen Linux Team"

name=ttf-iosevka
version=34.3.0
release=1
source="${name}-${version}.zip::https://github.com/be5invis/Iosevka/releases/download/v${version}/PkgTTF-Iosevka-${version}.zip"

build() {
    install -d "${PKG}/usr/share/fonts/iosevka"
    # shellcheck disable=SC2035
    install -m644 *.ttf "${PKG}/usr/share/fonts/iosevka"
}
