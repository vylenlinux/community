#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Support programs for Network File Systems"
homepage="http://nfs.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nfs-utils
version=3.1.1
release=1
source="https://www.kernel.org/pub/linux/utils/${name}/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed -i "s|sbindir = /sbin|sbindir = /usr/bin|g" utils/*/Makefile.am
    sed -i "s|sbin|bin|" utils/nfsidmap/id_resolver.conf
    sed -i "s|libexec|bin|" tools/nfsrahead/99-nfs.rules

    autoreconf -fi

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --libexecdir=/usr/bin \
        --with-statedir=/var/lib/nfs \
        --with-systemd=no \
        --without-tcp-wrappers \
        --disable-gss \
        --enable-libmount-mount

    make
    make PREFIX="${PKG}/usr" DESTDIR="${PKG}" install

    rm -f "${PKG}/usr/share/man/man7/nfs.systemd.7.gz"
}
