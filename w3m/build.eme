#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Pager that can also be used as a text-based web browser"
homepage="http://w3m.sourceforge.net/"
maintainer="Vylen Linux Team"

name=w3m
version=0.5.6
release=1
source="${name}-${version}.tar.gz::https://git.sr.ht/~rkta/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-v${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --enable-image=x11,fb \
        --with-imagelib=imlib2 \
        --disable-w3mmailer

    make
    make DESTDIR="${PKG}" install

    rm -r "${PKG}/usr/share/man/ja"
    rm "${PKG}/usr/share/w3m/w3mhelp-funcdesc.ja.pl"

    install -v -m644 -D doc/keymap.default "${PKG}/etc/w3m/keymap"
    install -v -m644 doc/menu.default "${PKG}/etc/w3m/menu"
}
