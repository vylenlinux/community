#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Pager that can also be used as a text-based web browser"
homepage="http://w3m.sourceforge.net/"
maintainer="Vylen Linux Team"

name=w3m
version=0.5.6
release=1
source="${name}-${version}.tar.gz::https://git.sr.ht/~rkta/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-v${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --enable-image=x11,fb \
        --with-imagelib=imlib2 \
        --disable-w3mmailer

    make
    make DESTDIR="${PKG}" install

    install -Dm644 doc/keymap.default -t "${PKG}/etc/w3m/keymap/"
    install -Dm644 doc/menu.default -t "${PKG}/etc/w3m/menu/"
}
