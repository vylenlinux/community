#!/bin/sh

# shellcheck disable=SC2034
description="Direct3D 12 to Vulkan translation library By WineHQ."
homepage="https://github.com/d3d12/vkd3d"
maintainer="Vylen Linux Team"

name=vkd3d
version=2.0
release=1
source="https://dl.winehq.org/${name}/source/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --with-spirv-tools

    make
    make DESTDIR="${PKG}" install
}
