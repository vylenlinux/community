#!/usr/bin/env sh

# shellcheck disable=SC2034
description="An interactive post-processing tool for scanned pages"
homepage="https://github.com/ScanTailor-Advanced/scantailor-advanced"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=scantailor-advanced
version=1.2.1
release=1
source="https://github.com/${name}/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    sed -e '/native/d' -i CMakeLists.txt

    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    #install -Dm0644 "src/resources/appicon.svg" "$PKG/usr/share/icons/hicolor/scalable/apps/scantailor-advanced.svg"
    #install -Dm0644 "src/resources/unix/scantailor.desktop.in" "$PKG/usr/share/applications/scantailor.desktop"
}
