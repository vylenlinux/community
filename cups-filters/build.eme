#!/bin/sh

# shellcheck disable=SC2034
description="Backends and filters for CUPS"
homepage="https://wiki.linuxfoundation.org/openprinting/cups-filters"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cups-filters
version=2.0.1
release=1

source="${name}-${version}.tar.gz::https://github.com/OpenPrinting/${name}/archive/${version}.tar.gz
    9871a50b5c1f9c2caa2754aac1f5db70c886021b.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    emerald is-installed avahi || OPTAVA='--disable-avahi'
    emerald is-installed mupdf || OPTMUP='--disable-mutool'
    emerald is-installed poppler || OPTPOP='--disable-poppler'

    patch -Np1 -i "${SRC}/9871a50b5c1f9c2caa2754aac1f5db70c886021b.patch"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --docdir="/usr/share/doc/${name}" \
        --disable-static \
        "${OPTAVA}" \
        "${OPTMUP}" \
        "${OPTPOP}"

    make
    make DESTDIR="${PKG}" install
}
