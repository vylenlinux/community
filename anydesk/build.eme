#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The Fast Remote Desktop Application"
homepage="https://anydesk.com"
maintainer="Vylen Linux Team"

name=anydesk
version=8.0.2
release=1
source="${name}-${version}.tar.gz::https://download.anydesk.com/linux/${name}-${version}-amd64.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    install -Dm755 "${name}"                                 -t "${PKG}/usr/bin/"
    install -Dm644 "${name}.desktop"                         -t "${PKG}/usr/share/applications/"
    install -Dm644 "polkit-1/com.${name}.${name}.policy"     -t "${PKG}/usr/share/polkit-1/actions/"
    install -Dm644 "icons/hicolor/scalable/apps/${name}.svg" -t "${PKG}/usr/share/pixmaps/"
}
