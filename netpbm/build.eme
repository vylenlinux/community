#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A toolkit for manipulation of graphic images"
homepage="http://netpbm.sourceforge.net/"
maintainer="Vylen Linux Team"

name=netpbm
version=11.15.1
release=1

source="https://github.com/ceamac/${name}-make-dist/releases/download/v${version}/${name}-${version}.tar.xz
    pgmtopbm"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cp config.mk.in config.mk

    # shellcheck disable=SC2129
    printf 'CFLAGS_SHLIB = -fPIC\n' >> config.mk
    printf 'TIFFLIB = libtiff.so\n' >> config.mk
    printf 'JPEGLIB = libjpeg.so\n' >> config.mk
    printf 'PNGLIB = libpng.so\n' >> config.mk
    printf 'ZLIB = libz.so\n' >> config.mk

    sed -i 's|misc|share/netpbm|' common.mk
    sed -i 's|/link|/lib|' lib/Makefile
    sed -i 's|install.manwebmain install.manweb install.man|install.man|' GNUmakefile

    make
    make pkgdir="${PKG}/usr" PKGMANDIR=share/man install-run install-dev

    install -Dm755 "${SRC}/pgmtopbm" -t "${PKG}/usr/bin/"
}
