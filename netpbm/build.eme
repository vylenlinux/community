#!/bin/sh

# shellcheck disable=SC2034
description="A toolkit for manipulation of graphic images"
homepage="https://netpbm.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=netpbm
version=11.16.5
release=1

source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz
    pgmtopbm
    config.mk"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cp config.mk.in config.mk

    cat "${SRC}/config.mk" >> config.mk
    sed 's|misc|share/netpbm|' -i common.mk

    make
    make pkgdir="${PKG}/usr" PKGMANDIR=share/man install-run install-dev

    install -Dm755 "${SRC}/pgmtopbm" -t "${PKG}/usr/bin/"
    ln -s /usr/lib/libnetpbm.so.11 "${PKG}/usr/lib/libnetpbm.so"
}
