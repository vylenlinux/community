#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Temurin 11 (OpenJDK 11 Java binaries by Adoptium, formerly AdoptOpenJDK)"
homepage="https://github.com/adoptium/"
maintainer="Vylen Linux Team"

name=openjdk-11-bin
version=11.0.31+11
release=1
source="${name}-${version}.tar.gz::https://github.com/adoptium/temurin${version%%.*}-binaries/releases/download/jdk-${version}/OpenJDK${version%%.*}U-jdk_x64_linux_hotspot_$(printf "%s" "${version}" | sed 's/+/_/g').tar.gz"

build() {
    install -dm 755 "${PKG}/usr/lib/jvm/java-${version%%.*}-openjdk"
    cp --reflink=auto -a "${SRC}/jdk-${version}"/* "${PKG}/usr/lib/jvm/java-${version%%.*}-openjdk"

    # Exclude for revdep
    install -d "${PKG}/etc/revdep.d"
    echo "/usr/lib/jvm/java-${version%%.*}-openjdk/" > "${PKG}/etc/revdep.d/${name}.conf"
}
