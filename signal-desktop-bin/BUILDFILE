#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Private messaging from your desktop"
homepage="https://signal.org"
maintainer="Vylen Linux Team"

name=signal-desktop-bin
version=8.5.0
release=1

source="https://updates.signal.org/desktop/apt/pool/s/signal-desktop/${name%-*}_${version}_amd64.deb
    signal-desktop-wayland"

build() {
    bsdtar -xf "${name%-*}_${version}_amd64.deb"
    bsdtar -xf data.tar.xz -C "${PKG}"

    install -d "${PKG}/usr/bin"
    ln -s /opt/Signal/signal-desktop "${PKG}/usr/bin/signal-desktop"

    # wayland launcher
    emerald isinstalled wayland && install -Dm755 "${SRC}/signal-desktop-wayland" -t "${PKG}/usr/bin/"
}
