#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Build cross platform desktop apps with web technologies "
homepage="https://electronjs.org/"
maintainer="Vylen Linux Team"

name=electron-bin
version=41.0.4
release=1

source="${name}-chromedriver-${version}-linux-x64.zip::https://github.com/electron/electron/releases/download/v${version}/chromedriver-v${version}-linux-x64.zip
    ${name}-${version}-linux-x64.zip::https://github.com/electron/electron/releases/download/v${version}/${name-bin}-v${version}-linux-x64.zip"

build() {
    install -dm755 "${PKG}/usr/lib/${name-bin}"
    find . -mindepth 1 -maxdepth 1 -type f ! -name "*.zip" ! -name "LICENSE*" -exec cp --reflink=auto -r --no-preserve=ownership --preserve=mode -t "${PKG}/usr/lib/${name-bin}/." {} +

    for _folder in 'locales' 'resources'; do
        install -dm755 "${PKG}/usr/lib/${name-bin}/${_folder}"
        cp --reflink=auto -r --no-preserve=ownership --preserve=mode "${_folder}" "${PKG}/usr/lib/${name-bin}/${_folder}"
    done

    chmod u+s "${PKG}/usr/lib/${name-bin}/chrome-sandbox"

    install -dm755 "${PKG}/usr/bin"
    ln -nfs "/usr/lib/${name-bin}/${name%-bin}" "${PKG}/usr/bin/${name-bin}"
}
