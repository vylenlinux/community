#!/bin/sh

# shellcheck disable=SC2034
description="Iconic font designed for Bootstrap"
homepage="https://fontawesome.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-awesome
version=7.3.1
release=1
source="${name}-${version}.tar.gz::https://github.com/FortAwesome/Font-Awesome/archive/${version}/awesome-font-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Font-Awesome-${version}"

    install -Dm644 webfonts/*.woff2 -t "${PKG}/usr/share/fonts/WOFF2/"
    install -Dm644 otfs/*.otf -t "${PKG}/usr/share/fonts/OTF/"
}
