description="Kart racing game featuring Tux and his friends"
homepage="https://supertuxkart.net"
maintainer="Vylen Linux Team"

name=supertuxkart
version=1.5
release=1
source="https://github.com/supertuxkart/stk-code/releases/download/$version/SuperTuxKart-$version-src.tar.gz"

build() {
	cmake -S $SRC/SuperTuxKart-$version-src -B build -G Ninja \
	     -DCMAKE_BUILD_TYPE=None \
	     -DCMAKE_INSTALL_PREFIX=/usr \
	     -DCMAKE_INSTALL_LIBDIR=lib \
	     -DBUILD_RECORDER=0 \
	     -DUSE_GLES2=$GLES2_RENDERER
	cmake --build build
        DESTDIR=$PKG cmake --install build
}
