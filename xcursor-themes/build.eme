description="Redglass and whiteglass animated cursor themes"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team"

name=xcursor-themes
version=1.0.7
release=1
source="http://ftp.x.org/pub/individual/data/xcursor-themes-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}
