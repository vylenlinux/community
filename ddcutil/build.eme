#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Program for querying and changing monitor settings, such as brightness and color levels"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://www.ddcutil.com"

name=ddcutil
version=3.0.0
release=1
source="https://github.com/rockowitz/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --enable-drm

    make
    make DESTDIR="${PKG}" install
}
