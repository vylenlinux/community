#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Professional vector graphics editor"
homepage="https://inkscape.org/"
maintainer="Vylen Linux Team"

name=inkscape
version=1.4.3
release=3

source="https://media.inkscape.org/dl/resources/file/${name}-${version}.tar.xz
    ${name}-1.4.3-poppler-26_fixes-2.patch
    ${name}-1.4.3-gcc16.patch"

build() {
    patch -d "${name}-${version}"_* -Np1 -i "${SRC}/${name}-1.4.3-poppler-26_fixes-2.patch"
    patch -d "${name}-${version}"_* -Np1 -i "${SRC}/${name}-1.4.3-gcc16.patch"

    cmake -S "${name}-${version}"_* -B build -G Ninja \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DPOPPLER_INCLUDE_DIR=/usr/include/poppler \
        -DWITH_INTERNAL_2GEOM=ON \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
