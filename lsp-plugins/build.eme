#!/bin/sh

# shellcheck disable=SC2034
description="Collection of free plugins compatible with LADSPA, LV2 and LinuxVST"
homepage="https://lsp-plug.in/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lsp-plugins
version=1.2.37
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make config \
        PREFIX=/usr \
        SHARE_PATH=/usr/share \
        ADD_FEATURES=xdg \
        SUB_FEATURES=doc

    make fetch
    make
    make DESTDIR="${PKG}" install
}
