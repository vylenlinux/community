description="The Motif toolkit"
homepage="https://sourceforge.net/projects/motif/"
maintainer="Vylen Linux Team"

name=motif
version=2.3.8
release=1
source="https://sourceforge.net/projects/motif/files/$name-$version.tar.gz
	add-wmluiltok-main-function.patch
	no-demos.patch"

build() {
	cd $name-$version

	export CFLAGS="$CFLAGS -Wno-error=implicit-function-declaration -Wno-error=format-security"

	patch -Np1 -i $SRC/add-wmluiltok-main-function.patch  
	patch -Np1 -i $SRC/no-demos.patch

	touch NEWS AUTHORS
	autoreconf -fi
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
