description="Almost exact clone of ncmpc with some new features"
homepage="https://rybczak.net/ncmpcpp/"
maintainer="Vylen Linux Team"

name=ncmpcpp
version=0.10.1
release=1
commit=e8f1c4bd48350789300c5f87c5ea21ea4256cf6f
source="$name-$version.tar.gz::https://github.com/ncmpcpp/ncmpcpp/archive/$version.tar.gz"

build() {
	cd $name-$version

	autoreconf -fiv

	BOOST_LIB_SUFFIX='' ./configure \
		--prefix=/usr \
		--enable-shared='yes' \
		--enable-static='no' \
		--enable-fast-install='yes' \
		--enable-clock \
		--enable-outputs \
		--enable-visualizer \
		--with-fftw \
		--with-taglib
	make
	make DESTDIR=$PKG install

	mkdir -p $PKG/usr/share/$name
	mv $PKG/usr/share/doc/$name/config \
	   $PKG/usr/share/doc/$name/bindings \
	   $PKG/usr/share/$name

	sed -i 's,/usr/share/doc/,/usr/share/,g' \
	   $PKG/usr/share/man/man1/ncmpcpp.1
}
