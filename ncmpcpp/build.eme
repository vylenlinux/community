#!/bin/sh

# shellcheck disable=SC2034
description="Almost exact clone of ncmpc with some new features"
homepage="https://rybczak.net/ncmpcpp/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ncmpcpp
version=0.10.1
release=1

source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz
    fix-boost-system-header-only.patch
    fix-boost-transform-iterator-sort.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/fix-boost-system-header-only.patch"
    patch -Np1 -i "${SRC}/fix-boost-transform-iterator-sort.patch"

    autoreconf -fi

    BOOST_LIB_SUFFIX='' ./configure \
        --prefix=/usr \
        --enable-shared='yes' \
        --enable-static='no' \
        --enable-fast-install='yes' \
        --enable-clock \
        --enable-outputs \
        --enable-visualizer \
        --with-fftw \
        --with-taglib

    make
    make DESTDIR="${PKG}" install

    mkdir -p "${PKG}/usr/share/${name}"

    mv "${PKG}/usr/share/doc/${name}/config" \
        "${PKG}/usr/share/doc/${name}/bindings" \
    -t "${PKG}/usr/share/${name}/"

    sed -i 's,/usr/share/doc/,/usr/share/,g' "${PKG}/usr/share/man/man1/${name}.1"
}
