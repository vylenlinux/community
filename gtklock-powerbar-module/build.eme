#!/bin/sh

# shellcheck disable=SC2034
description="gtklock module adding power controls to the lockscreen"
homepage="https://github.com/jovanlanik/gtklock-powerbar-module"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gtklock-powerbar-module
version=5.0.1
release=1
source="${name}-${version}.tar.gz::https://github.com/jovanlanik/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
