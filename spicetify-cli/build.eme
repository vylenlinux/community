#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Command-line tool to customize Spotify client"
homepage="https://github.com/spicetify/spicetify-cli"
maintainer="Vylen Linux Team"

name=spicetify-cli
version=2.43.2
release=1
source="https://github.com/spicetify/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "cli-${version}"
    export GOPATH="${SRC}"

    go build -o spicetify
    install -Dm755 ./spicetify -t "${PKG}/usr/share/${name}/"

    cp -r ./Themes ./Extensions ./CustomApps ./jsHelper ./globals.d.ts ./css-map.json "${PKG}/usr/share/${name}"
    rm -f ./shortcut

    echo "#!/bin/sh
    /usr/share/${name}/spicetify \"\$@\"" >> ./shortcut

    install -Dm755 ./shortcut "${PKG}/usr/bin/spicetify"
    go clean -modcache
}
