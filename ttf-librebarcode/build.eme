#!/bin/sh

# shellcheck disable=SC2034
description="Barcode fonts for various barcode standards"
homepage="https://github.com/graphicore/librebarcode"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-librebarcode
version=1.008
release=1
source="${name}-${version}.tar.gz::https://github.com/graphicore/librebarcode/archive/pre-v${version}.tar.gz"

build() {
    install -Dm644 "librebarcode-pre-v${version}/fonts"/*.ttf -t "${PKG}/usr/share/fonts/TTF/"
}
