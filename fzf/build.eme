#!/bin/sh

# shellcheck disable=SC2034
description="A general-purpose command-line fuzzy finder"
homepage="https://github.com/junegunn/fzf/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=fzf
version=0.74.5
release=1
source="${name}-${version}.tar.gz::https://github.com/junegunn/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    go build -o "${name}"

    install -Dm755 "${name}" bin/fzf-tmux -t "${PKG}/usr/bin/"
    install -Dm644 shell/*.bash shell/*.zsh -t "${PKG}/usr/share/${name}/"
}
