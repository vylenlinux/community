description="A general-purpose command-line fuzzy finder"
homepage="https://github.com/junegunn/fzf/"
maintainer="Vylen Linux Team"

name=fzf
version=0.70.0
release=1
source="$name-$version.tar.gz::https://github.com/junegunn/fzf/archive/v$version.tar.gz"

build() {
	cd $name-$version
	go build -o fzf

	install -dm755 $PKG/usr/bin
	install -m755 fzf bin/fzf-tmux $PKG/usr/bin/

	install -dm755 $PKG/usr/share/fzf
	install -m644 shell/*.bash shell/*.zsh $PKG/usr/share/fzf
}
