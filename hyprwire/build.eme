#!/bin/sh

# shellcheck disable=SC2034
description="A fast and consistent wire protocol for IPC"
homepage="https://github.com/hyprwm/hyprwire"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=hyprwire
version=0.3.1
release=1
source="https://github.com/hyprwm/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
