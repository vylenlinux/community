#!/usr/bin/env sh

# shellcheck disable=SC2034
description="File and print services to SMB/CIFS clients and Windows networking to Linux clients"
homepage="https://www.samba.org"
maintainer="Vylen Linux Team"

name=samba
version=4.24.1
release=1

source="https://www.samba.org/ftp/${name}/stable/${name}-${version}.tar.gz
    ${name}.pam"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib/samba \
        --localstatedir=/var \
        --with-piddir=/run/samba \
        --with-sockets-dir=/run/samba \
        --with-pammodulesdir=/lib/security \
        --bundled-libraries=!tdb,!talloc \
        --enable-fhs \
        --without-json \
        --without-systemd \
        --without-ad-dc \
        --without-ads \
        --without-ldap

    make
    make DESTDIR="${PKG}" install

    install -d "${PKG}/lib"

    mv -v "${PKG}/usr/lib"/libnss_wins.so* "${PKG}/lib"
    mv -v "${PKG}/usr/lib"/libnss_winbind.so* "${PKG}/lib"

    ln -v -sf ../../lib/libnss_winbind.so.2 "${PKG}/usr/lib/libnss_winbind.so"
    ln -v -sf ../../lib/libnss_wins.so.2 "${PKG}/usr/lib/libnss_wins.so"

    install -v -m644 examples/smb.conf.default "${PKG}/etc/samba"

    # revdep exclude
    mkdir -p "${PKG}/etc/revdep.d"

    echo "/usr/lib/samba/" > "${PKG}/etc/revdep.d/samba.conf"
    echo "/usr/lib/python3.*/site-packages/samba/" >> "${PKG}/etc/revdep.d/samba.conf"

    # install pam file
    install -Dm644 "${SRC}/samba.pam" "${PKG}/etc/pam.d/samba"
    do_service "${name}"
}

# rpcsvc-proto perl-parse-yapp talloc perl-json