description="A module dedicated to file loading and saving"
homepage="https://github.com/gedit-technology/libgedit-gfls"
maintainer="Vylen Linux Team"

name=libgedit-gfls
version=0.3.1
release=1
source="https://gitlab.gnome.org/World/gedit/libgedit-gfls/-/archive/$version/$name-$version.tar.bz2"

build() {
	vylen-meson $name-$version build -Dgtk_doc=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
