#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Google Noto TTF fonts"
homepage="https://fonts.google.com/noto"
maintainer="Vylen Linux Team"

name=ttf-noto
version=2026.05.01
release=1
source="${name}-${version}.tar.zst::https://london.mirror.pkgbuild.com/extra/os/x86_64/noto-fonts-1:${version}-${release}-any.pkg.tar.zst"

build() {
    rm -rf usr/share/licenses
    cp -r usr "${PKG}"
}
