#!/usr/bin/env sh

# shellcheck disable=SC2034
description="BitTorrent library with a focus on high performance and good code"
homepage="https://rakshasa.github.io/rtorrent/"
maintainer="Vylen Linux Team"

name=libtorrent
version=0.16.12
release=1
source="${name}-${version}.tar.gz::https://github.com/rakshasa/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fiv

    ./configure \
        --prefix=/usr \
        --disable-debug

    make
    make DESTDIR="${PKG}" install
}
