#!/bin/sh

# shellcheck disable=SC2034
description="C command-line client for tldr pages"
homepage="https://github.com/tldr-pages/tldr-c-client"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tldr
version=1.6.1
release=1
source="https://github.com/tldr-pages/tldr-c-client/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-c-client-${version}"
    export PREFIX="${PKG}/usr"

    make
    make DESTDIR="${PKG}" install
}
