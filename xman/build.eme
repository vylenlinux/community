#!/bin/sh

# shellcheck disable=SC2034
description="xman manual page browser"
homepage="https://xorg.freedesktop.org/archive/individual/app/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xman
version=1.2.0
release=1
source="https://xorg.freedesktop.org/archive/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
