#!/usr/bin/env sh

# shellcheck disable=SC2034
description="GeoIP legacy country database (based on GeoLite2 data created by MaxMind)"
homepage="https://mailfud.org/geoip-legacy/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=geoip-database
version=20261003
release=1

source="GeoIP-${version}.dat.gz::https://mailfud.org/geoip-legacy/GeoIP.dat.gz
    GeoIPv6-${version}.dat.gz::https://mailfud.org/geoip-legacy/GeoIPv6.dat.gz
    GeoIPCity-${version}.dat.gz::https://mailfud.org/geoip-legacy/GeoIPCity.dat.gz
    GeoIPCityv6-${version}.dat.gz::https://mailfud.org/geoip-legacy/GeoIPCityv6.dat.gz
    GeoIPASNum-${version}.dat.gz::https://mailfud.org/geoip-legacy/GeoIPASNum.dat.gz
    GeoIPASNumv6-${version}.dat.gz::https://mailfud.org/geoip-legacy/GeoIPASNumv6.dat.gz"

build() {
    # shellcheck disable=SC2035
    gunzip *.gz

    for file in GeoIP GeoIPv6 GeoIPCity GeoIPCityv6 GeoIPASNum GeoIPASNumv6; do
        install -Dm644 "${file}-${version}.dat" "${PKG}/usr/share/GeoIP/${file}.dat"
    done
}
