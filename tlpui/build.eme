#!/usr/bin/env sh

# shellcheck disable=SC2034
description="GTK user interface for TLP written in Python"
homepage="https://github.com/d4nj1/TLPUI"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tlpui
version=1.10.1
release=1
source="${name}-${version}.tar.gz::https://github.com/d4nj1/${name}/archive/refs/tags/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "TLPUI-${name}-${version}"

    python3 -m build \
        --wheel \
        --no-isolation

    python3 -m installer --destdir="${PKG}" dist/*.whl
    install -Dm664 "${name}.desktop" -t "${PKG}/usr/share/applications/"
}
