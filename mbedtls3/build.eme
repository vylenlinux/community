#!/bin/sh

# shellcheck disable=SC2034
description="Cryptographic library for embedded systems"
homepage="https://github.com/ArmMbed"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mbedtls3
version=3.6.7
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR="lib/${name}" \
        -DCMAKE_INSTALL_INCLUDEDIR="include/${name}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DUSE_SHARED_MBEDTLS_LIBRARY=ON \
        -DUSE_STATIC_MBEDTLS_LIBRARY=ON \
        -DINSTALL_MBEDTLS_HEADERS=ON \
        -DMBEDTLS_FATAL_WARNINGS=OFF \
        -DENABLE_TESTING=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    # add prefix to binaries
    for f in "${PKG}/usr/bin"/*; do
        mv "${f}" "${PKG}/usr/bin/${name}_${f##*/}"
    done

    # fix static lib perms
    chmod 644 "${PKG}/usr/lib/${name}"/*.a

    # symlinks for shared libs
    for lib in "${PKG}/usr/lib/${name}"/lib*.so.*; do
        ln -sf "${name}/${lib##*/}" "${PKG}/usr/lib/${lib##*/}"
    done
}
