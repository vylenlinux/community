#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Cryptographic library for embedded systems"
homepage="https://tls.mbed.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mbedtls3
version=3.6.7
release=2

_framework_commit="893ad9e8450a8e7459679d952abd5d6df26c41c4"

source="https://github.com/ARMmbed/mbedtls/archive/v${version}/mbedtls-${version}.tar.gz
    https://github.com/Mbed-TLS/mbedtls-framework/archive/${_framework_commit}/mbedtls-framework-${_framework_commit}.tar.gz"

build() {
    rm -rf "mbedtls-${version}/framework"
    mv "mbedtls-framework-${_framework_commit}" "mbedtls-${version}/framework"

    cmake -S "mbedtls-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib/mbedtls3 \
        -DCMAKE_INSTALL_INCLUDEDIR=include/mbedtls3 \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DUSE_SHARED_MBEDTLS_LIBRARY=ON \
        -DUSE_STATIC_MBEDTLS_LIBRARY=ON \
        -DINSTALL_MBEDTLS_HEADERS=ON \
        -DMBEDTLS_FATAL_WARNINGS=OFF \
        -DENABLE_TESTING=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    # add prefix to binaries
    for f in "${PKG}/usr/bin"/*; do
        mv "${f}" "${PKG}/usr/bin/${name}_${f##*/}"
    done

    # fix static lib perms
    chmod 644 "${PKG}/usr/lib/mbedtls3"/*.a

    # symlinks for shared libs
    for lib in "${PKG}/usr/lib/mbedtls3"/lib*.so.*; do
        ln -sf "mbedtls3/${lib##*/}" "${PKG}/usr/lib/${lib##*/}"
    done
}
