#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A flat theme with transparent elements for GTK 3, GTK 2 and Gnome-Shell."
homepage="https://github.com/jnsh/arc-gtk-theme"
maintainer="Vylen Linux Team"

name=arc-gtk-theme
version=20221218
release=1
source="https://github.com/jnsh/arc-theme/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "arc-theme-${version}"

    vylen-meson -Dthemes=gtk2,gtk3,metacity,xfwm build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
