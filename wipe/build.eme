#!/bin/sh

# shellcheck disable=SC2034
description="Secure file wiping utility"
homepage="http://wipe.sourceforge.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wipe
version=2.3.1
release=1
source="https://downloads.sourceforge.net/${name}/${name}-${version}.tar.bz2"
build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export CPPFLAGS=""
    export CFLAGS="${CFLAGS} -Wno-error=implicit-int"

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man

    make
    make prefix="${PKG}/usr" mandir="${PKG}/share/man" install
}
