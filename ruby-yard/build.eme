#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Ruby Documentation tool"
homepage="https://yardoc.org/"
maintainer="Vylen Linux Team"

name=ruby-yard
version=0.9.45
release=1
source="https://rubygems.org/downloads/${name#*-}-${version}.gem"

build() {
    _gemdir="$(gem env gemdir)"

    gem install \
        --ignore-dependencies \
        --no-user-install \
        --no-document \
        -i "${PKG}/${_gemdir}" \
        -n "${PKG}/usr/bin" \
        "${name#*-}-${version}.gem"

    rm "${PKG}/${_gemdir}/cache/${name#*-}-${version}.gem"
}
