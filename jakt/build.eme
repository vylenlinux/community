#!/bin/sh

# shellcheck disable=SC2034
description="The Jakt Programming Language"
homepage="https://github.com/SerenityOS/jakt"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jakt
version=20260821+1
release=1

commit=14c980b0f16d9cbe9136818302fb504e26583416

source="https://github.com/SerenityOS/${name}/archive/${commit}/${name}-${version}.tar.gz
    ${name}-destdir-symlink.patch"

build() {
    export CC=clang
    export CXX=clang++

    patch -d "${name}-${commit}" -Np1 -i "${SRC}/${name}-destdir-symlink.patch"

    cmake -S "${name}-${commit}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DFINAL_STAGE=1 \
        -DJAKT_BUILD_TESTING=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
