#!/bin/sh

# shellcheck disable=SC2034
description="The Jakt Programming Language"
homepage="https://github.com/SerenityOS/jakt"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=jakt
version=14c980b
release=1

source="https://github.com/SerenityOS/${name}/archive/${version}/${name}-${version}.tar.gz
    jakt-destdir-symlink.patch"

build() {
    export CC=clang
    export CXX=clang++

    patch -d "${name}-${version}"* -Np1 -i "${SRC}/jakt-destdir-symlink.patch"

    cmake -S "${name}-${version}"* -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DFINAL_STAGE=1 \
        -DJAKT_BUILD_TESTING=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
