diff --git a/cmake/install-rules.cmake b/cmake/install-rules.cmake
index b434b25..df7be66 100644
--- a/cmake/install-rules.cmake
+++ b/cmake/install-rules.cmake
@@ -103,10 +103,18 @@ install(
     COMPONENT Jakt_Development
 )

-# Make a symlink bin/jakt to the final compiler we created, but install it after the real targets
-# to make sure that if we're using hardlinks, the link can actually be created
+# Install a regular copy under the convenient `jakt` command name.
 set(final_stage_target "jakt_stage${FINAL_STAGE}")
-set(final_stage_install_target "${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}/$<TARGET_FILE_NAME:${final_stage_target}>")
-
-install(CODE "include(\"${CMAKE_CURRENT_LIST_DIR}/symlink.cmake\")")
