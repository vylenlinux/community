#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A generic driver for the .NET Core Command Line Interface"
maintainer="Vylen Linux Team"
homepage="https://www.microsoft.com/net/core"

name=dotnet-host
version=10.0.201
release=1

source="dotnet-${version}.tar.gz::https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/dotnet-sdk-${version}-linux-x64.tar.gz
    dotnet.sh"

build() {
    for dir in bin lib share/dotnet share/dnx; do
        install -dm755 "${PKG}/usr/${dir}"
    done

    cp -dr --no-preserve='ownership' dotnet host dnx "${PKG}/usr/share/dotnet/"

    ln -sf /usr/share/dotnet/dotnet "${PKG}"/usr/bin/dotnet
    ln -sf /usr/share/dotnet/dnx "${PKG}/usr/bin/dnx"
    ln -sf "/usr/share/dotnet/host/fxr/${version}/libhostfxr.so" "${PKG}/usr/lib/libhostfxr.so"

    install -Dm644 "${SRC}/dotnet.sh" -t "${PKG}/etc/profile.d/"
}
