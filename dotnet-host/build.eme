#!/bin/sh

# shellcheck disable=SC2034
description="A generic driver for the .NET Core Command Line Interface"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://dotnet.microsoft.com/en-us/download"

name=dotnet-host
version=11.0.100
release=1

source="dotnet-${version}.tar.gz::https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/dotnet-sdk-${version}-linux-x64.tar.gz
    dotnet.sh"

build() {
    for dir in bin lib share/dotnet; do
        install -dm755 "${PKG}/usr/${dir}"
    done

    cp -dr --no-preserve=ownership dotnet host dnx -t "${PKG}/usr/share/dotnet/"

    ln -sf /usr/share/dotnet/dotnet -t "${PKG}/usr/bin/"
    ln -sf /usr/share/dotnet/dnx -t "${PKG}/usr/bin/"
    ln -sf "/usr/share/dotnet/host/fxr/${version}/libhostfxr.so" -t "${PKG}/usr/lib/"

    install -Dm644 "${SRC}/dotnet.sh" -t "${PKG}/etc/profile.d/"
}
