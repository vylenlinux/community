#!/bin/sh

# shellcheck disable=SC2034
description="Library that provides an API shared by several applications on the GNOME Desktop"
homepage="https://www.gnome.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gnome-desktop
version=44.5
release=2
source="http://ftp.gnome.org/pub/gnome/sources/${name}/${version%.*}/${name}-${version}.tar.xz"

build() {
    sed -i "/^subdir('tests')$/d" "${name}-${version}/meson.build"
    sed -i "/^subdir('examples')$/d" "${name}-${version}/meson.build"

    vylen-meson "${name}-${version}" build \
        -Ddesktop_docs=false \
        -Ddebug_tools=false \
        -Dsystemd=disabled \
        -Dbuild_gtk4=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    rm -f "${PKG}/usr/include/gnome-desktop-3.0/libgnome-desktop/gnome-systemd.h"
}
