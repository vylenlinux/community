#!/bin/sh

# shellcheck disable=SC2034
description="Mount MTP devices over FUSE"
homepage="https://github.com/hanwen/go-mtpfs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=go-mtpfs
version=1.0.0
release=1
source="https://github.com/hanwen/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    go build \
        -trimpath \
        -buildmode=pie \
        -mod=readonly \
        -modcacherw \
        -o go-mtpfs .

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
}
