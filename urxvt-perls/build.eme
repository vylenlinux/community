#!/bin/sh

# shellcheck disable=SC2034
description="Perl extensions for the rxvt-unicode terminal emulator"
homepage="https://github.com/muennich/urxvt-perls"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=urxvt-perls
version=2.3
release=1
source="${name}-${version}.tar.gz::https://github.com/xyb3rt/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    install -Dm644 keyboard-select deprecated/clipboard deprecated/url-select -t "${PKG}/usr/lib/urxvt/perl/"
}
