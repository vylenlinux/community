#!/bin/sh

# shellcheck disable=SC2034
description="ALSA Configuration for PulseAudio"
homepage="https://www.alsa-project.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pulseaudio-alsa
version=1.2.12
release=1

build() {
    install -dm755 "${PKG}/etc/alsa/conf.d"
    ln -s /usr/share/alsa/alsa.conf.d/99-pulseaudio-default.conf -t "${PKG}/etc/alsa/conf.d/"
}
