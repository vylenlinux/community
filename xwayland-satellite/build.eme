#!/bin/sh

# shellcheck disable=SC2034
description="Xwayland outside your Wayland"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/Supreeeme/xwayland-satellite"

name=xwayland-satellite
version=0.8.3
release=1
source="https://github.com/Supreeeme/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cargo fetch --locked

    cargo build \
        --frozen \
        --release \
        --all-features

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
    install -Dm644 "${name}.man" "${PKG}/usr/share/man/man1/${name}.1"
}
