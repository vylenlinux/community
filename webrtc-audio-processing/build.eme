#!/usr/bin/env sh

# shellcheck disable=SC2034
description="a packaging friendly copy of the AudioProcessing module from the WebRTC project"
homepage="https://freedesktop.org/software/pulseaudio/webrtc-audio-processing/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=webrtc-audio-processing
version=2.1
release=2

source="https://gitlab.freedesktop.org/pulseaudio/${name}/-/archive/v${version}/${name}-v${version}.tar.bz2
    58.patch
    60.patch"

build() {
    patch -d "${name}-v${version}" -Np1 -i "${SRC}/58.patch"
    patch -d "${name}-v${version}" -Np1 -i "${SRC}/60.patch"

    vylen-meson "${name}-v${version}" build \
        -Dcpp_std=c++17 \
        -Dneon=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install -C build
}
