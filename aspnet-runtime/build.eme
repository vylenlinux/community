#!/bin/sh

# shellcheck disable=SC2034
description="The ASP.NET Core runtime"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://dotnet.microsoft.com/en-us/download"

name=aspnet-runtime
version=10.0.403
release=1
source="dotnet-${version}.tar.gz::https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/dotnet-sdk-${version}-linux-x64.tar.gz"

build() {
    install -dm755 "${PKG}/usr/share/dotnet/shared"
    cp -dr --no-preserve=ownership shared/Microsoft.AspNetCore.App -t "${PKG}/usr/share/dotnet/shared/"
}
