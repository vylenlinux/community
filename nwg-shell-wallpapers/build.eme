#!/bin/sh

# shellcheck disable=SC2034
description="nwg-shell wallpapers package"
homepage="https://github.com/nwg-piotr/nwg-shell-wallpapers"
maintainer="Vylen Linux Team"

name=nwg-shell-wallpapers
version=1.5
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz"

build() {
    install -Dm644 "${name}-${version}/wallpapers"/* -t "${PKG}/usr/share/backgrounds/nwg-shell/"
}
