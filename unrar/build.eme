#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The RAR uncompression program"
homepage="https://www.rarlab.com/rar_add.htm"
maintainer="Vylen Linux Team"

name=unrar
version=7.2.6
release=1
source="${name}-${version}.tar.gz::https://www.rarlab.com/rar/unrarsrc-${version}.tar.gz"

build() {
    cp -a unrar libunrar

    sed -e '/CXXFLAGS=/d' -e '/LDFLAGS=/d' -i unrar/makefile
    export LDFLAGS="${LDFLAGS} -pthread"

    make -C libunrar lib
    make -C unrar -j1

    install -v -Dm755 unrar/unrar "${PKG}/usr/bin/unrar"
    install -Dm755 libunrar/libunrar.so "${PKG}/usr/lib/libunrar.so"
    install -Dm644 libunrar/dll.hpp "${PKG}/usr/include/unrar/dll.hpp"
}
