#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The RAR uncompression program"
homepage="https://www.rarlab.com/rar_add.htm"
maintainer="Vylen Linux Team"

name=unrar
version=7.2.7
release=1
source="${name}-${version}.tar.gz::https://www.rarlab.com/rar/unrarsrc-${version}.tar.gz"

build() {
    cp -a unrar libunrar

    sed -e '/CXXFLAGS=/d' -e '/LDFLAGS=/d' -i unrar/makefile
    export LDFLAGS="${LDFLAGS} -pthread"

    make -C libunrar lib
    make -C unrar -j1

    install -Dm755 unrar/unrar -t "${PKG}/usr/bin/"
    install -Dm755 libunrar/libunrar.so -t "${PKG}/usr/lib/"
    install -Dm644 libunrar/dll.hpp -t "${PKG}/usr/include/unrar/"
}
