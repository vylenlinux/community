#!/bin/sh
#
# LightDM wrapper to run around X sessions.

printf "Running X session wrapper\n"

# Load profile
for file in /etc/profile "${HOME}/.profile" /etc/xprofile "${HOME}/.xprofile" /usr/local/etc/xprofile; do
    if [ -f "${file}" ]; then
        printf "Loading profile from %s\n" "${file}"
        # shellcheck source=$file
        . "${file}"
    fi
done

# Load resources
for file in /etc/X11/Xresources "${HOME}/.Xresources"; do
    if [ -f "${file}" ]; then
        printf "Loading resource: %s\n" "${file}"
        xrdb -merge "${file}"
    fi
done

# Load keymaps
for file in /etc/X11/Xkbmap "${HOME}/.Xkbmap"; do
    if [ -f "${file}" ]; then
        printf "Loading keymap: %s\n" "${file}"
        setxkbmap "$(cat "${file}")"

        XKB_IN_USE=yes
    fi
done

# Load xmodmap if not using XKB
if [ -z "${XKB_IN_USE}" ]; then
    for file in /etc/X11/Xmodmap "${HOME}/.Xmodmap"; do
        if [ -f "${file}" ]; then
           printf "Loading modmap: %s\n" "${file}"
           xmodmap "${file}"
        fi
    done
fi

unset XKB_IN_USE

# Run all system xinitrc shell scripts
xinitdir=/etc/X11/xinit/xinitrc.d

if [ -d "${xinitdir}" ]; then
    for script in "${xinitdir}"/*; do
        printf "Loading xinit script %s\n" "${script}"

        if [ -x "${script}" ] && [ ! -d "${script}" ]; then
            # shellcheck source=$script
            . "${script}"
        fi
    done
fi

# Run user xsession shell script
script="${HOME}/.xsession"

if [ -x "${script}" ] && [ ! -d "${script}" ]; then
    printf "Loading xsession script %s\n" "${script}"
    # shellcheck source=$script
    . "${script}"
fi

printf "X session wrapper complete, running session %s\n" "${@}"
exec "${@}"
