#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight display manager"
homepage="https://github.com/ubuntu/lightdm"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lightdm
version=1.33.1
release=1

backup="etc/${name}/keys.conf
    etc/${name}/${name}.conf
    etc/${name}/users.conf"

source="${name}-${version}.tar.gz::https://github.com/ubuntu/${name}/archive/refs/tags/${version}.tar.gz
    Xsession
    ${name}.rules
    ${name}-default-config.patch
    fix-pam-path.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/${name}-default-config.patch"
    patch -Np1 -i "${SRC}/fix-pam-path.patch"

    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --libexecdir="/usr/lib/${name}" \
        --localstatedir=/var \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --disable-static \
        --disable-tests \
        --disable-nls \
        --with-greeter-user="${name}" \
        --with-greeter-session="${name}-gtk-greeter"

    make
    make DESTDIR="${PKG}" install

    rm -rf "${PKG}/etc/init"

    install -Dm755 "${SRC}/Xsession" -t "${PKG}/etc/${name}/"
    install -Dm644 "${SRC}/${name}.rules" "${PKG}/usr/share/polkit-1/rules.d/${name}.rules"

    sed -i 's:#session-wrapper=lightdm-session:session-wrapper=/etc/lightdm/Xsession:' "${PKG}/etc/${name}/${name}.conf"
    sed -i 's:minimum-uid=500:minimum-uid=1000:' "${PKG}/etc/${name}/users.conf"

    do_service "${name}"
    do_sysusers "${name}"
    do_tmpfiles "${name}"
}
