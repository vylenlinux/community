#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Lightweight display manager"
homepage="https://github.com/canonical/lightdm"
maintainer="Vylen Linux Team"

name=lightdm
version=1.32.0
release=1

backup="etc/${name}/keys.conf
    etc/${name}/${name}.conf
    etc/${name}/users.conf"

source="https://github.com/CanonicalLtd/${name}/releases/download/${version}/${name}-${version}.tar.xz
    Xsession
    ${name}.rules"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir="/usr/lib/${name}" \
        --localstatedir=/var \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --disable-static \
        --disable-tests \
        --disable-nls \
        --with-greeter-user="${name}" \
        --with-greeter-session=lightdm-gtk-greeter

    make
    make DESTDIR="${PKG}" install

    rm -rf "${PKG}/etc/init"

    install -Dm755 "${SRC}/Xsession" -t "${PKG}/etc/lightdm/"
    install -Dm644 "${SRC}/${name}.rules" "${PKG}/usr/share/polkit-1/rules.d/${name}.rules"

    sed -i 's:#session-wrapper=lightdm-session:session-wrapper=/etc/lightdm/Xsession:' "${PKG}/etc/lightdm/lightdm.conf"
    sed -i 's:minimum-uid=500:minimum-uid=1000:' "${PKG}/etc/lightdm/users.conf"

    do_service "${name}"
    do_pam "${name}" "${name}-autologin"
}
