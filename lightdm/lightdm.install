#!/bin/sh

pre_install() {
    getent group lightdm >/dev/null || groupadd -g 65 lightdm
    getent passwd lightdm >/dev/null || useradd -r -M -g lightdm -G lightdm -c "Lightdm Daemon" -d /var/lib/lightdm -s /usr/bin/nologin -u 65 lightdm
}

post_remove() {
    getent passwd lightdm >/dev/null && userdel lightdm
    getent group lightdm >/dev/null && groupdel lightdm
}
