description="Simple Login Manager"
homepage="https://slim-fork.sourceforge.io/"
maintainer="Vylen Linux Team"

name=slim
version=1.4.1
release=1
backup="etc/slim.conf"

source="https://sourceforge.net/projects/${name}-fork/files/$name-$version.tar.gz
	pam-headers.patch
	$name.pam
	run.slim"

build() {
	cd $name-$version
	
	patch -Np1 -i $SRC/pam-headers.patch
	cmake -B build \
	    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_LIBEXECDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DUSE_CONSOLEKIT=yes \
		-DUSE_PAM=yes \
		-Wno-dev 
	cmake --build build
	DESTDIR=$PKG cmake --install build

	# remove systemd things
	rm -rf $PKG/lib

	install -Dm644 $SRC/$name.pam $PKG/etc/pam.d/$name
	install -Dm755 $SRC/run.slim $PKG/etc/sv/sshd/run

	ln -s /run/runit/supervise.slim $PKG/etc/sv/sshd/supervise
}
