#!/bin/sh

# shellcheck disable=SC2034
description="Manage installation of multiple softwares in the same directory tree"
homepage="https://ftp.gnu.org/gnu/stow/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=stow
version=2.4.1
release=1
source="https://ftp.gnu.org/gnu/${name}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-nfsv4 \
        --disable-gss

    make
    make DESTDIR="${PKG}" PREFIX="${PKG}/usr" install
}
