#!/bin/sh

# shellcheck disable=SC2034
description="Terminal emulator that supports tabs and grids"
homepage="https://github.com/gnome-terminator/terminator"
maintainer="Vylen Linux Team"

name=terminator
version=2.1.6
release=1
source="https://github.com/gnome-terminator/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    python3 setup.py build

    python3 setup.py install \
        --skip-build \
        --root="${PKG}" \
        --optimize=1
}
