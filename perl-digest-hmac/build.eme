#!/bin/sh

# shellcheck disable=SC2034
description="Keyed-Hashing for Message Authentication"
homepage="http://metacpan.org/release/Digest-HMAC"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-digest-hmac
version=1.05
release=1
source="${name}-${version}.tar.gz::http://search.cpan.org/CPAN/authors/id/A/AR/ARODLAND/Digest-HMAC-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Digest-HMAC-${version}"

    perl Makefile.PL
    make OPTIMIZE="${CFLAGS}" DESTDIR="${PKG}" install
}
