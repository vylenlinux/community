#!/bin/sh

ranlib_mingw_gcc() {
    # These libraries need to be run ranlib for fine building of wine
    LIBS='libgcc.a
        libgcc_eh.a'

    # shellcheck disable=SC2164
    cd "/usr/lib/gcc/i686-w64-mingw32/${1}"

    for i in ${LIBS}; do
        i686-w64-mingw32-ranlib "${i}"
    done
}

post_install() {
    ranlib_mingw_gcc "${1}"
}

post_upgrade() {
    ranlib_mingw_gcc "${2}"
}
