#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A sleek and minimal desktop shell thoughtfully crafted for Wayland, built with Quickshell."
maintainer="Vylen Linux Team"
homepage="https://github.com/noctalia-dev/noctalia-shell"

name=noctalia-shell
version=4.7.7
release=1
source="https://github.com/noctalia-dev/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    install -dm755 "${PKG}/etc/xdg/quickshell/${name}"
    # shellcheck disable=SC2035
    cp -r * "${PKG}/etc/xdg/quickshell/${name}/"
}
