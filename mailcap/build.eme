#!/bin/sh

# shellcheck disable=SC2034
description="Helper application and MIME type associations for file types"
homepage="https://github.com/InfrastructureServices/mailcap"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mailcap
version=2.1.54
release=1
backup="etc/${name}"

_version="$(printf '%s' "${version}" | tr '.' '-')"
source="${name}-${version}.tar.gz::https://github.com/InfrastructureServices/${name}/archive/refs/tags/r${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-r${_version}"

    make
    make DESTDIR="${PKG}" install
}
