description="Fast and lightweight IDE"
homepage="https://www.geany.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=geany
version=2.1
release=1
source="http://download.geany.org/$name-$version.tar.bz2"

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--disable-api-docs \
		--disable-html-docs \
		--disable-pdf-docs \
		--disable-nls
	make
	make DESTDIR=$PKG install
}
