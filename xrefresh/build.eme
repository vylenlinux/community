#!/bin/sh

# shellcheck disable=SC2034
description="Refresh all or part of an X screen"
homepage="https://gitlab.freedesktop.org/xorg/app/xrefresh"
maintainer="Vylen Linux Team"

name=xrefresh
version=1.1.1
release=1
source="http://ftp.x.org/pub/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
