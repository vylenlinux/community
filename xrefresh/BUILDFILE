description="Refresh all or part of an X screen"
homepage="https://gitlab.freedesktop.org/xorg/app/xrefresh"
maintainer="Vylen Linux Team"

name=xrefresh
version=1.1.0
release=1
source="http://ftp.x.org/pub/individual/app/xrefresh-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

