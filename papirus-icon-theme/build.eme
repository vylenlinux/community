#!/bin/sh

# shellcheck disable=SC2034
description="Papirus icon theme"
homepage="https://github.com/PapirusDevelopmentTeam"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=papirus-icon-theme
version=20260801
release=1
source="https://github.com/PapirusDevelopmentTeam/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make DESTDIR="${PKG}" ICON_THEMES="Papirus" install

    rm -f "${PKG}/usr/share/icons/Papirus"/*/mimetypes/text-x-systemd-unit.svg \
        "${PKG}/usr/share/icons/Papirus"/*/places/folder*systemd.svg \
        "${PKG}/usr/share/icons/Papirus"/*/symbolic/mimetypes/text-x-systemd-unit-symbolic.svg
}
