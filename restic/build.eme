#!/bin/sh

# shellcheck disable=SC2034
description="Fast, secure, efficient backup program"
homepage="https://github.com/restic/restic"
maintainer="Vylen Linux Team"

name=restic
version=0.19.1
release=1
source="https://github.com/${name}/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export GOPATH="${PWD}/path"
    export GOCACHE="${PWD}/cache"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"

    export GOFLAGS="-buildmode=pie \
        -trimpath \
        -modcacherw"

    go build -ldflags "-X 'main.version=${version}'" ./cmd/...

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
    install -Dm644 doc/man/*.1 -t "${PKG}/usr/share/man/man1/"
    install -Dm644 doc/zsh-completion.zsh "${PKG}/usr/share/zsh/site-functions/_restic"
    install -Dm644 doc/bash-completion.sh "${PKG}/usr/share/bash-completion/completions/${name}"
}
