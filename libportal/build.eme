#!/bin/sh

# shellcheck disable=SC2034
description="libportal provides GIO-style async APIs for most Flatpak portals."
homepage="https://github.com/flatpak/libportal"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libportal
version=0.11.0
release=1
source="https://github.com/flatpak/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Ddocs=false \
        -Dbackend-gtk4="$(emerald is-installed gtk4 && printf "enabled" || printf "disabled")" \
        -Dbackend-qt5="$(emerald is-installed qt5 && printf "enabled" || printf "disabled")" \
        -Dbackend-qt6=enabled

    meson compile -C build
    DESTDIR="${PKG}" meson install -C build
}
