description="Enhanced version of the Berkeley C shell"
homepage="https://www.tcsh.org/"
maintainer="Vylen Linux Team"

name=tcsh
version=6.24.16
release=1
backup="etc/csh.cshrc
	etc/csh.login"
source="https://astron.com/pub/$name/$name-$version.tar.gz
	csh.cshrc
	csh.login"

build() {
	cd $name-$version

#	sed -i 's|SVID_SOURCE|DEFAULT_SOURCE|g' config/linux
#	sed -i 's|BSD_SOURCE|DEFAULT_SOURCE|g'  config/linux

	./configure --prefix=/usr --bindir=/bin
	make
	make DESTDIR=$PKG install

	ln -v -sf tcsh $PKG/bin/csh
	ln -v -sf tcsh.1 $PKG/usr/share/man/man1/csh.1

	install -d $PKG/etc
	install -m 644 $SRC/csh.* $PKG/etc

}
