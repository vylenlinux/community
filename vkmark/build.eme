#!/bin/sh

# shellcheck disable=SC2034
description="Vulkan benchmark"
homepage="https://github.com/vkmark/vkmark"
maintainer="Vylen Linux Team"

name=vkmark
version=2025.01
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
