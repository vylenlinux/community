#!/bin/sh

# shellcheck disable=SC2034
description="RandR-based backlight control application"
homepage="https://www.x.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xbacklight
version=1.2.4
release=1
source="https://xorg.freedesktop.org/archive/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
