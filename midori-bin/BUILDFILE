description="Midori Web Browser - a lightweight, fast and secure web browser"
homepage="https://astian.org/midori-browser"
maintainer="Vylen Linux Team"

name=midori-bin
version=11.6
release=1
source="$name-$version.deb::https://github.com/goastian/midori-desktop/releases/download/v$version/midori_${version}-1_amd64.deb"
build() {
