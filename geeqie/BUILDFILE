description="Gtk+ based image viewer"
homepage="http://geeqie.org/"
maintainer="Vylen Linux Team"

name=geeqie
version=2.7
release=1
source="https://github.com/BestImageViewer/geeqie/releases/download/v$version/$name-$version.tar.xz"

build() {
	vylen-meson $name-$version build
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
