description="Fully featured yet light and fast cross platform word processor"
homepage="http://www.abisource.com"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=abiword
version=3.0.8
release=1
source="$name-$version.tar.bz2::https://gitlab.gnome.org/World/AbiWord/-/archive/release-$version/AbiWord-release-$version.tar.bz2 enchant.patch"

_plugins="applix babelfish bmp clarisworks collab docbook command eml epub freetranslation garble \
	gdict gimp google hancom hrtext iscii kword latex loadbindings mht mif mswrite openwriter \
	openxml opml paint passepartout pdb pdf presentation s5 sdw t602 urldict wikipedia wml xslfo"

build() {
	cd AbiWord-release-$version

	# fix build with GCC 14
	export CFLAGS="$CFLAGS -Wno-incompatible-pointer-types"

	patch -Np1 -i $SRC/enchant.patch
	sed -i 's/enchant >=/enchant-2 >=/' configure.ac

	./autogen-common.sh
	autoreconf -fi

	./configure \
		--prefix=/usr \
		--disable-static \
		--enable-plugins="$_plugins" \
		--enable-shared
	make
	make DESTDIR=$PKG install
}
