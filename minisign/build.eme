#!/bin/sh

# shellcheck disable=SC2034
description="A dead simple tool to sign files and verify digital signatures."
homepage="https://jedisct1.github.io/minisign/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=minisign
version=0.12
release=1

commit=e369d9447d7d96b8bbc6a7cd73b6b1e4ccd2f934
source="${name}-${version}-${commit}.tar.gz::https://github.com/jedisct1/${name}/archive/${commit}/${commit}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"

    zig build \
        -Dcpu=baseline \
        -Doptimize=ReleaseSmall

    install -Dm755 "zig-out/bin/${name}" -t "${PKG}/usr/bin/"
    install -Dm644 share/man/man1/* -t "${PKG}/usr/share/man/man1/"
}
