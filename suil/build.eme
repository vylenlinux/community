#!/bin/sh

# shellcheck disable=SC2034
description="suil library for loading and wrapping lv2 plugins UIs"
homepage="https://gitlab.com/lv2/suil"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=suil
version=0.10.26
release=1
source="https://download.drobilla.net/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Ddocs=disabled \
        -Dcocoa=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
