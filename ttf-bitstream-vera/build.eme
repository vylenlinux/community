#!/bin/sh

# shellcheck disable=SC2034
description="Bitstream Vera fonts"
homepage="https://launchpad.net/ttf-bitstream-vera/main"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-bitstream-vera
version=1.10
release=1
source="https://ftp.gnome.org/pub/GNOME/sources/${name}/${version}/${name}-${version}.tar.gz"

build() {
    install -Dm644 "${name}-${version}"/*.ttf -t "${PKG}/usr/share/fonts/TTF/"
}
