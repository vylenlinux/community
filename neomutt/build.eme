#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A version of mutt with added features"
homepage="https://neomutt.org/"
maintainer="Vylen Linux Team"

name=neomutt
version=20260504
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --gpgme \
        --enable-lua \
        --gss \
        --ssl \
        --with-ui=ncurses \
        --with-idn=/usr \
        --gdbm \
        --disable-nls \
        --disable-doc

    make
    make DESTDIR="${PKG}" install
}
