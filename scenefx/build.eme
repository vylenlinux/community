#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Drop-in replacement for the wlroots scene API"
maintainer="Vylen Linux Team"
homepage="https://github.com/wlrfx/scenefx"

name=scenefx
version=0.5
release=1
source="${name}-${version}.tar.gz::https://github.com/wlrfx/scenefx/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dwerror=false \
        -Db_ndebug=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
