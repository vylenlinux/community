#!/bin/sh

# shellcheck disable=SC2034
description="Manages IPv4 and IPv6 addresses and subnets"
homepage="https://search.cpan.org/~miker/NetAddr-IP/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-netaddr-ip
version=4.079
release=1
source="${name}-${version}.tar.gz::https://search.cpan.org/CPAN/authors/id/M/MI/MIKER/NetAddr-IP-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "NetAddr-IP-${version}"
    export OPTIMIZE="${CFLAGS}"

    perl Makefile.PL
    make DESTDIR="${PKG}" install
}
