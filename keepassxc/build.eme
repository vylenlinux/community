#!/bin/sh

# shellcheck disable=SC2034
description="Cross-platform community-driven port of Keepass password manager"
homepage="https://keepassxc.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=keepassxc
version=2.8.0
release=1
source="${name}-${version}.tar.xz::https://github.com/keepassxreboot/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DWITH_GUI_TESTS=OFF \
        -DKPXC_FEATURE_BROWSER=ON \
        -DKPXC_FEATURE_NETWORK=ON \
        -DKPXC_FEATURE_SSHAGENT=ON \
        -DKPXC_FEATURE_FDOSECRETS=ON \
        -DKPXC_FEATURE_DOCS=ON \
        -DKPXC_FEATURE_UPDATES=OFF \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
