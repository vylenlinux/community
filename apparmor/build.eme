#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Linux application security framework - mandatory access control for programs"
homepage="https://gitlab.com/apparmor/apparmor/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=apparmor
version=5.0.2
release=1

source="${name}-${version}.tar.gz::https://gitlab.com/${name}/${name}/-/archive/v${version}/${name}-v${version}.tar.gz
    https://gitlab.com/apparmor/apparmor/-/commit/6b80489953728aab8aeb4f9075283feb26e2e262.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-v${version}"
    patch -Np1 -i "${SRC}/6b80489953728aab8aeb4f9075283feb26e2e262.patch"

    # shellcheck disable=SC2164
    cd libraries/libapparmor
        msg_info "Building: libapparmor"
        ./autogen.sh

        ./configure \
            --prefix=/usr \
            --sbindir=/usr/bin \
            --libdir=/usr/lib \
            --libexecdir=/usr/lib \
            --with-python \
            --with-perl

        make
    # shellcheck disable=SC2103
    # shellcheck disable=SC2164
    cd -

    msg_info "Building: apparmor parser"
    make -C parser

    msg_info "Building: apparmor-binutils"
    make -C binutils

    msg_info "Building: apparmor-utils"
    make -C utils

    msg_info "Building: apparmor-profiles"
    make -C profiles

    msg_info "Building: apparmor-pam"
    make -C changehat/pam_apparmor

    msg_info "Building: apparmor-vim"
    make -C utils/vim

    make -C libraries/libapparmor install DESTDIR="${PKG}"
    make -C changehat/pam_apparmor install DESTDIR="${PKG}"
    make -C binutils install DESTDIR="${PKG}" SBINDIR="${PKG}/usr/bin" USR_SBINDIR="${PKG}/usr/bin"
    make -C parser install DESTDIR="${PKG}" SBINDIR="${PKG}/usr/bin" USR_SBINDIR="${PKG}/usr/bin"
    make -C profiles install DESTDIR="${PKG}"
    make -C utils install DESTDIR="${PKG}" SBINDIR="${PKG}/usr/bin" USR_SBINDIR="${PKG}/usr/bin" BINDIR="${PKG}/usr/bin" VIM_INSTALL_PATH="${PKG}/usr/share/vim/vimfiles/syntax"
    make -C init DESTDIR="${PKG}" SBINDIR="${PKG}/usr/bin" USR_SBINDIR="${PKG}/usr/bin" APPARMOR_BIN_PREFIX="${PKG}/usr/lib/apparmor" install

    mv "${PKG}/lib/security" -t "${PKG}/usr/lib/"
    rmdir "${PKG}/lib"

    rm -f "${PKG}/etc/apparmor.d/abstractions"/*systemd* \
        "${PKG}/etc/apparmor.d"/systemd*

    install -Dm644 changehat/pam_apparmor/README "${PKG}/usr/share/doc/apparmor/README.pam_apparmor"
    do_service "${name}"
}
