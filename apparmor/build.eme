#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Linux application security framework - mandatory access control for programs"
homepage="https://gitlab.com/apparmor/apparmor/wikis/home"
maintaner="Vylen Linux Team"

name=apparmor
version=5.0.0
release=1

source="${name}-${version}.tar.gz::https://gitlab.com/${name}/${name}/-/archive/v${version}/${name}-v${version}.tar.gz
    run.${name}"

build() {
    export PYTHON_VERSION=3
    export PYTHON_VERSIONS=python3
    export PYTHON=/usr/bin/python3

    # shellcheck disable=SC2164
    cd libraries/libapparmor

    msg "Building: libapparmor"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --with-python \
        --with-perl

    make

    # shellcheck disable=SC2164
    cd "${name}-v${version}"

    msg "Building: apparmor parser"
    make -C parser

    msg "Building: apparmor-binutils"
    make -C binutils

    msg "Building: apparmor-utils"
    make -C utils

    msg "Building: apparmor-profiles"
    make -C profiles

    msg "Building: apparmor-pam"
    make -C changehat/pam_apparmor

    msg "Building: apparmor-vim"
    make -C utils/vim

    DESTDIR="${PKG}" make -C libraries/libapparmor install
    DESTDIR="${PKG}" make -C changehat/pam_apparmor install
    DESTDIR="${PKG}" BINDIR="${PKG}/usr/bin" make -C binutils install
    DESTDIR="${PKG}" BINDIR="${PKG}/usr/bin" make -C parser install
    DESTDIR="${PKG}" make -C profiles install
    DESTDIR="${PKG}" BINDIR="${PKG}/usr/bin" VIM_INSTALL_PATH="${PKG}/usr/share/vim/vimfiles/syntax" make -C utils install

    mv "${PKG}/lib" "${PKG}/usr/lib"
    mkdir -p "${PKG}/usr/lib/apparmor" "${PKG}/lib"
    mv "${PKG}/usr/lib/lib/security" "${PKG}/lib"

    rm -r "${PKG}/usr/lib/lib/"
    install -Dm644 changehat/pam_apparmor/README "${PKG}/usr/share/doc/apparmor/README.pam_apparmor"

    install -Dm755 "${SRC}/run.${name}" "${PKG}/etc/sv/${name}/run"
    ln -s "/run/runit/supervise.${name}" "${PKG}/etc/sv/$name/supervise"
}
