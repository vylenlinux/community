#!/usr/bin/env sh

# shellcheck disable=SC2034
description="An RSS/Atom feed reader for text terminals"
homepage="https://newsboat.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=newsboat
version=2.44
release=1

source="https://newsboat.org/releases/${version}/${name}-${version}.tar.xz
    ${name}.1.gz
    podboat.1.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make prefix=/usr newsboat podboat

    install -Dm755 newsboat podboat -t "${PKG}/usr/bin/"
    install -Dm644 "${SRC}"/*.1.gz -t "${PKG}/usr/share/man/man1/"
}
