#!/bin/sh

# shellcheck disable=SC2034
description="An RSS/Atom feed reader for text terminals"
homepage="https://newsboat.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=newsboat
version=2.45.1
release=1
source="https://newsboat.org/releases/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make prefix=/usr "${name}" podboat

    install -Dm755 "${name}" podboat -t "${PKG}/usr/bin/"
    do_man "${name}" podboat
}
