#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A control daemon, CLI tools, and a collection of crates for interacting with ASUS ROG laptops"
homepage="https://asus-linux.org"
maintainer="Vylen Linux Team"

name=asusctl
version=6.3.4
release=1

source="https://gitlab.com/asus-linux/${name}/-/archive/${version}/${name}-${version}.tar.gz
    run.asusd"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export CARGO_HOME="${SRC}/cargo"
    cargo build --release --locked

    install -Dm755 "target/release/${name}"    -t "${PKG}/usr/bin/"
    install -Dm755 "target/release/asusd"      -t "${PKG}/usr/bin/"
    install -Dm755 "target/release/asusd-user" -t "${PKG}/usr/bin/"

    install -Dm644 "rog-aura/data/aura_support.ron" -t "${PKG}/usr/share/asusd/"
    install -Dm644 "data/asusd.conf"                -t "${PKG}/usr/share/dbus-1/system.d/"

    # shellcheck disable=SC2164
    cd rog-anime/data
        find "./anime" -type f -exec install -Dm644 "{}" "${PKG}/usr/share/asusd/{}" \;
    # shellcheck disable=SC2164
    # shellcheck disable=SC2103
    cd -

    install -Dm755 "${SRC}/run.asusd" "${PKG}/etc/sv/asusd/run"
    ln -s "/run/runit/supervise.asusd" "${PKG}/etc/sv/asusd/supervise"
}
