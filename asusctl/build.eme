#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A control daemon, CLI tools, and a collection of crates for interacting with ASUS ROG laptops"
homepage="https://asus-linux.org"
maintainer="Vylen Linux Team"

name=asusctl
version=6.3.7
release=1
source="https://gitlab.com/asus-linux/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export CARGO_HOME="${SRC}/cargo"
    cargo build --release --locked

    for bin in "${name}" asusd asusd-user; do
        install -Dm755 "target/release/${bin}" -t "${PKG}/usr/bin/"
    done

    install -Dm644 rog-aura/data/aura_support.ron -t "${PKG}/usr/share/asusd/"
    install -Dm644 data/asusd.conf                -t "${PKG}/usr/share/dbus-1/system.d/"

    find rog-anime/data/anime -type f -exec install -Dm644 "{}" "${PKG}/usr/share/asusd/{}" \;
    do_service asusd
}
