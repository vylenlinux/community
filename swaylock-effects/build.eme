#!/bin/sh

# shellcheck disable=SC2034
description="A fancier screen locker for Wayland."
homepage="https://github.com/hboetes/swaylock-effects"
maintainer="Vylen Linux Team"

name=swaylock-effects
version=1.8.1
release=1
source="${name}-${version}.tar.gz::https://github.com/hboetes/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dpam=enabled \
        -Dbash-completions="$(emerald is-installed bash-completions && printf "true" || printf "false")" \
        -Dfish-completions="$(emerald is-installed fish-completions && printf "true" || printf "false")" \
        -Dzsh-completions="$(emerald is-installed zsh-completions && printf "true" || printf "false")"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    # Adapt pam file to vylen
    sed -i 's|login|system-auth|' "${PKG}/etc/pam.d/swaylock"
}
