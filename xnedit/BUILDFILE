description="Modernized fork of NEdit with unicode support and AA text rendering "
homepage="https://sourceforge.net/projects/xnedit"
maintainer="Vylen Linux Team"

name=xnedit
version=1.6.3
release=1
source="$name-$version.tar.gz::https://github.com/unixwork/xnedit/archive/refs/tags/v$version.tar.gz"

build() {

	cd $name-$version
	make linux
	make DESTDIR=$PKG install
}
