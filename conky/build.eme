#!/bin/sh

# shellcheck disable=SC2034
description="Light-weight system monitor for X, Wayland, and other things, too"
homepage="https://github.com/brndnmtthws/conky"
maintainer="Vylen Linux Team"

name=conky
version=1.24.1
release=1
source="https://github.com/brndnmtthws/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DSYSTEM_CONFIG_FILE=/usr/etc/conky.conf \
        -DBUILD_DOCS=OFF \
        -DBUILD_WAYLAND="$(emerald is-installed wayland && printf "ON" || printf "OFF")" \
        -DBUILD_I18N=OFF \
        -DBUILD_CURL=ON \
        -DBUILD_RSS=ON \
        -DRELEASE=TRUE \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
