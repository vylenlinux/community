#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A user-friendly, lightweight TUI for disk imaging"
homepage="https://github.com/ifd3f/caligula"
maintainer="Vylen Linux Team"

name=caligula
version=0.5.0
release=1
source="https://github.com/ifd3f/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build --release
    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
