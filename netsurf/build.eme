#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight and fast web browser"
homepage="https://www.netsurf-browser.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=netsurf
version=3.11
release=1
source="${name}-${version}.tar.gz::https://download.netsurf-browser.org/${name}/releases/source-full/${name}-all-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-all-${version}"

    export CFLAGS="${CFLAGS} \
        -w \
        -Os \
        -funroll-loops"

    export PREFIX=/usr
    export LIBDIR=lib
    export INCLUDEDIR=include
    export NETSURF_GTK_MAJOR=3
    export TARGET=gtk3

    make
    make DESTDIR="${PKG}" install
}
