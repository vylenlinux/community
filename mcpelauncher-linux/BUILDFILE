#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Minecraft: Pocket Edition launcher for Linux"
maintainer="Vylen Linux Team"
homepage="https://github.com/minecraft-linux/mcpelauncher-manifest"

name=mcpelauncher-linux
version=1.7.1
release=1
source="${name%-linux}-manifest::git+https://github.com/minecraft-linux/mcpelauncher-manifest.git#tag=v${version}-qt6"

build() {
    git -C mcpelauncher-manifest submodule update --init --recursive

    CXXFLAGS="$(echo "${CXXFLAGS}" | sed 's/-Wp,-D_FORTIFY_SOURCE=3//g') -DNDEBUG -flto=thin"
    CFLAGS="${CFLAGS} -flto=thin"
    LDFLAGS="${LDFLAGS} -fuse-ld=lld"

    cmake -B build -S mcpelauncher-manifest -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_BUILD_TYPE=None \
        -DENABLE_DEV_PATHS=OFF \
        -DGAMEWINDOW_SYSTEM=SDL3 \
        -DSDL3_VENDORED=OFF \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
