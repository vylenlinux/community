#!/bin/sh

# shellcheck disable=SC2034
description="Perl script used for maintaining backwards compatibility with current desktop icon themes"
homepage="https://tango.freedesktop.org/"
maintainer="Vylen Linux Team"

name=icon-naming-utils
version=0.8.90
release=1
source="https://tango.freedesktop.org/releases/${name}-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --libexecdir="/usr/lib/${name}"

    make
    make DESTDIR="${PKG}" install
}
