description="Cross-platform C libraries that allow you to easily implement VNC server or client functionality"
homepage="https://libvnc.github.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libvncserver
version=0.9.15
release=1
source="$name-$version.tar.gz::https://github.com/LibVNC/libvncserver/archive/LibVNCServer-$version.tar.gz"

build() {
    cmake -S $name-LibVNCServer-$version -B build -G Ninja \
	-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
        -Wno-author
    cmake --build build
    DESTDIR=$PKG cmake --install build

}
