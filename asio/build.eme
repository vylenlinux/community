#!/bin/sh

# shellcheck disable=SC2034
description="cross-platform c++ library for asynchronous network i/o"
homepage="https://think-async.com/asio/"
maintainer="Vylen Linux Team"

name=asio
version=1.38.2
release=1
source="https://downloads.sourceforge.net/project/${name}/${name}/${version}%20%28Stable%29/${name}-${version}.zip"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --with-openssl

    make
    make DESTDIR="${PKG}" install
}
