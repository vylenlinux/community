#!/bin/sh

# shellcheck disable=SC2034
description="cross-platform c++ library for asynchronous network i/o"
homepage="http://think-async.com/Asio/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=asio
version=1.39.0
release=1

_version="$(printf '%s' "${version}" | tr '.' '-')"
source="${name}-${version}.tar.gz::https://github.com/chriskohlhoff/${name}/archive/refs/tags/${name}-${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${name}-${_version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --with-openssl

    make
    make DESTDIR="${PKG}" install
}
