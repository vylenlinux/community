description="cross-platform c++ library for asynchronous network i/o"
homepage="https://think-async.com/asio/"
maintainer="Vylen Linux Team"

name=asio
version=1.36.0
release=1
source="https://downloads.sourceforge.net/project/$name/$name/$version%20%28Stable%29/$name-$version.zip"

build() {
	cd $name-$version

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--with-openssl
	make
	make DESTDIR=$PKG install
}
