#!/usr/bin/env sh

# shellcheck disable=SC2034
description="An extremely fast Python package installer and resolver written in Rust"
maintainer="Vylen Linux Team"
homepage="https://github.com/astral-sh/uv" 

name=uv
version=0.11.3
release=1
source="${name}-${version}.tar.gz::https://github.com/astral-sh/uv/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo fetch --locked --target "$(rustc --print host-tuple)"
    tripple="$(rustc --print host-tuple)"

    # Note: do not use --all-features as in enables a self-updater
    maturin build --locked --release --target "${tripple}" --strip --compatibility linux
    maturin build --locked --release --target "${tripple}" --strip --compatibility linux -m crates/uv-build/Cargo.toml

    _target="target/$(rustc --print host-tuple)/release/uv"
    install -Dm0755 -t "${PKG}/usr/bin/" "${_target}"
    install -Dm0755 -t "${PKG}/usr/bin/" "${_target}x"
}
