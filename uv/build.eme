#!/bin/sh

# shellcheck disable=SC2034
description="An extremely fast Python package installer and resolver written in Rust"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/astral-sh/uv" 

name=uv
version=0.13.8
release=1
source="${name}-${version}.tar.gz::https://github.com/astral-sh/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cargo fetch --locked

    # Note: do not use --all-features as in enables a self-updater
    maturin build \
        --locked \
        --release \
        --strip \
        --compatibility linux

    maturin build \
        --locked \
        --release \
        --strip \
        --compatibility linux \
        -m crates/uv-build/Cargo.toml

    _target="target/x86_64-unknown-linux-gnu/release/${name}"

    install -Dm755 "${_target}" -t "${PKG}/usr/bin/"
    install -Dm755 "${_target}x" -t "${PKG}/usr/bin/"
}
