#!/bin/dash

# shellcheck disable=SC2034
description="An extremely fast Python package installer and resolver written in Rust"
maintainer="Vylen Linux Team"
homepage="https://github.com/astral-sh/uv" 

name=uv
version=0.11.21
release=1
source="${name}-${version}.tar.gz::https://github.com/astral-sh/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    tripple="$(rustc --print host-tuple)"

    cargo fetch \
        --locked \
        --target "${tripple}"

    # Note: do not use --all-features as in enables a self-updater
    maturin build \
        --locked \
        --release \
        --target "${tripple}" \
        --strip \
        --compatibility linux

    maturin build \
        --locked \
        --release \
        --target "${tripple}" \
        --strip \
        --compatibility linux \
        -m crates/uv-build/Cargo.toml

    _target="target/${tripple}/release/${name}"

    install -Dm0755 "${_target}"  -t "${PKG}/usr/bin/"
    install -Dm0755 "${_target}x" -t "${PKG}/usr/bin/"
}
