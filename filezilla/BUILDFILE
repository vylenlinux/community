description="Fast and reliable FTP, FTPS and SFTP client"
homepage="https://filezilla-project.org/"
maintainer="Vylen Linux Team"

name=filezilla
version=3.69.6
release=1
source="https://sources.archlinux.org/other/filezilla/$name-$version.tar.xz"

build() {
	cd $name-$version

	./configure \
	    --prefix=/usr \
	    --disable-manualupdatecheck \
	    --disable-autoupdatecheck \
	    --without-dbus \
	    --with-pugixml=builtin
	make
	make DESTDIR=$PKG install

}
