#!/bin/sh

# shellcheck disable=SC2034
description="Full-screen window manager that multiplexes a physical terminal"
homepage="https://www.gnu.org/software/screen/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=screen
version=5.0.3
release=1
backup="etc/screenrc"
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}/src"
    NOCONFIGURE=1 ./autogen.sh

    ./configure \
        --prefix=/usr \
        --infodir=/usr/share/info \
        --mandir=/usr/share/man \
        --with-socket-dir=/run/screen \
        --with-pty-group=5 \
        --with-sys-screenrc=/etc/screenrc

    sed "s%/usr/local/etc/screenrc%/etc/screenrc%" -i etc/*
    sed "s%/usr/local/etc/screenrc%/etc/screenrc%" -i doc/*

    make
    make DESTDIR="${PKG}" install

    do_pam "${name}"
    do_tmpfiles "${name}"

    chmod 755 "${PKG}/usr/bin/screen-${version}"
    install -Dm644 etc/etcscreenrc "${PKG}/etc/screenrc"
}
