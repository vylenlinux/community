#!/bin/sh

# shellcheck disable=SC2034
description="S* Floating Window Bar"
homepage="https://github.com/LBCrion/sfwbar"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sfwbar
version=1.0_beta17
release=1
source="${name}-${version}.tar.gz::https://github.com/LBCrion/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    export CFLAGS="${CFLAGS} -Wno-incompatible-pointer-types"
    export LDFLAGS="-Wl,-O1,--as-needed"

    vylen-meson "${name}-${version}" build -Db_lto=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    rm "${PKG}/usr/share/sfwbar/icons/weather/LICENSE"
}
