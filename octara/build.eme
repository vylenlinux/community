#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Just plays music, nothing more."
homepage="https://gitlab.com/octara/octara"
maintainer="CELESTIFYX Team <celestifyx@gmail.com>"

name=octara
version=1.0.3
release=1
source="https://gitlab.com/${name}/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    meson install -C build --destdir "${PKG}"
}
