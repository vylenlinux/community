#!/bin/sh

# shellcheck disable=SC2034
description="Efficient animated wallpaper daemon for wayland, controlled at runtime"
homepage="https://github.com/LGFae/swww"
maintainer="Vylen Linux Team"

name=swww
version=0.11.2
release=1
source="${name}-${version}.tar.gz::https://github.com/LGFae/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo fetch --locked
    cargo build --release

    install -Dm755 "target/release/${name}" "target/release/${name}-daemon" -t "${PKG}/usr/bin/"
}
