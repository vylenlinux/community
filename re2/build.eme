#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Fast, safe, thread-friendly regular expression engine"
homepage="https://github.com/google/re2"
maintainer="Vylen Linux Team"

name=re2
version=2025.11.05
release=2

_version=$(printf '%s' "${version}" | sed 's/\./-/g')
source="https://github.com/google/${name}/archive/${_version}/${name}-${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${_version}"

    make
    make prefix=/usr DESTDIR="${PKG}" install
}
