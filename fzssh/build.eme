#!/bin/sh

# shellcheck disable=SC2034
description="SSH/SFTP library based on libfilezilla"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://filezilla-project.org"

name=fzssh
version=1.5.0
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
