#!/usr/bin/env sh

# shellcheck disable=SC2034
description="SSH/SFTP library based on libfilezilla"
maintainer="Vylen Linux Team"
homepage="https://filezilla-project.org"

name=fzssh
version=1.3.0
release=1
source="https://sources.archlinux.org/other/packages/${name}/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
