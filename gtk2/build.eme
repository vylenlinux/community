#!/bin/sh

# shellcheck disable=SC2034
description="GObject-based multi-platform GUI toolkit (legacy)"
homepage="https://www.gtk.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=gtk2
version=2.24.33
release=1

source="${name}-${version}.tar.xz::https://ftp.gnome.org/pub/gnome/sources/gtk+/${version%.*}/gtk+-${version}.tar.xz
    gtkrc"

build() {
    # shellcheck disable=SC2164
    cd "gtk+-${version}"

    # fix build with GCC 14
    export CFLAGS="${CFLAGS} \
        -Wno-incompatible-pointer-types \
        -Wno-implicit-int"

    sed -e 's#l \(gtk-.*\).sgml#& -o \1#' -i docs/faq/Makefile.in
    sed -e 's#l \(gtk-.*\).sgml#& -o \1#' -i docs/tutorial/Makefile.in

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install

    rm "${PKG}/usr/bin/gtk-update-icon-cache"
    rm -r "${PKG}/usr/share/gtk-2.0"

    install -Dm644 "${SRC}/gtkrc" -t "${PKG}/etc/gtk-2.0/"
}
