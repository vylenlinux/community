#!/bin/sh

# shellcheck disable=SC2034
description="Vylen Java Version Manager (OpenJDK)"
homepage="https://vylen.gitlab.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=java-manager
version=1.0.0
release=1
source="${name}"

build() {
    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
}
