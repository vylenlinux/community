#!/bin/sh

# shellcheck disable=SC2034
description="A simple system information tool written in Python"
homepage="https://github.com/HorlogeSkynet/archey4"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=archey4
version=4.15.0.0
release=1
source="https://github.com/HorlogeSkynet/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
