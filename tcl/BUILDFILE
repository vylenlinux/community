description="Powerful, easy-to-learn dynamic programming language"
homepage="http://tcl.sourceforge.net/"
maintainer="Vylen Linux Team"

name=tcl
version=8.6.17
release=1
source="https://downloads.sourceforge.net/tcl/tcl$version-src.tar.gz"

build() {
	cd $name$version/unix

	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--without-tzdata
	make
	make INSTALL_ROOT=$PKG install install-private-headers

	ln -sv ${name}sh${version%.*} $PKG/usr/bin/${name}sh

	# conflict with perl
	rm $PKG/usr/share/man/man3/Thread.3
}
