#!/bin/sh

# shellcheck disable=SC2034
description="Dynamic, any to any, pixel format translation library"
homepage="https://gegl.org/babl/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=babl
version=0.1.128
release=1

_version="$(printf '%s' "${version}" | tr '.' '_')"
source="${name}-${version}.tar.gz::https://gitlab.gnome.org/GNOME/${name}/-/archive/BABL_${_version}/${name}-BABL_${_version}.tar.gz"

build() {
    vylen-meson "${name}-BABL_${_version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
