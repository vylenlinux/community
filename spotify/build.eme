#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A proprietary music streaming service"
homepage="https://www.spotify.com/"
maintainer="Vylen Linux Team"

name=spotify
version=1.2.90.451
release=1

commit=gb094aab0

source="${name}-${version}.deb::http://repository.spotify.com/pool/non-free/s/spotify-client/spotify-client_${version}.${commit}_amd64.deb
    ${name}"

build() {
    bsdtar -xf "${name}-${version}.deb"
    tar -xf data.tar.gz --no-same-owner -C "${PKG}"

    emerald isinstalled wayland-protocols && sed 's/Exec=spotify %U/Exec=dbus-launch spotify %U/' "${PKG}/usr/share/spotify/spotify.desktop"
    install -Dm644 "${PKG}/usr/share/spotify/spotify.desktop" "${PKG}/usr/share/applications/spotify.desktop"
    install -Dm644 "${PKG}/usr/share/spotify/icons/spotify-linux-512.png" "${PKG}/usr/share/pixmaps/spotify-client.png"

    for size in 22 24 32 48 64 128 256 512; do
        install -D "${PKG}/usr/share/spotify/icons/spotify-linux-${size}.png" "${PKG}/usr/share/icons/hicolor/${size}x${size}/apps/spotify.png"
    done
}
