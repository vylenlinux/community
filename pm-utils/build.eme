#!/bin/sh

# shellcheck disable=SC2034
description="Utilities and scripts for suspend and hibernate power management"
homepage="https://pm-utils.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pm-utils
version=1.4.1
release=1
source="https://pm-utils.freedesktop.org/releases/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install

    install -Dm644 man/*.1 -t "${PKG}/usr/share/man/man1/"
    install -Dm644 man/*.8 -t "${PKG}/usr/share/man/man8/"

    ln -sf pm-action.8 "${PKG}/usr/share/man/man8/pm-suspend.8"
    ln -sf pm-action.8 "${PKG}/usr/share/man/man8/pm-hibernate.8"
    ln -sf pm-action.8 "${PKG}/usr/share/man/man8/pm-suspend-hybrid.8"
}
