#!/bin/sh

# shellcheck disable=SC2034
description="Fast and lightweight web browser based on WebKit/GTK+"
homepage="https://github.com/fanglingsu/vimb"
maintainer="Vylen Linux Team"

name=vimb
version=4.0.0
release=1
source="https://github.com/fanglingsu/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make PREFIX=/usr
    make PREFIX=/usr DESTDIR="${PKG}" install
}
