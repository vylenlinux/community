#!/bin/sh

# shellcheck disable=SC2034
description="A wayland based logout menu"
homepage="https://github.com/ArtsyMacaw/wlogout"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wlogout
version=1.2.2
release=1
source="https://github.com/ArtsyMacaw/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
