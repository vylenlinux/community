#!/bin/sh

CONF=/etc/docker.conf
LOG=/var/log/docker.log

if [ -f "$CONF" ]; then
    . "$CONF"
else
    if [ -z "$OPTS" ]; then
        OPTS="-p /run/docker/pid -g docker"
    fi
fi

if [ ! -f "$LOG" ]; then
    touch "$LOG"

    chgrp docker "$LOG"
    chmod 640 "$LOG"
fi

/usr/bin/cgroupfs-mount
exec /usr/bin/dockerd $OPTS >> "$LOG" 2>&1
