#!/bin/sh

# shellcheck disable=SC2034
description="An open platform for distributed applications for developers and sysadmins"
homepage="https://www.docker.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=docker
version=29.9.2
release=1
backup="etc/${name}.conf"

source="https://github.com/moby/moby/archive/${name}-v${version}/moby-${version}.tar.gz
    https://github.com/${name}/cli/archive/v${version}/cli-${version}.tar.gz
    ${name}.conf"

build() {
    export GO111MODULE=auto
    export DOCKER_GITCOMMIT=0367cbe
    export DOCKER_BUILDTAGS=seccomp
    export DISABLE_WARN_OUTSIDE_CONTAINER=1

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    mkdir -p "src/github.com/${name}"

    # shellcheck disable=SC2164
    cd "src/github.com/${name}"
    ln -s "${SRC}/cli-${version}" cli

    # shellcheck disable=SC2164
    cd cli

    make VERSION="${version}" GITCOMMIT="${DOCKER_GITCOMMIT}" dynbinary
    make manpages

    install -Dm755 "build/${name}-linux-amd64" "${PKG}/usr/bin/${name}"

    install -dm755 "${PKG}/usr/share/man"
    cp -r man/man* -t "${PKG}/usr/share/man/"

    # shellcheck disable=SC2164
    cd "${SRC}/src/github.com/${name}"
    ln -s "${SRC}/moby-${name}-v${version}" "${name}"

    # shellcheck disable=SC2164
    cd "${name}"
    VERSION="${version}" hack/make.sh dynbinary

    install -Dm755 bundles/dynbinary-daemon/dockerd -t "${PKG}/usr/bin/"
    install -Dm755 "bundles/dynbinary-daemon/${name}-proxy" -t "${PKG}/usr/bin/"
    install -Dm644 "${SRC}/${name}.conf" -t "${PKG}/etc/"

    # symlink externally provided tini-static binary
    ln -sf tini "${PKG}/usr/bin/${name}-init"
    ln -s containerd "${PKG}/usr/bin/${name}-containerd"
    ln -s ctr "${PKG}/usr/bin/${name}-containerd-ctr"
    ln -s runc "${PKG}/usr/bin/${name}-runc"

    install -Dm755 contrib/check-config.sh -t "${PKG}/usr/share/${name}/"

    install -dm755 "${PKG}/usr/share/bash-completion/completions/" \
        "${PKG}/usr/share/zsh/site-functions/" \
        "${PKG}/usr/share/fish/vendor_completions.d/"

    "${PKG}/usr/bin/${name}" completion bash > "${PKG}/usr/share/bash-completion/completions/${name}"
    "${PKG}/usr/bin/${name}" completion zsh > "${PKG}/usr/share/zsh/site-functions/_${name}"
    "${PKG}/usr/bin/${name}" completion fish > "${PKG}/usr/share/fish/vendor_completions.d/${name}.fish"

    install -Dm644 "contrib/init/systemd/${name}.service" -t "${PKG}/usr/lib/systemd/system/"
    install -Dm644 "contrib/init/systemd/${name}.socket" -t "${PKG}/usr/lib/systemd/system/"

    do_sysusers "${name}"
}
