#!/usr/bin/env sh

# shellcheck disable=SC2034
description="An open platform for distributed applications for developers and sysadmins"
homepage="https://www.docker.com/"
maintainer="Vylen Linux Team"

name=docker
version=29.7.2
release=1
backup="etc/${name}.conf"

source="https://github.com/moby/moby/archive/${name}-v${version}/moby-${version}.tar.gz
    https://github.com/${name}/cli/archive/v${version}/cli-${version}.tar.gz
    ${name}.conf
    01-fix-ulimit-errors.patch"

build() {
    export GO111MODULE=auto
    export GOPATH="${SRC}"
    export DOCKER_GITCOMMIT=fbf3ed2
    export DOCKER_BUILDTAGS=seccomp
    export DISABLE_WARN_OUTSIDE_CONTAINER=1
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    mkdir -p src/github.com/docker

    # shellcheck disable=SC2164
    cd src/github.com/docker
    ln -s "${SRC}/cli-${version}" cli

    # shellcheck disable=SC2164
    cd cli
    make VERSION="${version}" GITCOMMIT="${DOCKER_GITCOMMIT}" dynbinary

    # shellcheck disable=SC2164
    cd "${SRC}/src/github.com/${name}"
    ln -s "${SRC}/moby-${name}-v${version}" "${name}"

    # shellcheck disable=SC2164
    cd "${name}"
    VERSION="${version}" hack/make.sh dynbinary

    install -Dm755 "build/${name}" -t "${PKG}/usr/bin/"
    install -Dm755 "bundles/dynbinary-daemon/dockerd" -t "${PKG}/usr/bin/"
    install -Dm755 "bundles/dynbinary-daemon/docker-proxy" -t "${PKG}/usr/bin/"
    install -Dm644 "${SRC}/${name}.conf" -t "${PKG}/etc/"

    # symlink externally provided tini-static binary
    ln -sf /sbin/tini "${PKG}/usr/bin/docker-init"
    ln -s containerd "${PKG}/usr/bin/docker-containerd"
    ln -s containerd-shim "${PKG}/usr/bin/docker-containerd-shim"
    ln -s ctr "${PKG}/usr/bin/docker-containerd-ctr"
    ln -s runc "${PKG}/usr/bin/docker-runc"

    install -Dm755 contrib/check-config.sh -t "${PKG}/usr/share/${name}/"
    install -Dm644 "contrib/completion/bash/${name}" -t "${PKG}/etc/bash_completion.d/"

    patch -Np1 -i "${SRC}/01-fix-ulimit-errors.patch"

    install -Dm644 "contrib/init/openrc/${name}.confd" "${PKG}/etc/conf.d/${name}"
    install -Dm755 "contrib/init/openrc/${name}.initd" "${PKG}/etc/init.d/${name}"
}
