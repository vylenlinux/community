#!/bin/sh

# shellcheck disable=SC2034
description="Temurin 25 (OpenJDK 25 Java binaries by Adoptium, formerly AdoptOpenJDK)"
homepage="https://github.com/adoptium/temurin27-binaries"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=openjdk-bin
version=27.0.1.0.2
release=1

_version="${version}+1"
source="${name}-${_version}.tar.gz::https://github.com/adoptium/temurin${version%%.*}-binaries/releases/download/jdk-${_version}/OpenJDK${version%%.*}U-jdk_x64_linux_hotspot_$(printf "%s" "${_version}" | sed 's/+/_/g').tar.gz"

build() {
    install -dm755 "${PKG}/usr/lib/jvm/java-${version%%+*}-openjdk"
    cp --reflink=auto -a "${SRC}/jdk-${_version}"/* "${PKG}/usr/lib/jvm/java-${version%%+*}-openjdk"

    VERSION="${version%%+*}" do_revdep
}
