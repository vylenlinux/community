#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Minecraft: PE Linux launcher UI"
maintainer="Vylen Linux Team"
homepage="https://github.com/minecraft-linux/mcpelauncher-ui-manifest"

name=mcpelauncher-ui
version=1.7.1
release=1
source="${name}-manifest::git+https://github.com/minecraft-linux/mcpelauncher-ui-manifest.git#tag=v${version}-qt6"

build() {
    # shellcheck disable=SC2164
    cd "${name}-manifest"
    git submodule update --init --recursive

    cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DLAUNCHER_VERSION_NAME="${version}" \
        -DLAUNCHER_VERSION_CODE="Vylen Linux (Community)" \
        -DLAUNCHER_VERSIONDB_URL="https://raw.githubusercontent.com/minecraft-linux/mcpelauncher-versiondb/v1.5.x" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    echo "StartUpWMClass=io.mrarm.mcpelauncher-ui-qt" >> "${PKG}/usr/share/applications/mcpelauncher-ui-qt.desktop"
    install -dm755 "${PKG}/usr/share/icons/hicolor/scalable/apps"
    mv "${PKG}/usr/share/pixmaps/mcpelauncher-ui-qt.svg" "${PKG}/usr/share/icons/hicolor/scalable/apps/io.mrarm.mcpelauncher-ui-qt.svg"
    rm -rf "${PKG}/usr/share/pixmaps"
    mv "${PKG}/usr/share/applications/mcpelauncher-ui-qt.desktop" "${PKG}/usr/share/applications/io.mrarm.mcpelauncher-ui-qt.desktop"
    sed -i 's/Icon=mcpelauncher-ui-qt/Icon=io.mrarm.mcpelauncher-ui-qt/g' "${PKG}/usr/share/applications/io.mrarm.mcpelauncher-ui-qt.desktop"
}
