#!/bin/sh

# shellcheck disable=SC2034
description="Console-based Audio Visualizer for ALSA"
homepage="https://github.com/karlstav/cava"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cava
version=1.0.0
release=1
source="https://github.com/karlstav/${name}/releases/download/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --localstatedir=/var

    make
    make DESTDIR="${PKG}" install
}
