#!/bin/sh

# shellcheck disable=SC2034
description="Extensible Python-based build utility"
homepage="https://scons.org/"
maintainer="Vylen Linux Team"

name=scons
version=4.11.1
release=1

source="https://github.com/${name}/${name}/archive/${version}/${name}-${version}.tar.gz
    https://downloads.sourceforge.net/project/${name}/${name}/${version}/SCons-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    sed -i 's/env python/&3/' SCons/Utilities/*.py
    sed -i 's:build/doc/man/::' setup.cfg

    python3 setup.py install \
        --prefix=/usr \
        --root="${PKG}" \
        --optimize=1 \
        --install-data=/usr/share/man/man1
}
