description="obs-studio plugin that allows you to screen capture on wlroots"
homepage="https://hg.sr.ht/~scoopta/wlrobs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wlrobs
version=1.2
release=1
source="$name-$version.tar.gz::https://hg.sr.ht/~scoopta/wlrobs/archive/v$version.tar.gz"

build() {
	vylen-meson ${name}-v$version build
	meson compile -C build
	mkdir -p ${PKG}/usr/lib/obs-plugins
	install -D -m 0644 build/libwlrobs.so ${PKG}/usr/lib/obs-plugins/${name}.so
}
