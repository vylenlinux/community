#!/bin/sh

# shellcheck disable=SC2034
description="Papirus icon theme (Light)"
homepage="https://github.com/PapirusDevelopmentTeam/papirus-icon-theme"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=papirus-icon-theme-light
version=20260801
release=1
source="https://github.com/PapirusDevelopmentTeam/${name%-light}/archive/${version}/${name%-light}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name%-light}-${version}"
    make DESTDIR="${PKG}" ICON_THEMES="Papirus-Light" install
}
