#!/bin/sh

# shellcheck disable=SC2034
description="Open Broadcaster Software Studio"
homepage="https://obsproject.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=obs-studio
version=33.0.1
release=1
source="https://github.com/obsproject/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    touch "${name}-${version}/plugins/obs-browser/CMakeLists.txt"
    touch "${name}-${version}/plugins/obs-websocket/CMakeLists.txt"

    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DENABLE_AJA=OFF \
        -DENABLE_DECKLINK=OFF \
        -DENABLE_LIBFDK=ON \
        -DENABLE_NEW_MPEGTS_OUTPUT=OFF \
        -DENABLE_PIPEWIRE=ON \
        -DENABLE_PULSEAUDIO=ON \
        -DENABLE_QSV11=OFF \
        -DMbedTLS_INCLUDE_DIR=/usr/include/mbedtls3 \
        -DMbedtls_LIBRARY=/usr/lib/mbedtls3/libmbedtls.so \
        -DMbedcrypto_LIBRARY=/usr/lib/mbedtls3/libmbedcrypto.so \
        -DMbedx509_LIBRARY=/usr/lib/mbedtls3/libmbedx509.so \
        -DENABLE_SCRIPTING_LUA="$(emerald is-installed luajit && printf "ON" || printf "OFF")" \
        -DENABLE_VLC=OFF \
        -DENABLE_VST=OFF \
        -DENABLE_WAYLAND="$(emerald is-installed wayland && printf "ON" || printf "OFF")" \
        -DENABLE_WEBRTC=OFF \
        -DOBS_VERSION_OVERRIDE="${version}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    find "${PKG}" -type d -exec chmod g-w '{}' \;
}
