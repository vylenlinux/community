#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Audio visualizer widget powered by CAVA for the KDE Plasma Desktop"
maintainer="Vylen Linux Team"
homepage="https://github.com/luisbocanegra/kurve"

name=plasma6-applets-kurve
version=3.5.1
release=1
source="${name}-${version}.tar.gz::https://github.com/luisbocanegra/kurve/archive/v${version}/kurve-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "kurve-${version}"
    python3 ./kpac i18n --no-merge

    cmake -B build \
        -DINSTALL_PLASMOID=ON \
        -DBUILD_PLUGIN=ON

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    chmod 755 "${PKG}/usr/share/plasma/plasmoids/luisbocanegra.audio.visualizer/contents/ui/tools/commandMonitor"
}
