#!/bin/sh

# shellcheck disable=SC2034
description="A unix pager optimized for psql"
homepage="https://github.com/okbob/pspg"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=pspg
version=5.9.1
release=1
source="${name}-${version}.tar.gz::https://github.com/okbob/${name}/archive/refs/tags/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./autogen.sh
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
