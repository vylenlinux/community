#!/bin/sh

# shellcheck disable=SC2034
description="Adjusts the color temperature of your screen according to your surroundings"
homepage="https://jonls.dk/redshift/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=redshift
version=1.12
release=1
source="https://github.com/sharpbracket/${name}/releases/download/v${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    autoreconf -fi
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
