#!/bin/sh

# shellcheck disable=SC2034
description="TCP/IP swiss army knife. OpenBSD variant."
homepage="https://salsa.debian.org/debian/netcat-openbsd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=openbsd-netcat
version=1.239_1
release=1

_version="$(printf '%s' "${version}" | tr '_' '-')"
source="${name}-${version}.tar.gz::https://salsa.debian.org/debian/netcat-openbsd/-/archive/debian/${_version}/netcat-openbsd-debian-${_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "netcat-openbsd-debian-${_version}"

    while read -r patch; do
        patch -Np1 -i "debian/patches/${patch}"
    done < debian/patches/series

    make \
        CFLAGS="${CFLAGS} -DDEBIAN_VERSION=\"\\\"${_version}\\\"\" -I/usr/include/libbsd" \
        LDFLAGS="${LDFLAGS} -lbsd"

    install -Dm755 nc -t "${PKG}/usr/bin/"
    install -Dm644 nc.1 -t "${PKG}/usr/share/man/man1/"
}
