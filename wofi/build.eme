#!/bin/sh

# shellcheck disable=SC2034
description="Rofi like application launcher written for wayland"
homepage="https://hg.sr.ht/~scoopta/wofi"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wofi
version=1.5.3
release=1
source="${name}-${version}.tar.gz::https://hg.sr.ht/~scoopta/${name}/archive/v${version}.tar.gz"

build() {
    vylen-meson "${name}-v${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
