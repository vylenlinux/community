#!/bin/sh

# shellcheck disable=SC2034
description="Next-Gen ls command"
homepage="https://github.com/lsd-rs/lsd"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=lsd
version=1.2.0
release=1
source="${name}-${version}.tar.gz::https://github.com/lsd-rs/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build --release
    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
