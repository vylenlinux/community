#!/bin/sh

# shellcheck disable=SC2034
description="Simple NUMA policy support"
homepage="https://github.com/numactl/numactl"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=numactl
version=2.0.19
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    NOCONFIGURE=1 ./autogen.sh
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install

    # conflict with man-pages package
    rm -rf "${PKG}/usr/share/man/man2/"
}
