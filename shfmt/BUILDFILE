#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A shell parser, formatter, and interpreter with bash support"
homepage="https://github.com/mvdan/sh"
maintainer="Vylen Linux Team"

name=shfmt
version=3.13.1
release=1
source="${name}-${version}.tar.gz::https://github.com/mvdan/sh/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "sh-${version}"
    go mod tidy

    go build -ldflags "-X main.version=${version}" -v ./cmd/shfmt
	install -Dm755 "${name}" -t "${PKG}/usr/bin/"
}
