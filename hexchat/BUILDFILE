description="IRC client based on XChat"
homepage="https://hexchat.github.io/"
maintainer="Vylen Linux Team"

name=hexchat
version=2.16.2
release=1
source="https://github.com/hexchat/hexchat/releases/download/v$version/$name-$version.tar.xz"

build() {
	vylen-meson $name-$version build \
		-Dwith-perl=false \
		-Dwith-lua=lua \
		-Dwith-sysinfo=false \
		-Dwith-python=python3-embed
	meson compile -C build
	DESTDIR="$PKG" meson install --no-rebuild -C build

}
