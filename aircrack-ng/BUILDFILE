description="Key cracker for the 802.11 WEP and WPA-PSK protocols"
homepage="https://www.aircrack-ng.org/"
maintainer="Vylen Linux Team"

name=aircrack-ng
version=1.7
release=1
source="$name-$version.tar.gz::https://github.com/aircrack-ng/aircrack-ng/archive/$version.tar.gz"

build() {
	cd $name-$version

	cat > which <<EOF
#!/bin/sh
type -p \$1
EOF

chmod +x which
export PATH=$PATH:$PWD

	CFLAGS="$CFLAGS -fcommon"

	./autogen.sh
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
