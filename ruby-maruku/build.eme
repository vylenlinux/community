description="Pure-Ruby Markdown-superset interpreter"
homepage="https://github.com/bhollis/maruku"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ruby-maruku
version=0.7.3
release=1
source="https://rubygems.org/downloads/${name#*-}-$version.gem"

build() {
	_gemdir="$(gem env gemdir)"

	gem install \
		--ignore-dependencies \
		--no-user-install \
		--no-document \
		-i "$PKG/$_gemdir" \
		-n "$PKG"/usr/bin \
		${name#*-}-$version.gem

	rm "$PKG/$_gemdir/cache/${name#*-}-$version.gem"
}
