#!/bin/sh

# shellcheck disable=SC2034
description="X.org Bitmap files"
homepage="https://www.x.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xbitmaps
version=1.1.4
release=1
source="http://ftp.x.org/pub/individual/data/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make DESTDIR="${PKG}" install
}
