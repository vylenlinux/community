#!/usr/bin/env sh

# shellcheck disable=SC2034
description="nwg-shell configuration utility"
homepage="https://github.com/nwg-piotr/nwg-shell-config"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nwg-shell-config
version=0.5.65
release=1

source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz
    vylenupdates
    add_support_for_emerald.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -p1 < "${SRC}/add_support_for_emerald.patch"

    python3 setup.py install \
        --root="${PKG}" \
        --optimize=1

    install -Dm644 nwg-shell-config.svg     -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 nwg-shell-update.svg     -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 nwg-shell-translate.svg  -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 nwg-update-noupdate.svg  -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 nwg-update-available.svg -t "${PKG}/usr/share/pixmaps/"
    install -Dm644 nwg-update-checking.svg  -t "${PKG}/usr/share/pixmaps/"
    install -Dm755 nwg-shell-config.desktop -t "${PKG}/usr/share/applications/"

    install -Dm755 nwg-system-update     -t "${PKG}/usr/bin/"
    install -Dm755 "${SRC}/vylenupdates" -t "${PKG}/usr/bin/"
}
