#!/bin/sh

# shellcheck disable=SC2034
description="nwg-shell configuration utility"
homepage="https://github.com/nwg-piotr/nwg-shell-config"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nwg-shell-config
version=0.5.65
release=1

source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz
    ${name}-add-support-for-vylen-linux.patch::https://patch-diff.githubusercontent.com/raw/nwg-piotr/nwg-shell-config/pull/96.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/${name}-add-support-for-vylen-linux.patch"

    python3 setup.py install \
        --root="${PKG}" \
        --optimize=1

    for pixmap in nwg-shell-config nwg-shell-update nwg-shell-translate nwg-update-noupdate nwg-update-available nwg-update-checking; do
        install -Dm644 "${pixmap}.svg" -t "${PKG}/usr/share/pixmaps/"
    done

    install -Dm755 nwg-shell-config.desktop -t "${PKG}/usr/share/applications/"
    install -Dm755 nwg-system-update vylenupdates -t "${PKG}/usr/bin/"
}
