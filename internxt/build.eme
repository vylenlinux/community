#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Internxt Drive client UI"
homepage="https://internxt.com/"
maintainer="Vylen Linux Team"

name=internxt
version=2.5.4
release=1
source="${name}-${version}.AppImage::https://github.com/internxt/drive-desktop-linux/releases/download/v${version}/Internxt-${version}.AppImage"

build() {
    chmod +x "${name}-${version}.AppImage"
    "./${name}-${version}.AppImage" --appimage-extract

    # Correct path for .desktop file
    sed -e "s/AppRun/${name}/g" -i "squashfs-root/${name}.desktop"

    install -d "${PKG}/opt/${name}"
    cp -a "squashfs-root/." "${PKG}/opt/${name}"
    chmod -R +rx "${PKG}/opt/${name}"

    install -d "${PKG}/usr/bin"
    ln -s "/opt/${name}/${name}" "${PKG}/usr/bin/${name}"

    install -d "${PKG}/usr/share"
    cp -r squashfs-root/usr/share/. "${PKG}/usr/share/"

    find "${PKG}" -type d -exec chmod 755 {} +
    install -Dm644 "squashfs-root/${name}.desktop" -t "${PKG}/usr/share/applications/"
}
