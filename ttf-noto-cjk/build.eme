#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Google Noto CJK fonts"
homepage="https://www.google.com/get/noto/"
maintainer="Vylen Linux Team"

name=ttf-noto-cjk
version=20240730
release=1
source="${name}-${version}.tar.zst::https://london.mirror.pkgbuild.com/extra/os/x86_64/noto-fonts-cjk-${version}-${release}-any.pkg.tar.zst"

build() {
    cp -r usr "${PKG}"
}
