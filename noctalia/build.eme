#!/bin/sh

# shellcheck disable=SC2034
description="A sleek and minimal desktop shell thoughtfully crafted for Wayland"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/noctalia-dev/noctalia"

name=noctalia
version=5.3.0
release=1
source="https://github.com/noctalia-dev/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Db_ndebug=true \
        -Dtests=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
