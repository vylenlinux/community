#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Blazing fast terminal-ui for git written in rust"
homepage="https://github.com/Extrawurst/gitui"
maintainer="Vylen Linux Team"

name=gitui
version=0.28.1
release=1
source="https://github.com/extrawurst/${name}/archive/v${version}/${name}-v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    export CARGO_HOME="${SOURCE_DIR}/cargo"

    cargo fetch --locked
    cargo build --frozen --no-default-features --features regex-onig --release

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
