#!/bin/sh

# shellcheck disable=SC2034
description="SANE drivers from Brother for compatible models"
homepage="http://support.brother.com"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=brother-brscan4
version=0.4.11_1
release=1

_version=$(printf "%s" "${version}" | sed 's/_/-/g')
source="${name}-${version}.rpm::https://download.brother.com/welcome/dlf105203/brscan4-${_version}.x86_64.rpm"

build() {
    for x in etc opt usr; do
        cp -r "${x}" -t "${PKG}"
    done

    mv "${PKG}/usr/lib64" "${PKG}/usr/lib"

    ln -sf libsane-brother4.so.1.0.7 "${PKG}/usr/lib/sane/libsane-brother4.so.1"
    ln -sf libsane-brother4.so.1 "${PKG}/usr/lib/sane/libsane-brother4.so"
}
