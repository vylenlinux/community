#!/bin/sh

add_brother_sane_backend() {
    # Add brother driver to sane configuration
    DLL_CONF=/etc/sane.d/dll.conf

    if [ "$(grep brother4 "${DLL_CONF}")" = '' ]; then
        printf "brother4\n" >> "${DLL_CONF}"
    fi
}

post_install() {
    add_brother_sane_backend

    printf "\n\nFor network users:\n"
    printf "Add network scanner entry\n"
    printf "    Command: brsaneconfig4 -a name=(name your device) model=(model name) ip=xx.xx.xx.xx\n"
    printf "Confirm network scanner entry\n"
    printf "    Command: brsaneconfig4 -q | grep (name of your device)\n"
    printf "Open a scanner application and try a test scan.\n"
}

post_upgrade() {
    add_brother_sane_backend
}
