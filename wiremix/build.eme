#!/bin/sh

# shellcheck disable=SC2034
description="A simple TUI audio mixer for PipeWire"
homepage="https://github.com/tsowell/wiremix"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wiremix
version=0.11.0
release=1
source="${name}-${version}.tar.gz::https://github.com/tsowell/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo fetch \
        --locked \
        --target "$(rustc -vV | sed -n 's/host: //p')"

    cargo build \
        --release \
        --frozen

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"
}
