description="A fast and easy-to-use status bar"
homepage="https://github.com/polybar/polybar"
maintainer="Vylen Linux Team"

name=polybar
version=3.7.2
release=1
source="https://github.com/$name/$name/releases/download/$version/$name-$version.tar.gz
polybar-3.7.2-fontconfig.patch
polybar-3.7.2-gcc15-cstdint-includes.patch"

build() {
	
	patch -d $name-$version -Np1 -i $SRC/polybar-3.7.2-fontconfig.patch

	patch -d $name-$version -Np1 -i $SRC/polybar-3.7.2-gcc15-cstdint-includes.patch

	cmake $name-$version -B build -G Ninja \
		 -DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-DCMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-DPYTHON_EXECUTABLE=/usr/bin/python3 \
		-Wno-dev
	 cmake --build build
	 DESTDIR=$PKG cmake --install build
}
