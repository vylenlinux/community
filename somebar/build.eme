#!/bin/sh

# shellcheck disable=SC2034
description="dwm-like bar for dwl"
homepage="https://sr.ht/~raphi/somebar/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=somebar
version=1.0.3
release=1

source="${name}-${version}.tar.gz::https://git.sr.ht/~raphi/${name}/archive/${version}.tar.gz
    config.hpp"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cp -f "${SRC}/config.hpp" -t src/

    vylen-meson build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
