#!/bin/sh

# shellcheck disable=SC2034
description="Mercury programming language compiler"
homepage="https://mercurylang.org/"
maintainer="Vylen Linux Team"

name=mercury
version=22.01.8
release=2

source="${name}-${version}.tar.gz::http://dl.mercurylang.org/release/${name}-srcdist-${version}.tar.gz
    https://github.com/Mercury-Language/${name}/commit/45cea0135630237dfab32489a9760ac2d65aba81.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-srcdist-${version}"
    patch -Np1 -i "${SRC}/45cea0135630237dfab32489a9760ac2d65aba81.patch"

    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --enable-shared-libs \
        --enable-libgrades="hlc.gc"

    make PARALLEL="${MAKEFLAGS}"

    make \
        DESTDIR="${PKG}" \
        INSTALL_PREFIX="${PKG}/usr" \
        INSTALL_MAN_DIR="${PKG}/usr/share/man" \
        INSTALL_INFO_DIR="${PKG}/usr/share/info" \
        MERCURY_COMPILER="${PKG}/usr/bin/mercury_compile" \
        MERCURY_CONFIG_DIR="${PKG}/usr/lib/mercury" \
        PARALLEL="${MAKEFLAGS}" \
    install

    rm "${PKG}/usr/lib/mercury/lib/hlc.gc"/libmer_*.a
    rm "${PKG}/usr/lib/mercury/lib/libgc.a"
    rm "${PKG}/usr/bin"/*.bat
}
