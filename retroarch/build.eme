#!/bin/sh

# shellcheck disable=SC2034
description="Reference frontend for the libretro API"
homepage="https://www.libretro.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=retroarch
version=1.22.2
release=2

source="https://github.com/libretro/${name}/archive/v${version}/${name}-${version}.tar.gz
    ffmpeg-9.patch"

build() {
    # shellcheck disable=SC2164
    cd "RetroArch-${version}"
    patch -Np1 -i "${SRC}/ffmpeg-9.patch"

    ./configure \
        --prefix=/usr \
        --enable-builtinmbedtls \
        --disable-builtinzlib \
        --disable-cg \
        --disable-jack \
        --disable-oss \
        --disable-sdl \
        --enable-dbus

    make
    make DESTDIR="${PKG}" install
}
