#!/bin/sh

# shellcheck disable=SC2034
description="A daemon to control runC"
homepage="https://containerd.io/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=containerd
version=2.4.2
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    export GO111MODULE=on

    export GOFLAGS="${GOFLAGS} \
        -modcacherw \
        -mod=readonly"

    make VERSION="v${version}" REVISION="b7a25261e029d68978bbf290df0a62fc819b3c51" BUILDMODE=pie
    install -Dm755 ./bin/* -t "${PKG}/usr/bin/"

    do_service "${name}"
}
