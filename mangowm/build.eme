#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight, high-performance Wayland compositor built on dwl"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://mangowm.github.io/"

name=mangowm
version=0.19.0
release=1

backup="etc/mango/config.conf
    etc/mango/config.toml"

source="https://github.com/${name}/mango/archive/refs/tags/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "mango-${version}" build -Dxwayland="$(emerald is-installed xwayland && printf "enabled" || printf "disabled")"
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
