#!/bin/sh

# shellcheck disable=SC2034
description="Portable bandwidth monitor and rate estimator"
homepage="https://github.com/Jafaral/bmon"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=bmon
version=5.0
release=1
source="https://github.com/tgraf/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-asound

    make
    make DESTDIR="${PKG}" install
}
