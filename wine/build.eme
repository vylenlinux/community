#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Implementation of Windows DLL's and core"
homepage="https://dl.winehq.org/wine"
maintainer="Vylen Linux Team"

name=wine
version=11.17
release=1
source="https://dl.winehq.org/${name}/source/${version%%.*}.x/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    mkdir build64
    # shellcheck disable=SC2164
    cd build64

    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --with-x \
        --with-wayland \
        --with-gstreamer \
        --with-freetype \
        --enable-win64 \
        --enable-archs=i386,x86_64 \
        --disable-tests \
        --enable-build-id

    make
    make DESTDIR="${PKG}" install

    # Exclude libraries for revdep
    do_revdep
}
