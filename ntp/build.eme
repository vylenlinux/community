#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Network Time Protocol reference implementation"
homepage="https://www.ntp.org/"
maintainer="Vylen Linux Team"

name=ntp
version=4.2.8p18
release=1

source="https://www.eecis.udel.edu/~${name}/${name}_spool/ntp4/${name}-${version%.*}/${name}-${version}.tar.gz
    fix.build.patch
    ${name}.conf"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export CFLAGS="${CFLAGS} \
        -Wno-incompatible-pointer-types \
        -Wno-int-conversion"

    patch -Np1 -i "${SRC}/fix.build.patch"

    sed -e 's/"(\\S+)"/"?([^\\s"]+)"?/' -i scripts/update-leap/update-leap.in
    # fix an issue introduced with glibc-2.34
    sed -e 's/#ifndef __sun/#if !defined(__sun) \&\& !defined(__GLIBC__)/' -i libntp/work_thread.c
    # fix glibc _Generic memchr conflict
    sed -i '/memchr(const void \*s, int c, size_t n)/d' include/l_stdlib.h

    autoreconf -fiv

    ./configure CFLAGS="${CFLAGS} -g -fPIC" \
        --prefix=/usr \
        --bindir=/usr/sbin \
        --sysconfdir=/etc \
        --libexecdir="/usr/lib/${name}" \
        --enable-linuxcaps \
        --with-lineeditlibs=readline

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.conf" -t "${PKG}/etc/"
    openrc_add ntp-client ntpd sntp
}
