#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Network Sniffer with nice GTK+ UI"
homepage="https://www.wireshark.org/"
maintainer="Vylen Linux Team"

name=wireshark
version=4.6.5
release=1
source="http://www.wireshark.org/download/src/all-versions/${name}-${version}.tar.xz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DENABLE_BCG729=OFF \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    # GID for wireshark is 150
    chgrp 150 "${PKG}/usr/bin/dumpcap"
    chmod 754 "${PKG}/usr/bin/dumpcap"
}
