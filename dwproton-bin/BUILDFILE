#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Proton builds with the latest Dawn Winery fixes for gacha games, based on Proton-CachyOS"
maintainer="Vylen Linux Team"
homepage="https://dawn.wine/dawn-winery/dwproton" 

name=dwproton-bin
version=10.0.22
release=1

srcver=10.0-22
source="https://dawn.wine/dawn-winery/dwproton/releases/download/dwproton-${srcver}/dwproton-${srcver}-x86_64.tar.xz"

build() {
    # Similar to how proton-ge-custom-bin worked
    sed -i -E 's/"dwproton-[^"]*"/"dwproton"/g' "${SRC}/dwproton-${srcver}-x86_64/compatibilitytool.vdf"

    install -d "$PKG/usr/share/steam/compatibilitytools.d/dwproton"
    mv "${SRC}/dwproton-${srcver}-x86_64"/* "${PKG}/usr/share/steam/compatibilitytools.d/dwproton"
}
