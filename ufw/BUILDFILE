description="Uncomplicated and easy to use CLI tool for managing a netfilter firewall"
homepage="https://launchpad.net/ufw"
maintainer="Vylen Linux Team"

name=ufw
version=0.36.2
release=1

backup="etc/ufw/before.rules
    etc/ufw/before6.rules
    etc/ufw/after.rules
    etc/ufw/after6.rules
    etc/ufw/ufw.conf
    etc/ufw/user.rules
    etc/ufw/sysctl.conf
    etc/ufw/user6.rules
    etc/default/ufw"

source="https://launchpad.net/$name/0.36/$version/+download/$name-$version.tar.gz
    finish.$name
    run.$name"

build() {
	cd $name-$version
	python3 ./setup.py build
	python3 ./setup.py install --root=$PKG

    install -Dm755 $SRC/run.$name $PKG/etc/sv/$name/run
	install -Dm755 $SRC/finish.$name $PKG/etc/sv/$name/finish

	ln -s /run/runit/supervise.$name $PKG/etc/sv/$name/supervise
}
