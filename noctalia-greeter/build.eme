#!/bin/sh

# shellcheck disable=SC2034
description="Minimal greetd greeter matching the look and feel of Noctalia Shell"
homepage="https://github.com/noctalia-dev/noctalia-greeter"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=noctalia-greeter
version=1.7.1
release=1
source="https://github.com/noctalia-dev/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
