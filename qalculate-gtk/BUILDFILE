description="GTK frontend for libqalculate"
homepage="https://qalculate.github.io/"
maintainer="Vylen Linux Team"

name=qalculate-gtk
version=5.9.0
release=1
source="$name-$version.tar.gz::https://github.com/Qalculate/qalculate-gtk/archive/refs/tags/v$version.tar.gz"

build() {
	cd $name-$version
	autoreconf -fvi
	./configure --prefix=/usr --libexecdir=/usr/lib
	make
	make DESTDIR=$PKG install
}
