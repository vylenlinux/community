#!/usr/bin/env sh

# shellcheck disable=SC2034
description="GTK frontend for libqalculate"
homepage="https://qalculate.github.io/"
maintainer="Vylen Linux Team"

name=qalculate-gtk
version=5.10.0
release=1
source="${name}-${version}.tar.gz::https://github.com/Qalculate/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    autoreconf -fvi

    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib

    make
    make DESTDIR="${PKG}" install
}
