#!/bin/sh

# shellcheck disable=SC2034
description="Typeface for developers, by JetBrains"
homepage="https://jetbrains.com/lp/mono"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-jetbrains-mono
version=2.304
release=1
source="${name}-${version}.tar.gz::https://github.com/JetBrains/JetBrainsMono/archive/refs/tags/v${version}.tar.gz"

build() {
    install -Dm644 "JetBrainsMono-${version}/fonts/ttf"/*.ttf -t "${PKG}/usr/share/fonts/TTF/"
}
