description="Ncurses bandwidth monitor"
homepage="https://github.com/causes-/nbwmon"
maintainer="Vylen Linux Team"

name=nbwmon
version=0.5.2
release=1
source="$name-$version.tar.gz::https://github.com/causes-/$name/archive/$version.tar.gz"

build() {
	cd $name-$version

	make
    	make DESTDIR=$PKG \
        	PREFIX=/usr \
        	install
}

