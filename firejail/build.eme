#!/bin/sh

# shellcheck disable=SC2034
description="Linux namespaces sandbox program"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/netblue30/firejail"

name=firejail
version=0.9.82
release=1
source="https://github.com/netblue30/${name}/releases/download/${version}/${name}-${version}.tar.xz"

backup="etc/${name}/login.users
    etc/${name}/${name}.config
    etc/${name}/firecfg.config
    etc/apparmor.d/local/${name}-default"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --enable-apparmor

    make
    make DESTDIR="${PKG}" install
}
