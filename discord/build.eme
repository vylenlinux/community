#!/bin/sh

# shellcheck disable=SC2034
description="All-in-one voice and text chat for gamers that's free and secure"
homepage="https://discordapp.com/"
maintainer="Vylen Linux Team"

name=discord
version=1.0.151
release=1
source="https://dl.discordapp.net/apps/linux/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd Discord

    install -Dm755 "${name}" -t "${PKG}/usr/bin/"
    install -Dm755 updater_bootstrap -t "${PKG}/usr/share/${name}/"
    install -Dm644 "${name}.desktop" -t "${PKG}/usr/share/applications/"
    install -Dm644 "${name}.png" -t "${PKG}/usr/share/icons/hicolor/256x256/apps/"
}
