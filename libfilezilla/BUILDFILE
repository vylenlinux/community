#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Small and modern C++ library, offering some basic functionality to build high-performing, platform-independent programs"
homepage="https://lib.filezilla-project.org/"
maintainer="Vylen Linux Team"

name=libfilezilla
version=0.55.1
release=1
source="https://sources.archlinux.org/other/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
