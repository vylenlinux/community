description="Small and modern C++ library, offering some basic functionality to build high-performing, platform-independent programs"
homepage="https://lib.filezilla-project.org/"
maintainer="Vylen Linux Team"

name=libfilezilla
version=0.54.1
release=1
source="https://sources.archlinux.org/other/libfilezilla/$name-$version.tar.xz"

build() {
	cd $name-$version
	./configure --prefix=/usr --disable-static
	make
	make DESTDIR=$PKG install
}
