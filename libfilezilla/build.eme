#!/bin/sh

# shellcheck disable=SC2034
description="Small and modern C++ library, offering some basic functionality to build high-performing, platform-independent programs"
homepage="https://lib.filezilla-project.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libfilezilla
version=0.58.0
release=1
source="https://downloads.sourceforge.net/project/vylen/sources/${name}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
