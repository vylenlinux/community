#!/bin/sh

# shellcheck disable=SC2034
description="Program for unpacking ms-tnef MIME attachment"
homepage="https://github.com/verdammelt/tnef"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=tnef
version=1.5.0
release=1
source="https://github.com/verdammelt/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    autoreconf
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
