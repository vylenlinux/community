description="Yet another remote desktop software, written in Rust. Works out of the box, no configuration required."
homepage="https://github.com/rustdesk/rustdesk"
maintainer="Vylen Linux Team"

name=rustdesk-bin
version=1.4.6
release=1
source="$name-$version.tar.zst::https://github.com/rustdesk/rustdesk/releases/download/$version/${name%-*}-$version-0-x86_64.pkg.tar.zst
	run.rustdesk"

build() {

    install -d "$PKG/usr/share/" "$PKG/usr/bin/" "$PKG/rc.d"
    cp -r "$SRC/usr/share/rustdesk/" "$PKG/usr/share/"
    cp -r "$SRC/usr/share/icons/" "$PKG/usr/share/"

    ln -s "/usr/share/rustdesk/rustdesk" "$PKG/usr/bin/rustdesk"

    install -Dm 644 "$SRC/usr/share/rustdesk/files/rustdesk.desktop" "$PKG/usr/share/applications/rustdesk.desktop"
    install -Dm 644 "$SRC/usr/share/rustdesk/files/rustdesk-link.desktop" "$PKG/usr/share/applications/rustdesk-link.desktop"

    install -Dm755 $SRC/run.rustdesk $PKG/etc/sv/rustdesk/run
	ln -s /run/runit/supervise.rustdesk $PKG/etc/sv/rustdesk/supervise

    # Remove useless files
    rm -r "$PKG/usr/share/rustdesk/files/"
}
