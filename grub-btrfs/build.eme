#!/bin/sh

# shellcheck disable=SC2034
description="Include btrfs snapshots in GRUB boot options"
homepage="https://github.com/Antynea/grub-btrfs"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=grub-btrfs
version=4.14
release=1
source="${name}-${version}.tar.gz::https://github.com/Antynea/${name}/archive/refs/tags/v${version}.tar.gz"
backup="etc/default/${name}/config"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    OPENRC=true make DESTDIR="${PKG}" install
}
