#!/usr/bin/env sh

# shellcheck disable=SC2034
description="QEMU guest agent"
homepage="https://www.qemu.org/"
maintainer="Vylen Linux Team"

name=qemu-guest-agent
version=11.1.1
release=1

source="https://download.qemu.org/qemu-${version}.tar.xz
    qemu-ga.conf"

build() {
    # shellcheck disable=SC2164
    cd "qemu-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --enable-guest-agent \
        --disable-docs

    make qemu-ga

    install -Dm755 build/qga/qemu-ga "${PKG}/usr/bin/qemu-ga"
    install -Dm644 "scripts/${name}/fsfreeze-hook" -t "${PKG}/etc/qemu/"
    install -Dm755 "${SRC}/qemu-ga.conf" -t "${PKG}/etc/qemu/"

    do_service "${name}"
}
