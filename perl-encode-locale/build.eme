#!/bin/sh

# shellcheck disable=SC2034
description="Determine the locale encoding"
homepage="https://search.cpan.org/dist/Encode-Locale"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-encode-locale
version=1.05
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/G/GA/GAAS/Encode-Locale-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Encode-Locale-${version}"
    perl -I. Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
