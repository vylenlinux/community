#!/bin/sh

# shellcheck disable=SC2034
description="Mesa demos and tools incl. glxinfo + glxgears"
homepage="https://www.mesa3d.org/"
maintainer="Vylen Linux Team"

name=mesa-demos
version=9.0.0
release=1
source="https://archive.mesa3d.org/demos/${name}-${version}.tar.xz"

build() {
    vylen-meson "${name}-${version}" build \
        -Dosmesa=disabled \
        -Dwayland="$(emerald is-installed wayland && printf "enabled" || printf "disabled")"

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    install -Dm755 build/src/xdemos/glxgears -t "${PKG}/usr/bin/"
    install -Dm755 build/src/xdemos/glxinfo -t "${PKG}/usr/bin/"
}
