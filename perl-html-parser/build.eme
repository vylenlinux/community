#!/bin/sh

# shellcheck disable=SC2034
description="Perl HTML parser class"
homepage="https://metacpan.org/dist/HTML-Parser"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-html-parser
version=3.85
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/O/OA/OALDERS/HTML-Parser-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "HTML-Parser-${version}"

    export OPTIMIZE="${CFLAGS}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
