#!/bin/sh

# shellcheck disable=SC2034
description="C-style arbitrary precision calculator"
homepage="http://www.isthe.com/chongo/tech/comp/calc/index.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=calc
version=2.17.0.2
release=1
source="${name}-${version}.tar.gz::https://github.com/lcn2/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    make clobber calc-dynamic-only BLD_TYPE=calc-dynamic-only PREFIX="${PKG}"
    make install T="${PKG}"
}
