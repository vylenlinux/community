#!/bin/sh

# shellcheck disable=SC2034
description="Perl Interface to the Domain Name System"
homepage="http://search.cpan.org/~nlnetlabs/Net-DNS/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-net-dns
version=1.57
release=1
source="${name}-${version}.tar.gz::http://search.cpan.org/CPAN/authors/id/N/NL/NLNETLABS/Net-DNS-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Net-DNS-${version}"

    perl Makefile.PL
    make OPTIMIZE="${CFLAGS}" DESTDIR="${PKG}" install
}
