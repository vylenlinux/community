#!/bin/sh

# shellcheck disable=SC2034
description="Steel Bank Common Lisp"
homepage="http://www.sbcl.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sbcl
version=2.6.10
release=1

source="${name}-${version}.tar.bz2::https://sourceforge.net/projects/${name}/files/${name}/${version}/${name}-${version}-source.tar.bz2
    https://sourceforge.net/projects/${name}/files/${name}/${version}/${name}-${version}-x86-64-linux-binary.tar.bz2
    fixes.lisp"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    export GNUMAKE="make"

    export CFLAGS="${CFLAGS} \
        -D_GNU_SOURCE \
        -fno-omit-frame-pointer \
        -DSBCL_HOME=/usr/lib/${name}"

    # build system uses LINKFLAGS and OS_LIBS to build LDFLAGS
    export LINKFLAGS="${LDFLAGS}"

    unset LDFLAGS \
        MAKEFLAGS

    sh make.sh "sh ../sbcl-*-linux/run-sbcl.sh \
        --no-sysinit \
        --no-userinit \
        --disable-debugger \
    " \
        --prefix=/usr \
        --without-sb-test \
        --with-sb-core-compression

    make -C ./doc/manual info

    # cannot have both SBCL_HOME and INSTALL_ROOT
    SBCL_HOME="" INSTALL_ROOT="${PKG}/usr" sh install.sh

    src/runtime/sbcl \
        --core output/sbcl.core \
        --script "${SRC}/fixes.lisp"

    mv sbcl-new.core "${PKG}/usr/lib/sbcl/sbcl.core"

    # sources
    mkdir -p "${PKG}/usr/share/sbcl-source"

    cp -R src -t "${PKG}/usr/share/sbcl-source/"
    cp -R contrib -t "${PKG}/usr/share/sbcl-source/"

    # drop unwanted files
    find "${PKG}" \( \
        -name Makefile -o \
        -name .cvsignore \
    \) -delete

    find "${PKG}/usr/share/sbcl-source" -type f \( \
        -name \*.fasl -o \
        -name \*.o -o \
        -name \*.log -o \
        -name \*.so -o \
        -name a.out \
    \) -delete

    rm -f "${PKG}/usr/share/sbcl-source/src/runtime/${name}"
}
