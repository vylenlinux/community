description="modern alternative to libpng"
homepage="https://github.com/randy408/libspng"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libspng
version=0.7.4
release=1
source="$name-$version.tar.gz::https://github.com/randy408/libspng/archive/refs/tags/v$version.tar.gz"

build() {
	vylen-meson $name-$version build \
	    -D build_examples=false		
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
