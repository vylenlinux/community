description="Google Chromium, sans integration with Google (portable ungoogled binary version)"
homepage="https://github.com/ungoogled-software/ungoogled-chromium"
maintainer="Vylen Linux Team"

name=ungoogled-chromium-bin
version=146.0.7680.80
build=1
arch="x86_64"
release=1
source="$name-$version-${build}.tar.zst::https://mirror1.artixlinux.org/repos/galaxy/os/${arch}/${name%-bin}-${version}-${build}-${arch}.pkg.tar.zst
	chromium.desktop"

build() {
	cp -R "${SRC}/usr/" "${PKG}/usr"

	chown root "$PKG/usr/lib/chromium/chrome-sandbox"
	chmod 4755 "$PKG/usr/lib/chromium/chrome-sandbox"

	# desktop
	install -d $PKG/usr/share/applications
	install -m644 $SRC/chromium.desktop $PKG/usr/share/applications/chromium
}

