#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Lightweight HTTP server and IMAP/POP3 proxy server"
homepage="http://nginx.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nginx
version=1.31.6
release=1

source="http://nginx.org/download/${name}-${version}.tar.gz
    ${name}.conf
    ${name}.service"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/etc/nginx \
        --sbin-path=/usr/bin/nginx \
        --conf-path=/etc/nginx/nginx.conf \
        --error-log-path=/var/log/nginx/error.log \
        --http-log-path=/var/log/nginx/access.log \
        --pid-path=/run/nginx.pid \
        --lock-path=/var/lock/nginx.pid \
        --with-http_ssl_module \
        --with-pcre \
        --user=nginx \
        --group=nginx

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.conf" -t "${PKG}/etc/nginx/"
    install -Dm644 "${SRC}/${name}.service" "${PKG}/usr/lib/systemd/system/"

    find "${PKG}/etc/nginx" -name "*.default" -delete
    rm -rf "${PKG}/run"
}
