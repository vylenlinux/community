#!/bin/sh

# shellcheck disable=SC2034
description="Lightweight HTTP server and IMAP/POP3 proxy server"
homepage="https://nginx.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nginx
version=1.31.8
release=1
source="https://nginx.org/download/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/etc/nginx \
        --sbin-path=/usr/bin/nginx \
        --conf-path=/etc/nginx/nginx.conf \
        --error-log-path=/var/log/nginx/error.log \
        --http-log-path=/var/log/nginx/access.log \
        --pid-path=/run/nginx.pid \
        --lock-path=/var/lock/nginx.pid \
        --with-http_ssl_module \
        --with-pcre \
        --user=http \
        --group=http

    make
    make DESTDIR="${PKG}" install

    sed \
        -e 's|\<user\s\+\w\+;|user http;|g' \
        -e '/^\s\+root/s|html|/usr/share/nginx/html|' \
        -e '/^events {/ i # Load all installed modules\ninclude modules.d/*.conf;\n' \
    -i "${PKG}/etc/nginx/nginx.conf"

    rm -f "${PKG}/etc/nginx"/*.default \
        "${PKG}/etc/nginx/mime.types"

    install -d "${PKG}/usr/share/nginx"
    mv "${PKG}/etc/nginx/html" -t "${PKG}/usr/share/nginx/"

    do_service "${name}"
}
