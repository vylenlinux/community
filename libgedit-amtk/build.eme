#!/bin/sh

# shellcheck disable=SC2034
description="Basic GTKUIManager replacement based on GAction"
homepage="https://gedit-technology.net/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libgedit-amtk
version=5.10.0
release=1
source="https://gitlab.gnome.org/World/gedit/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Dgtk_doc=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
