#!/bin/sh

# shellcheck disable=SC2034
description="GPUs process monitoring for AMD, Intel and NVIDIA"
homepage="https://github.com/Syllo/nvtop"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=nvtop
version=3.4.0
release=1
source="https://github.com/Syllo/${name}/archive/${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "${name}-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DAMDGPU_SUPPORT=ON \
        -DINTEL_SUPPORT=ON \
        -DMSM_SUPPORT=OFF \
        -DNVIDIA_SUPPORT=ON \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
