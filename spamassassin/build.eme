#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Mail filter to identify spam"
homepage="http://www.spamassassin.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=spamassassin
version=4.0.2
release=1

source="${name}-${version}.tar.bz2::https://www.apache.org/dist/${name}/source/Mail-SpamAssassin-${version}.tar.bz2
    ${name}.service
    ${name}.sysusers
    ${name}.tmpfiles
    ${name}-update.service
    ${name}-update.timer"

build() {
    # shellcheck disable=SC2164
    cd "Mail-SpamAssassin-${version}"

    export PERL_USE_UNSAFE_INC=1
    perl Makefile.PL CONFDIR="/etc/${name}"

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${SRC}/${name}.service" -t "${PKG}/usr/lib/systemd/system/"
    install -Dm644 "${SRC}/${name}-update.service" -t "${PKG}/usr/lib/systemd/system/"
    install -Dm644 "${SRC}/${name}-update.timer" -t "${PKG}/usr/lib/systemd/system/"

    install -Dm644 "${SRC}/${name}.sysusers" "${PKG}/usr/lib/sysusers.d/${name}.conf"
    install -Dm644 "${SRC}/${name}.tmpfiles" "${PKG}/usr/lib/tmpfiles.d/${name}.conf"
}
