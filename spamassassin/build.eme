#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Mail filter to identify spam"
homepage="http://www.spamassassin.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=spamassassin
version=4.0.2
release=1
source="${name}-${version}.tar.bz2::https://www.apache.org/dist/${name}/source/Mail-SpamAssassin-${version}.tar.bz2"

build() {
    # shellcheck disable=SC2164
    cd "Mail-SpamAssassin-${version}"

    export PERL_USE_UNSAFE_INC=1
    PERL_MM_USE_DEFAULT=1 perl Makefile.PL INSTALLDIRS=vendor CONFDIR="/etc/${name}"

    make
    make DESTDIR="${PKG}" install

    find "${PKG}/usr/lib" -depth \
        -type f \( -name .packlist -o -name \*.bs -o -name perllocal.pod \) -delete , \
        -type f -name autosplit.ix \( -exec grep -q '^[[:space:]]*package' {} \; -o -delete \) , \
        -type d -empty -exec rmdir {} +

    do_service spamd
}
