#!/bin/bash

exec 2>&1
install -d -m 755 -o spamd -g spamd /run/spamd || exit 1

exec /usr/bin/spamd --daemonize \
    --max-children=5 \
    --pidfile=/run/spamd.pid \
    --username=spamd \
    --groupname=spamd \
    --socketpath=/run/spamd.sock \
    --socketgroup=spamd \
    --socketmode=660 \
    --allow-tell \
    --create-prefs \
    --helper-home-dir \
    --paranoid
