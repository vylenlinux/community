#!/bin/sh

pre_install() {
    getent group spamd >/dev/null || groupadd -r spamd
    getent passwd spamd >/dev/null || useradd useradd -r -M -g spamd -G spamd -d /var/empty -s /usr/bin/nologin spamd

    passwd --lock spamd
}

post_remove() {
    getent passwd spamd >/dev/null && userdel spamd
    getent group spamd >/dev/null && groupdel spamd
}
