#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Yewtube, forked from mps-youtube, is a Terminal based YouTube player and downloader"
homepage="https://github.com/mps-youtube/yewtube"
maintainer="Vylen Linux Team"

name=mps-youtube
version=2.13.1
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/yewtube/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "yewtube-${version}"
    python3 setup.py install --root="${PKG}" --optimize=1
}
