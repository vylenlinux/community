#!/usr/bin/env sh

# shellcheck disable=SC2034
description="KDAB's helper class for single-instance policy applications"
homepage="https://github.com/KDAB/KDSingleApplication"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=kdsingleapplication
version=1.2.1
release=1
source="https://github.com/KDAB/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    cmake -S "KDSingleApplication-${version}" -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -DKDSingleApplication_QT6=ON \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
