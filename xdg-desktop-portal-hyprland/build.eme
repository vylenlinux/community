#!/usr/bin/env sh

# shellcheck disable=SC2034
description="xdg-desktop-portal backend for wlroots"
homepage="https://github.com/fufexan/xdg-desktop-portal-hyprland"
maintainer="Vylen Linux Team"

name=xdg-desktop-portal-hyprland
version=1.4.0
release=1

_protocol_version=4d29e48433270a2af06b8bc711ca1fe5109746cd

source="${name}-${version}.tar.gz::https://github.com/hyprwm/${name}/archive/v${version}/${name}-${version}.tar.gz
    https://github.com/hyprwm/hyprland-protocols/archive/${_protocol_version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}/subprojects"
        rm -rf hyprland-protocols sdbus-cpp
        ln -sfT "${SRC}/hyprland-protocols-${_protocol_version}" hyprland-protocols
    # shellcheck disable=SC2103
    cd ..

    cmake -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=/usr/lib \
        -DCMAKE_BUILD_TYPE=Release

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
