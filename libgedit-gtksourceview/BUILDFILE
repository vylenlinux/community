description="Library that extends GtkTextView"
homepage="https://gedit-technology.net"
maintainer="Vylen Linux Team"

name=libgedit-gtksourceview
version=299.6.0
release=1
source="https://gitlab.gnome.org/World/gedit/libgedit-gtksourceview/-/archive/$version/$name-$version.tar.gz"

build() {
	vylen-meson $name-$version build -Dgtk_doc=false
	meson compile -C build
	DESTDIR=$PKG meson install --no-rebuild -C build
}
