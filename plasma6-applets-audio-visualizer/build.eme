#!/bin/sh

# shellcheck disable=SC2034
description="Audio visualizer widget powered by CAVA for the KDE Plasma Desktop"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/luisbocanegra/plasma-audio-visualizer"

name=plasma6-applets-audio-visualizer
version=3.6.1
release=1
source="${name}-${version}.tar.gz::https://github.com/luisbocanegra/plasma-audio-visualizer/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "plasma-audio-visualizer-${version}"
    python3 ./kpac i18n --no-merge

    cmake -B build \
        -DINSTALL_PLASMOID=ON \
        -DBUILD_PLUGIN=ON

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    chmod 755 "${PKG}/usr/share/plasma/plasmoids/luisbocanegra.audio.visualizer/contents/ui/tools/commandMonitor"
}
