#!/bin/sh

# shellcheck disable=SC2034
description="Data tables useful in parsing HTML"
homepage="https://metacpan.org/pod/HTML::Tagset"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-html-tagset
version=3.24
release=1
source="${name}-${version}.tar.gz::https://www.cpan.org/authors/id/P/PE/PETDANCE/HTML-Tagset-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "HTML-Tagset-${version}"
    perl Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
