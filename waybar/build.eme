#!/bin/sh

# shellcheck disable=SC2034
description="Highly customizable Wayland bar for Sway and Wlroots based compositors"
homepage="https://github.com/Alexays/Waybar"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=waybar
version=0.15.0
release=1

backup="etc/xdg/${name}/config.jsonc
    etc/xdg/${name}/style.css"

source="${name}-${version}.tar.gz::https://github.com/Alexays/${name}/archive/${version}.tar.gz"

build() {
    vylen-meson "Waybar-${version}" build \
        -Dcpp_std=c++20 \
        -Dexperimental=true \
        -Dcava=disabled \
        -Dtests=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
