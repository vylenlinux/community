#!/bin/sh

# shellcheck disable=SC2034
description="Very resourcefriendly and feature-rich replacement for i3status, written in pure Rust"
homepage="https://github.com/greshake/i3status-rust"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=i3status-rust
version=0.40.1
release=1
source="${name}-${version}.tar.gz::https://github.com/greshake/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build \
        --release \
        --locked \
        --features "pipewire pulseaudio maildir"

    install -Dm755 target/release/i3status-rs -t "${PKG}/usr/bin/"

    install -Dm644 files/icons/*.toml -t "${PKG}/usr/share/${name}/icons/"
    install -Dm644 files/themes/*.toml -t "${PKG}/usr/share/${name}/themes/"
    install -Dm644 examples/*.toml -t "${PKG}/usr/share/doc/${name}/examples/"
}
