#!/bin/sh

# shellcheck disable=SC2034
description="Client for PPP+SSL VPN tunnel services"
homepage="https://github.com/adrienverge/openfortivpn"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=openfortivpn
version=1.24.1
release=1
source="${name}-${version}.tar.gz::https://github.com/adrienverge/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    NOCONFIGURE=1 ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install
}
