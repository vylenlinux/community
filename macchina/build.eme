#!/bin/sh

# shellcheck disable=SC2034
description="Fast, minimal and customizable system information frontend."
homepage="https://github.com/Macchina-CLI/macchina"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=macchina
version=6.4.0
release=1
source="${name}-${version}.tar.gz::https://github.com/Macchina-CLI/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    cargo build --release

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin/"

    install -Dm644 "doc/${name}.1" -t "${PKG}/usr/share/man/man1/"
    install -Dm644 "doc/${name}.7" -t "${PKG}/usr/share/man/man7/"
    install -Dm644 contrib/themes/* "${PKG}/usr/share/${name}/themes/"
}
