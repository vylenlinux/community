#!/usr/bin/env sh

# shellcheck disable=SC2034
description="The Private YouTube Client"
homepage="https://freetubeapp.io/"
maintainer="Vylen Linux Team"

name=freetube-bin
version=0.24.0
release=1
source="${name}-${version}.deb::https://github.com/FreeTubeApp/FreeTube/releases/download/v${version}-beta/${name}_${version}_beta_amd64.deb"

build() {
    bsdtar -xf "${name}-${version}.deb"
    bsdtar -xf data.tar.xz -C "${PKG}"
}
