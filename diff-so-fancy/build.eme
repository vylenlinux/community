#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Good-looking diffs"
homepage="https://github.com/so-fancy/diff-so-fancy"
maintainer="Vylen Linux Team"

name=diff-so-fancy
version=1.4.10
release=1
source="https://github.com/so-fancy/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    sed -i 's|^use lib .*$|use lib "/usr/share/diff-so-fancy";|g' diff-so-fancy

    install -Dm755 diff-so-fancy        -t "${PKG}/usr/bin/"
    install -Dm755 lib/DiffHighlight.pm -t "${PKG}/usr/share/diff-so-fancy/"
}
