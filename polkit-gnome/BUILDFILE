description="Legacy polkit authentication agent for GNOME"
homepage="https://gitlab.gnome.org/Archive/policykit-gnome"
maintainer="Vylen Linux Team"

name=polkit-gnome
version=0.105
release=1
source="https://download.gnome.org/sources/$name/$version/$name-$version.tar.xz"

build() {
	cd $name-$version
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var --libexecdir=/usr/lib/$name
	make
	make DESTDIR=$PKG install

install -d $PKG/etc/xdg/autostart
cat > $PKG/etc/xdg/autostart/polkit-gnome-authentication-agent-1.desktop << "EOF"
[Desktop Entry]
Name=PolicyKit Authentication Agent
Comment=PolicyKit Authentication Agent
Exec=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
Terminal=false
Type=Application
Categories=
NoDisplay=true
OnlyShowIn=GNOME;XFCE;Unity;
AutostartCondition=GNOME3 unless-session gnome
EOF


}
