#!/bin/sh

# shellcheck disable=SC2034
description="Download utility that supports HTTP(S), FTP, Bittorrent and MetaLink"
homepage="https://aria2.sourceforge.net"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=aria2
version=1.37.0
release=1

source="https://github.com/tatsuhiro-t/${name}/releases/download/release-${version}/${name}-${version}.tar.xz
    nettle-4.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    patch -Np1 -i "${SRC}/nettle-4.patch"

    ./configure \
        --prefix=/usr \
        --enable-libaria2 \
        --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt

    make
    make DESTDIR="${PKG}" install

    install -Dm644 "${PKG}/usr/share/doc/${name}/bash_completion/aria2c" -t "${PKG}/usr/share/bash-completions/completions/"
    rm -rf "${PKG}/usr/share/doc/${name}/bash_competion"
}
