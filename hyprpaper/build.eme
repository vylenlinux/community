#!/bin/sh

# shellcheck disable=SC2034
description="A blazing fast wayland wallpaper utility with IPC controls"
homepage="https://github.com/hyprwm/hyprpaper hyprgraphics"
maintainer="Vylen Linux Team"

name=hyprpaper
version=0.8.4
release=1
source="${name}-${version}.tar.gz::https://github.com/hyprwm/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cmake -B build \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-dev

    make protocols
    make -C build all

    install -Dm0755 "build/${name}" -t "${PKG}/usr/bin/"
}
