#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A highly customizable dynamic tiling Wayland compositor"
homepage="https://github.com/hyprwm/Hyprland"
maintainer="Vylen Linux Team"

name=hyprland
version=0.56.1
release=1

source="${name}-${version}.tar.gz::https://github.com/hyprwm/${name}/releases/download/v${version}/source-v${version}.tar.gz
    ${name}.desktop"

build() {
    rm -f hyprland-source/scripts/generateVersion.sh

    cmake -S hyprland-source -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build

    install -Dm644 "${SRC}/hyprland.desktop" -t "${PKG}/usr/share/wayland-sessions/"
    rm -f "${PKG}/usr/share/wayland-sessions/hyprland-systemd.desktop"

    rm -rf "${PKG}/usr/include/glaze" \
        "${PKG}/usr/share/glaze"
}
