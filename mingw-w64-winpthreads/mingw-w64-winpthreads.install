#!/bin/sh

ranlib_mingw_pthread() {
    cd /usr/i686-w64-mingw32/lib || return 1
    i686-w64-mingw32-ranlib libpthread.dll.a
}

pre_install() {
    # The port 'mingw-w64-gcc-base' is a temporary requirement to compile 'mingw-w64-winpthreads',
    # before 'mingw-w64-gcc' installation it will be removed
    emerald is-installed mingw-w64-gcc || \
        emerald is-installed mingw-w64-gcc-base || \
            emerald install -y mingw-w64-gcc-base
}

post_install() {
    ranlib_mingw_pthread
}

post_upgrade() {
    ranlib_mingw_pthread
}
