#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Collection of modular and reusable compiler and toolchain technologies"
maintainer="Vylen Linux Team"
homepage="https://www.opera.com/gx"

name=opera-gx
version=131.0.5877.111
release=1

_name="${name}-stable"

source="${name}-${version}.deb::https://get.opera.com/pub/opera_gx/${version}/linux/${_name}_${version}_amd64.deb
    opera
    default"

build() {
    sed -e "s/%name%/${name}/g" \
        -e "s/%binary%/${name}\/opera/g" \
        -i "${SRC}/opera"

    sed -e "s/%name%/${name}/g" -i "${SRC}/default"

    bsdtar -xf "${name}-${version}.deb" -C "${SRC}"
    tar -xf data.tar.xz --exclude=usr/share/lintian --exclude=usr/share/menu -C "${PKG}"

    libdir="${PKG}/usr/lib/"
    mv "${libdir}/"*-"linux-gnu/${_name}" "${libdir}"
    rm -rf "${libdir}/"*-linux-gnu

    chmod 4755 "${PKG}/usr/lib/${_name}/opera_sandbox"
    install -Dm644 "${SRC}/default" "${PKG}/etc/${name}/default"

    rm -f "${PKG}/usr/bin/${name}"
    install -Dm755 "${SRC}/opera" "${PKG}/usr/bin/${name}"
}
