#!/bin/sh

# shellcheck disable=SC2034
description="Library that eases the development of GtkSourceView-based text editors and IDEs"
homepage="https://github.com/gedit-technology/libgedit-tepl"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=libgedit-tepl
version=6.15.0
release=1
source="https://gitlab.gnome.org/World/gedit/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Db_lto=false \
        -Dgtk_doc=false

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
