#!/bin/sh

# shellcheck disable=SC2034
description="The ASP.NET Core targeting pack"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://www.microsoft.com/net/core"

name=aspnet-targeting-pack
version=10.0.401
release=1
source="dotnet-${version}.tar.gz::https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/dotnet-sdk-${version}-linux-x64.tar.gz"

build() {
    install -dm755 "${PKG}/usr/share/dotnet/packs"
    cp -dr --no-preserve=ownership packs/Microsoft.AspNetCore.App.Ref "${PKG}/usr/share/dotnet/packs/"
}
