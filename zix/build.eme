#!/bin/sh

# shellcheck disable=SC2034
description="A lightweight C library of portability wrappers and data structures"
homepage="https://github.com/drobilla/zix"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=zix
version=0.8.2
release=1
source="${name}-${version}.tar.gz::https://github.com/drobilla/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build \
        -Ddocs=disabled \
        -Dhtml=disabled \
        -Dtests=disabled \
        -Dtests_cpp=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
