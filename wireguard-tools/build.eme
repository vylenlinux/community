#!/bin/sh

# shellcheck disable=SC2034
description="Tools for configuring WireGuard"
homepage="https://www.wireguard.com/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wireguard-tools
version=1.0.20260223
release=1
source="https://git.zx2c4.com/${name}/snapshot/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}/src"
    make

    make install \
        DESTDIR="${PKG}" \
        PREFIX=/usr \
        RUNSTATEDIR=/run \
        WITH_BASHCOMPLETION="$(emerald is-installed bash-completion && printf "yes" || printf "no")" \
        WITH_SYSTEMDUNITS=yes \
        WITH_WGQUICK=yes
}
