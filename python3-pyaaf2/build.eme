#!/bin/sh

# shellcheck disable=SC2034
description="Read and write Advanced Authoring Format (AAF) files"
homepage="https://pyaaf.readthedocs.io/en/latest/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=python3-pyaaf2
version=1.7.1
release=1
source="${name}-${version}.tar.gz::https://github.com/markreidvfx/pyaaf2/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "pyaaf2-${version}"

    gpep517 build-wheel \
        --wheel-dir .dist \
        --output-fd 3 3>&1 >&2

    python3 -m installer -d "${PKG}" .dist/*.whl
}
