#!/bin/sh

# shellcheck disable=SC2034
description="Perl module date conversion routines"
homepage="https://metacpan.org/pod/HTTP::Date"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-http-date
version=6.08
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/O/OA/OALDERS/HTTP-Date-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "HTTP-Date-${version}"
    perl -I. Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
