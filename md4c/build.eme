#!/bin/sh

# shellcheck disable=SC2034
description="C Markdown parser"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/mity/md4c"

name=md4c
version=0.5.3
release=1
source="${name}-${version}.tar.gz::https://github.com/mity/${name}/archive/release-${version}.tar.gz"

build() {
    cmake -S "${name}-release-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -Wno-author

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
