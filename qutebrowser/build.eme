#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A keyboard-driven, vim-like browser based on PyQt5"
homepage="https://www.qutebrowser.org/:w"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=qutebrowser
version=3.7.0
release=1
source="https://github.com/${name}/${name}/releases/download/v${version}/${name}-${version}.tar.gz"

build() {
    # fix bsdtar extract error
    # 'Pathname can't be converted from UTF-8 to current locale.'
    export LC_ALL=en_US.utf-8

    # shellcheck disable=SC2164
    cd "${name}-${version}"
    make -f misc/Makefile DESTDIR="${PKG}" PREFIX=/usr install
}
