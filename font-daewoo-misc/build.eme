#!/bin/sh

# shellcheck disable=SC2034
description="X.org daewoo-misc fonts"
homepage="https://www.x.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=font-daewoo-misc
version=1.0.4
release=1
source="https://xorg.freedesktop.org/archive/individual/font/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
