#!/bin/sh

# shellcheck disable=SC2034
description="GTK3-based dock for Hyprland Wayland compositor"
homepage="https://github.com/nwg-piotr/nwg-dock-hyprland"
maintainer="Vylen Linux Team"

name=nwg-dock-hyprland
version=0.4.10
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export CGO_LDFLAGS="${LDFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export GOPATH="${SRC}/go"
    export PATH="${PATH}:${GOPATH}/bin"

    export GOFLAGS="-buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw"

    # shellcheck disable=SC2035
    go build -v -o "bin/${name}" *.go

    install -Dm644 images/* -t "${PKG}/usr/share/${name}/images/"
    install -Dm644 config/* -t "${PKG}/usr/share/${name}/"
    install -Dm755 "bin/${name}" -t "${PKG}/usr/bin"
}
