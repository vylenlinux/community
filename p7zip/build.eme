description="Command-line file archiver with high compression ratio"
homepage="https://github.com/p7zip-project/p7zip"
maintainer="Vylen Linux Team"

name=p7zip
version=17.06
release=1
source="$name-$version.tar.gz::https://github.com/p7zip-project/p7zip/archive/v${version}.tar.gz"

build() {
	cd $name-$version

	make OPTFLAGS="$CPPFLAGS $CFLAGS" 7z 7zr 7za
	make DEST_HOME=/usr \
	     DEST_MAN=/usr/share/man \
	     DEST_DIR=$PKG install

}
