#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Application drawer for sway and other wlroots-based compositors"
homepage="https://github.com/nwg-piotr/nwg-drawer"
maintainer="Vylen Linux Team"

name=nwg-drawer
version=0.7.5
release=1
source="${name}-${version}.tar.gz::https://github.com/nwg-piotr/${name}/archive/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    export CGO_LDFLAGS="${LDFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export GOPATH="${SRC}/go"
    export PATH="${PATH}:${GOPATH}/bin"

    export GOFLAGS="${GOFLAGS} \
        -buildmode=pie \
        -trimpath \
        -mod=readonly \
        -modcacherw \
        -ldflags=-linkmode=external"

    # shellcheck disable=SC2035
    go build -o "bin/${name}" *.go

    install -Dm644 desktop-directories/* -t "${PKG}/usr/share/${name}/desktop-directories/"
    install -Dm644 drawer.css -t "${PKG}/usr/share/${name}"
    install -Dm755 "bin/${name}" -t "${PKG}/usr/bin"
}
