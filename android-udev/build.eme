#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Udev rules to connect Android devices to your linux box"
homepage="https://github.com/M0Rf30/android-udev-rules"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=android-udev
version=20260922
release=1
source="${name}-${version}.zip::https://github.com/M0Rf30/${name}-rules/archive/${version}.zip"

build() {
    # shellcheck disable=SC2164
    cd "${name}-rules-${version}"
    install -Dm644 51-android.rules -t "${PKG}/etc/udev/rules.d/"
}
