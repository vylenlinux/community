description="drm is bullshit"
homepage="http://www.widevine.com/"
maintainer="Vylen Linux Team"

name=chromium-widevine
version=122.0.6261.69
release=1
source="https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_$version-1_amd64.deb"

build() {
    ar x google-chrome-stable_$version-1_amd64.deb
    bsdtar -x --strip-components 4 -f data.tar.xz opt/google/chrome/WidevineCdm
    install -dm755 $PKG/usr/lib/chromium/
    cp -a WidevineCdm $PKG/usr/lib/chromium/
    find $PKG -name '*.so' -exec chmod +x {} \;
    ln -s WidevineCdm/_platform_specific/linux_x64/libwidevinecdm.so \
    $PKG/usr/lib/chromium/libwidevinecdm.so

  }
