#!/bin/sh

# shellcheck disable=SC2034
description="The .NET Core runtime"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://www.microsoft.com/net/core"

name=dotnet-sdk
version=10.0.401
release=1
source="dotnet-${version}.tar.gz::https://builds.dotnet.microsoft.com/dotnet/Sdk/${version}/${name}-${version}-linux-x64.tar.gz"

build() {
    install -dm755 "${PKG}/usr/share/dotnet"
    cp -dr --no-preserve=ownership sdk sdk-manifests templates "${PKG}/usr/share/dotnet/"
}
