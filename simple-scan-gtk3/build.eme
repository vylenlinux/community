#!/bin/sh

# shellcheck disable=SC2034
description="Simple Scanning Utility (GTK3 version)"
homepage="https://github.com/GNOME/simple-scan"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=simple-scan-gtk3
version=46.0
release=1
source="${name}-${version}.tar.xz::https://github.com/GNOME/simple-scan/archive/refs/tags/${version}.tar.gz"

build() {
    vylen-meson "simple-scan-${version}" build
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
