#!/bin/sh

# shellcheck disable=SC2034
description="Fast, reliable, and secure dependency management - Active development trunk"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://github.com/yarnpkg/berry"

name=yarn-berry
version=4.18.0
release=1
source="${name}-${version}.tar.gz::https://github.com/yarnpkg/berry/archive/refs/tags/@yarnpkg/cli/${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "berry--yarnpkg-cli-${version}"
    install -dm755 "${PKG}/usr/lib/node_modules/yarn"

    # shellcheck disable=SC2035
    cp -R * -t "${PKG}/usr/lib/node_modules/yarn/"
    chmod +x "${PKG}/usr/lib/node_modules/yarn/packages/yarnpkg-cli/bin/yarn.js"

    install -dm755 "${PKG}/usr/bin"
    ln -s /usr/lib/node_modules/yarn/packages/yarnpkg-cli/bin/yarn.js "${PKG}/usr/bin/yarn"
    ln -s /usr/lib/node_modules/yarn/packages/yarnpkg-cli/bin/yarn.js "${PKG}/usr/bin/yarnpkg"
}
