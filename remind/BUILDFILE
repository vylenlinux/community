description="Sophisticated calendar and alarm program"
homepage="https://dianne.skoll.ca/projects/remind/"
maintainer="Vylen Linux Team"

name=remind
version=06.02.05
release=1
source="$name-$version.tar.gz::https://dianne.skoll.ca/projects/$name/download/$name-$version.tar.gz"


build() {
	cd $name-$version
	./configure
	sed -i 's|prefix=/usr/local|prefix=/usr|' src/Makefile

	make  DESTDIR=$PKG install
}
