#!/bin/sh

# shellcheck disable=SC2034
description="Wine's built-in replacement for Microsoft's .NET Framework"
homepage="https://github.com/madewokherd/wine-mono"
maintainer="Vylen Linux Team"

name=wine-mono
version=11.3.0
release=1
source="${name}-${version}.msi::https://github.com/madewokherd/${name}/releases/download/${name}-${version}/${name}-${version}-x86.msi"

build() {
    install -Dm644 "${name}-${version}.msi" -t "${PKG}/usr/share/wine/mono/"
}
