#!/bin/sh

# shellcheck disable=SC2034
description="Wine's built-in replacement for Microsoft's .NET Framework"
homepage="https://github.com/wine-mono/wine-mono"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=wine-mono
version=11.3.0
release=1
source="${name}-${version}.tar.xz::https://dl.winehq.org/wine/${name}/${version}/${name}-${version}-x86.tar.xz"

build() {
    install -dm755 "${PKG}/usr/share/wine/mono"
    cp -r -a --no-preserve=ownership "${name}-${version}" -t "${PKG}/usr/share/wine/mono/"
}
