#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Tool to display AMDGPU usage"
homepage="https://github.com/Umio-Yasuno/amdgpu_top"
maintainer="Vylen Linux Team"

name=amdgpu_top
version=0.11.5
release=1
source="https://github.com/Umio-Yasuno/${name}/archive/v${version}/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    cargo build \
        --release \
        --features="tui" \
        --manifest-path

    install -Dm755 "target/release/${name}" -t "${PKG}/usr/bin"
    install -Dm644 assets/amdgpu_top.desktop -t "${PKG}/usr/share/applications/"
    install -Dm644 assets/amdgpu_top-tui.desktop -t "${PKG}/usr/share/applications/"
}
