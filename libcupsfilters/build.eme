#!/bin/sh

# shellcheck disable=SC2034
description="Code of the filters of the former cups-filters package as library functions"
homepage="https://github.com/OpenPrinting/libcupsfilters"
maintainer="Vylen Linux Team"

name=libcupsfilters
version=2.2.1
release=1
source="https://github.com/OpenPrinting/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    emerald is-installed dbus || OPTDBUS='--disable-dbus'
    emerald is-installed libexif || OPTEXIF='--disable-exif'
    emerald is-installed mupdf || OPTMUP='--disable-mutool'

    ./configure \
        --prefix=/usr \
        "${OPTDBUS}" \
        "${OPTEXIF}" \
        "${OPTMUP}"

    make
    make DESTDIR="${PKG}" install
}
