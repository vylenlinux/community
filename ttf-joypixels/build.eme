#!/bin/sh

# shellcheck disable=SC2034
description="Emoji as a Service (formerly EmojiOne)"
homepage="https://app.joypixels.com/files"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-joypixels
version=11.0.0
release=1
source="${name}-${version}.ttf::https://cdn.joypixels.com/distributions/gentoo-linux/font/${version}/joypixels-android.ttf"

build() {
    install -Dm644 "${SRC}/${name}-${version}.ttf" "${PKG}/usr/share/fonts/joypixels/JoyPixels.ttf"
}
