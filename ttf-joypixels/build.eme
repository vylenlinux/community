description="Emoji as a Service (formerly EmojiOne) "
homepage="https://www.joypixels.com/download"
maintainer="Vylen Linux Team"

name=ttf-joypixels
version=10.0.0
release=1
source="https://cdn.joypixels.com/distributions/gentoo-linux/font/${version}/joypixels-android.ttf"
build() {
	install -Dm644 "joypixels-android.ttf" "${PKG}/usr/share/fonts/${name#ttf-}/JoyPixels.ttf"
}
