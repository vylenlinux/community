#!/bin/sh

# shellcheck disable=SC2034
description="Point and click selection of X11 font names"
homepage="https://xorg.freedesktop.org"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xfontsel
version=1.1.2
release=1
source="https://xorg.freedesktop.org/archive/individual/app/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
