#!/bin/sh

# shellcheck disable=SC2034
description="Binary plugin for HPs hplip printer driver library"
homepage="https://developers.hp.com/hp-linux-imaging-and-printing/binary_plugin.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=hplip-plugin
version=3.26.4
release=1

source="${name}-${version}.run::https://www.openprinting.org/download/printdriver/auxfiles/HP/plugins/${name%-*}-${version}-plugin.run
    hplip.state"

backup="var/lib/hp/hplip.state"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"
    sh "${name}-${version}.run" --target . --noexec

    install -Dm644 plugin.spec -t "${PKG}/usr/share/hplip/"
    install -Dm644 hp_laserjet_*.fw.gz -t "${PKG}/usr/share/hplip/data/firmware/"
    install -Dm755 fax_marvell-x86_64.so -t "${PKG}/usr/share/hplip/fax/plugins/"
    install -Dm755 hbpl1-x86_64.so -t "${PKG}/usr/share/hplip/prnt/plugins/"
    install -Dm755 lj-x86_64.so -t "${PKG}/usr/share/hplip/prnt/plugins/"
    install -Dm755 bb_*-x86_64.so -t "${PKG}/usr/share/hplip/scan/plugins/"

    sed -i "s/%version%/${version}/g" "${SRC}/hplip.state"
    install -Dm644 "${SRC}/hplip.state" -t "${PKG}/var/lib/hp/"

    # Create symlinks
    find "${PKG}/usr/share/hplip" -type f -name "*.so" | while read -r f; do
        lib_dir="${f%/*}"
        lib_name="${f##*/}"

        ln -sf "${lib_name}" "${lib_dir}/${lib_name%%-*}.so"
    done
}
