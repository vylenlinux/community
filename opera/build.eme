#!/usr/bin/env sh

# shellcheck disable=SC2034
description="A fast and secure web browser"
homepage="https://www.opera.com/"
maintainer="Vylen Linux Team"

name=opera
version=131.0.5877.74
release=1

_name="${name}-stable"
ffmpeg_ver=0.82.0

source="${name}-${version}.deb::https://download3.operacdn.com/pub/${name}/desktop/${version}/linux/${_name}_${version}_amd64.deb
    https://github.com/nwjs-ffmpeg-prebuilt/nwjs-ffmpeg-prebuilt/releases/download/${ffmpeg_ver}/${ffmpeg_ver}-linux-x64.zip
    ${name}
    default"

build() {
    sed -e "s/%name%/${name}/g" -i "${SRC}/${name}"
    sed -e "s/%operabin%/${name}\/${name}/g" -i "${SRC}/${name}"

    bsdtar -xf "${name}-${version}.deb"
    tar xf data.tar.xz -C "${PKG}"

    rm -r "${PKG}/usr/share/lintian" "${PKG}/usr/share/menu"

    mv "${PKG}/usr/lib"/*-"linux-gnu/${_name}" "${PKG}/usr/lib"
    rm -r "${PKG}/usr/lib"/*-linux-gnu

    # suid opera_sandbox
    chmod 4755 "${PKG}/usr/lib/${_name}/opera_sandbox"

    # install default options
    install -Dm644 "${SRC}/default" "${PKG}/etc/opera/default"

    # install opera wrapper
    rm "${PKG}/usr/bin/opera"
    install -Dm755 "${SRC}/opera" -t "${PKG}/usr/bin/"

    # support propietary codecs
    install -Dm644 "${SRC}/libffmpeg.so" -t "${PKG}/usr/lib/opera/"
}
