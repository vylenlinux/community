#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Vulkan and OpenGL overlay for monitoring FPS, temperatures, CPU/GPU load and more"
homepage="https://github.com/flightlessmango/MangoHud"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=mangohud
version=0.8.4
release=1
source="${name}-${version}.tar.xz::https://github.com/flightlessmango/${name}/releases/download/v${version}/MangoHud-v${version}-Source.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "MangoHud-v${version}"

    # Use system cmocka instead of subproject
    sed -i "s/  cmocka = subproject('cmocka')//g" meson.build
    sed -i "s/cmocka_dep = cmocka.get_variable('cmocka_dep')/cmocka_dep = dependency('cmocka')/g" meson.build

    vylen-meson build \
        -Dappend_libdir_mangohud=false \
        -Dimgui:glfw=enabled \
        -Dimgui:opengl=enabled \
        -Dimgui:sdl2=enabled \
        -Dimgui:vulkan=enabled \
        -Dmangoapp=true \
        -Dmangohudctl=true \
        -Dtests=disabled \
        -Dwith_dbus=enabled \
        -Dwith_wayland=enabled \
        -Dwith_xnvctrl=disabled

    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build
}
