#!/bin/sh

# shellcheck disable=SC2034
description="A framework for managing DNS information"
homepage="https://roy.marples.name/projects/openresolv"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=openresolv
version=3.17.4
release=2
source="${name}-${version}.tar.gz::https://github.com/NetworkConfiguration/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libexecdir=/usr/lib/resolvconf \
        --mandir=/usr/share/man \
        --rundir=/run \
        --sysconfdir=/etc

    make
    make DESTDIR="${PKG}" install
}
