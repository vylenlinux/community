#!/bin/sh

# shellcheck disable=SC2034
description="The sysstat package contains various utilities, common to many commercial Unixes, to monitor system performance and usage activity"
homepage="https://sysstat.github.io"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sysstat
version=12.8.1
release=1
source="${name}-${version}.tar.gz::https://github.com/${name}/${name}/archive/refs/tags/v${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --disable-file-attr \
        --disable-compress-manpg \
        --enable-copy-only \
        \
        conf_dir="/etc/${name}"

    make
    make DESTDIR="${PKG}" SA_LIB_DIR=/usr/lib/sa install
}
