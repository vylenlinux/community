description="The sysstat package contains various utilities, common to many commercial Unixes, to monitor system performance and usage activity"
homepage="https://sysstat.github.io"
maintainer="Vylen Linux Team"

name=sysstat
version=12.7.9
release=1
source="https://sysstat.github.io/sysstat-packages/$name-$version.tar.gz"

build() {
	cd $name-$version
	./configure --prefix=/usr
	make
	make DESTDIR=$PKG install
}
