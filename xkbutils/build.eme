#!/bin/sh

# shellcheck disable=SC2034
description="XKB utility demos"
homepage="https://xorg.freedesktop.org"
maintainer="Vylen Linux Team"

name=xkbutils
version=1.0.7
release=1
source="http://ftp.x.org/pub/individual/app/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
