description="XKB utility demos"
homepage="https://xorg.freedesktop.org"
maintainer="Vylen Linux Team"

name=xkbutils
version=1.0.6
release=1
source="http://ftp.x.org/pub/individual/app/xkbutils-$version.tar.xz"

build() {
	cd $name-$version

  	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static
	make
	make DESTDIR=$PKG install
}

