#!/bin/sh

# shellcheck disable=SC2034
description="SOcket CAT - netcat-like utility with many enhancements"
homepage="http://www.dest-unreach.org/socat"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=socat
version=1.8.1.3
release=2

source="http://www.dest-unreach.org/${name}/download/${name}-${version}.tar.gz
    ${name}-${version}-openssl4_fixes-1.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    patch -Np1 -i "${SRC}/${name}-${version}-openssl4_fixes-1.patch"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
