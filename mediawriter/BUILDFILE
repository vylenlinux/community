#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Fedora Media Writer - Write Fedora Images to Portable Media"
homepage="https://github.com/FedoraQt/MediaWriter"
maintainer="Vylen Linux Team"

name=mediawriter
version=5.3.1
release=1
source="${name}-${version}.tar.gz::https://github.com/FedoraQt/${name}/archive/${version}.tar.gz"

build() {
    cmake -S "MediaWriter-${version}" -B build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_FLAGS_RELEASE="${CFLAGS}" \
        -DCMAKE_CXX_FLAGS_RELEASE="${CXXFLAGS}" \
        -Wno-dev

    cmake --build build
    DESTDIR="${PKG}" cmake --install build
}
