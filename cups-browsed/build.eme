#!/bin/sh

# shellcheck disable=SC2034
description="Helper daemon to browse the network for remote CUPS queues and IPP network printers"
homepage="https://github.com/OpenPrinting/cups-browsed"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=cups-browsed
version=2.1.1
release=1
source="https://github.com/OpenPrinting/${name}/releases/download/${version}/${name}-${version}.tar.xz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    # disable avahi
    emerald is-installed avahi || OPTS="--disable-avahi"

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --sysconfdir=/etc \
        --runstatedir=/run \
        --with-cups-rundir=/run/cups \
        --without-rcdir \
        "${OPTS}"

    make
    make DESTDIR="${PKG}" install

    do_service "${name}"
}
