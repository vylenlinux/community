#!/usr/bin/env sh

# shellcheck disable=SC2034
description="Recursively copy Perl datatypes"
homepage="https://github.com/garu/Clone"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=perl-clone
version=0.51
release=1
source="${name}-${version}.tar.gz::https://cpan.metacpan.org/authors/id/A/AT/ATOOMIC/Clone-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "Clone-${version}"
    perl -I. Makefile.PL

    make
    make DESTDIR="${PKG}" install
}
