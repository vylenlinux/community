#!/bin/sh

# shellcheck disable=SC2034
description="Foomatic - Foomatic's database engine generates PPD files from the data in Foomatic's XML database."
homepage="http://www.linuxprinting.org/foomatic.html"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=foomatic-db-engine
version=4.0.13
release=1

commit=e4e7b9cd28ba160428f82bc5234559d1f50e5c42

source="${name}-${version}.tar.gz::https://github.com/OpenPrinting/${name}/archive/${commit}.tar.gz
    defaultspooler"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${commit}"

    export LIB_CUPS=/usr/lib/cups
    ./make_configure

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin

    make
    make DESTDIR="${PKG}" install

    # preset default spooler
    install -Dm644 "${SRC}/defaultspooler" -t "${PKG}/etc/foomatic/"

    # add some docs
    install -Dm644 USAGE -t "${PKG}/usr/share/doc/${name}/"
    install -Dm644 README -t "${PKG}/usr/share/doc/${name}/"

    # cleanup
    rm -r "${PKG}/usr/lib/perl5"
}
