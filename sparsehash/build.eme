#!/bin/sh

# shellcheck disable=SC2034
description="Library that contains several hash-map implementations, including implementations that optimize for space or speed."
homepage="https://github.com/sparsehash/sparsehash"
maintainer="Vylen Linux Team"

name=sparsehash
version=2.0.4
release=2

source="https://github.com/${name}/${name}/archive/${name}-${version}.tar.gz
    ${name}-${version}-cxx20-allocator.patch"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${name}-${version}"

    patch -Np1 -i "${SRC}/${name}-${version}-cxx20-allocator.patch"
    ./configure --prefix=/usr

    make
    make DESTDIR="${PKG}" install
}
