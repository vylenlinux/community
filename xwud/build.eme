#!/bin/sh

# shellcheck disable=SC2034
description="X Window System image undumping utility"
homepage="https://xorg.freedesktop.org/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=xwud
version=1.0.8
release=1
source="http://ftp.x.org/pub/individual/app/${name}-${version}.tar.gz"

build() {
    # shellcheck disable=SC2164
    cd "${name}-${version}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static

    make
    make DESTDIR="${PKG}" install
}
