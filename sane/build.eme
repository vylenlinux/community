#!/bin/sh

# shellcheck disable=SC2034
description="Scanner Access Now Easy - Scanner driver for Linux"
homepage="https://gitlab.com/sane-project/backends"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=sane
version=1.4.0
release=1

source="${name}-${version}.tar.gz::https://gitlab.com/sane-project/backends/-/archive/${version}/backends-${version}.tar.bz2
    https://gitlab.com/sane-project/backends/-/commit/d04d17b456d9847021b6df6eb08a3419a75172cf.patch"

build() {
    # shellcheck disable=SC2164
    cd "backends-${version}"

    patch -Np1 -i "${SRC}/d04d17b456d9847021b6df6eb08a3419a75172cf.patch"
    ./autogen.sh

    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --localstatedir=/var \
        --sysconfdir=/etc \
        --enable-pthread \
        --disable-translations \
        --disable-locking \
        --disable-latex \
        --with-group=scanner \
        --with-libcurl \
        --with-usb \
        --with-systemd

    make
    make DESTDIR="${PKG}" install

    install -dm755 "${PKG}/usr/lib/udev/rules.d/" \
        "${PKG}/usr/lib/udev/hwdb.d/"

    # generate udev udev+hwdb
    tools/sane-desc -m udev+hwdb -s doc/descriptions/ > "${PKG}/usr/lib/udev/rules.d/65-${name}.rules"
    tools/sane-desc -m udev+hwdb -s doc/descriptions-external/ >> "${PKG}/usr/lib/udev/rules.d/65-${name}.rules"

    # generate udev hwdb
    tools/sane-desc -m hwdb -s doc/descriptions/ > "${PKG}/usr/lib/udev/hwdb.d/20-${name}.hwdb"

    # NOTE: an empty new line is required between the two .desc collections
    printf "\n" >> "${PKG}/usr/lib/udev/hwdb.d/20-${name}.hwdb"
    tools/sane-desc -m hwdb -s doc/descriptions-external/ >> "${PKG}/usr/lib/udev/hwdb.d/20-${name}.hwdb"

    do_service saned
    do_sysusers "${name}"
    do_udev_rules 66-saned
}
