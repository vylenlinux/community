#!/bin/sh

# shellcheck disable=SC2034
description="mononoki, a font for programming and code review"
homepage="https://madmalik.github.io/mononoki/"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=ttf-mononoki
version=1.6
release=1

source="${name}-${version}.tar.gz::https://github.com/madmalik/mononoki/archive/${version}.tar.gz
    45-mononoki.conf
    65-mononoki.conf"

build() {
    # shellcheck disable=SC2164
    cd "mononoki-${version}/export"

    # shellcheck disable=SC2035
    install -Dm644 *.ttf -t "${PKG}/usr/share/fonts/TTF/"
    install -Dm644 "${SRC}"/*.conf -t "${PKG}/etc/fonts/conf.avail/"

    # shellcheck disable=SC2164
    cd "${PKG}/etc/fonts/conf.avail"
    install -dm755 "${PKG}/etc/fonts/conf.d"

    for config in *; do
        ln -sf "../conf.avail/${config}" -t ../conf.d/
    done
}
