#!/bin/sh

# shellcheck disable=SC2034
description="gedit is the GNOME text editor"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"
homepage="https://wiki.gnome.org/Apps/Gedit"

name=gedit
version=51.0
release=1
source="https://gitlab.gnome.org/World/${name}/${name}/-/archive/${version}/${name}-${version}.tar.gz"

build() {
    vylen-meson "${name}-${version}" build -Dgtk_doc=false
    meson compile -C build
    DESTDIR="${PKG}" meson install --no-rebuild -C build

    rm -rf "${PKG}/usr/lib/gedit/plugins"

    rm -f "${PKG}/usr/share/glib-2.0/schemas/org.gnome.gedit.plugins.wordcompletion.gschema.xml" \
        "${PKG}/usr/share/glib-2.0/schemas/org.gnome.gedit.plugins.drawspaces.gschema.xml"

    do_revdep
}
