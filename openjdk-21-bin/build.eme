#!/bin/sh

# shellcheck disable=SC2034
description="Temurin 21 (OpenJDK 21 Java binaries by Adoptium, formerly AdoptOpenJDK)"
homepage="https://github.com/adoptium/temurin21-binaries"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=openjdk-21-bin
version=21.0.13
release=1

_version="${version}+9"
source="${name}-${_version}.tar.gz::https://github.com/adoptium/temurin${version%%.*}-binaries/releases/download/jdk-${_version}/OpenJDK${version%%.*}U-jdk_x64_linux_hotspot_$(printf "%s" "${_version}" | sed 's/+/_/g').tar.gz"

build() {
    install -dm755 "${PKG}/usr/lib/jvm/java-${version%%.*}-openjdk"
    cp -a --reflink=auto "${SRC}/jdk-${_version}"/* -t "${PKG}/usr/lib/jvm/java-${version%%.*}-openjdk/"

    VERSION="${version%%.*}" do_revdep
}
