#!/bin/sh

# shellcheck disable=SC2034
description="Broadcom Wireless driver for kernel stable"
homepage="https://docs.broadcom.com/docs/12358410"
maintainer="Vylen Linux Team <wonkru-dev@proton.me>"

name=broadcom-wl
version=6.30.223.271
release=2

source="${name}-${version}.tar.gz::https://docs.broadcom.com/docs-and-downloads/docs/linux_sta/hybrid-v35_64-nodebug-pcoem-$(printf '%s' "${version}" | tr '.' '_').tar.gz
    broadcom-wl-kernel.conf
    dkms.conf.in
    buildmodules-broadcom-wl.sh
    001-null-pointer-fix.patch
    003-linux407.patch
    005-debian-fix-kernel-warnings.patch
    007-linux412.patch
    009-fix_mac_profile_discrepancy.patch
    011-linux509.patch
    013-linux518.patch
    015-linux600.patch
    017-linux612.patch
    019-linux614.patch
    021-linux617.patch
    002-rdtscl.patch
    004-linux408.patch
    006-linux411.patch
    008-linux415.patch
    010-linux506.patch
    012-linux517.patch
    014-linux414.patch
    016-linux601.patch
    018-linux613.patch
    020-linux615.patch
    022-linux701.patch"

build() {
    for s in $source; do
        case "${s}" in
            *.patch)
                msg_info "Applying patch ${s}..."
                patch -Np1 --no-backup-if-mismatch < "${SRC}/${s}"
            ;;
        esac
    done

    sed -e "s/@PACKAGE_VERSION@/${version}/" dkms.conf.in > dkms.conf
    sed -i -e '/BRCM_WLAN_IFNAME/s/eth/wlan/' src/wl/sys/wl_linux.c
    sed -i -e "/ldflags-y/s|\$(src)/lib|/usr/lib/${name}|;/GE_49 :=/s|:= .*|:= 1|" Makefile

    dest_dir="${PKG}/usr/src/${name}-${version}"

    install -d "${dest_dir}"
    cp -a src "${dest_dir}"

    install -Dm644 Makefile "${dest_dir}/Makefile"
    install -Dm644 dkms.conf "${dest_dir}/dkms.conf"

    install -Dm644 lib/wlc_hybrid.o_shipped "${PKG}/usr/lib/${name}/wlc_hybrid.o_shipped"
    install -Dm644 "${SRC}/broadcom-wl-kernel.conf" -t "${PKG}/etc/modprobe.d/"

    # dkms build modules script
    mkdir -p "${PKG}/var/lib/dkms"
    sed -e "s/@name@/${name}/g" -e "s/@version@/${version}/g" "${SRC}/buildmodules-${name}.sh" > "${PKG}/var/lib/dkms/buildmodules-${name}.sh"
}
